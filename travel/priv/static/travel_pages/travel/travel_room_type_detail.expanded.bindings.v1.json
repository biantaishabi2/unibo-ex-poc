{
  "version": 1,
  "vars": {
    "record.room_type_code": {
      "uses": [
        {
          "node_type": "BreadcrumbPage",
          "node_id": "travel_room_type_bc_current",
          "location": "prop",
          "prop": "content",
          "template": "{{record.room_type_code|详情}}"
        },
        {
          "node_type": "Text",
          "node_id": "travel_room_type_detail_title",
          "location": "prop",
          "prop": "content",
          "template": "{{record.room_type_code|}}"
        },
        {
          "node_type": "Text",
          "node_id": "value_room_type_code",
          "location": "prop",
          "prop": "content",
          "template": "{{record.room_type_code|}}"
        }
      ]
    },
    "record.status": {
      "uses": [
        {
          "node_type": "Badge",
          "node_id": "travel_room_type_status_badge",
          "location": "prop",
          "prop": "content",
          "template": "{{record.status|}}"
        },
        {
          "node_type": "Badge",
          "node_id": "value_status",
          "location": "prop",
          "prop": "content",
          "template": "{{record.status|}}"
        }
      ]
    },
    "record.room_type_name": {
      "uses": [
        {
          "node_type": "Text",
          "node_id": "value_room_type_name",
          "location": "prop",
          "prop": "content",
          "template": "{{record.room_type_name|}}"
        }
      ]
    },
    "record.hotel_code": {
      "uses": [
        {
          "node_type": "Text",
          "node_id": "value_hotel_code",
          "location": "prop",
          "prop": "content",
          "template": "{{record.hotel_code|}}"
        }
      ]
    },
    "record.bed_type": {
      "uses": [
        {
          "node_type": "Text",
          "node_id": "value_bed_type",
          "location": "prop",
          "prop": "content",
          "template": "{{record.bed_type|}}"
        }
      ]
    }
  },
  "events": {
    "toggle_edit": {
      "triggers": [
        {
          "node_type": "Button",
          "node_id": "travel_room_type_edit_btn",
          "prop": "click",
          "raw": "toggle_edit"
        }
      ]
    },
    "form_submit": {
      "triggers": [
        {
          "node_type": "Form",
          "node_id": "travel_room_type_edit_form",
          "prop": "submit",
          "raw": "form_submit"
        },
        {
          "node_type": "Button",
          "node_id": "travel_room_type_save_btn",
          "prop": "click",
          "raw": "form_submit"
        }
      ]
    },
    "form_change": {
      "triggers": [
        {
          "node_type": "Form",
          "node_id": "travel_room_type_edit_form",
          "prop": "change",
          "raw": "form_change"
        }
      ]
    },
    "cancel_edit": {
      "triggers": [
        {
          "node_type": "Button",
          "node_id": "travel_room_type_cancel_btn",
          "prop": "click",
          "raw": "cancel_edit"
        }
      ]
    }
  }
}