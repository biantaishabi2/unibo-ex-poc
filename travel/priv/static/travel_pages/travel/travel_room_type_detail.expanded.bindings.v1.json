          "location": "prop",
          "prop": "content",
          "template": "{{travel_room_type.room_type_name|}}"
        }
      ]
    },
    "travel_room_type.hotel_code": {
      "uses": [
        {
          "node_type": "Text",
          "node_id": "detail_fields_hotel_code_value",
          "location": "prop",
          "prop": "content",
          "template": "{{travel_room_type.hotel_code|}}"
        }
      ]
    },
    "travel_room_type.bed_type": {
      "uses": [
        {
          "node_type": "Text",
          "node_id": "detail_fields_bed_type_value",
          "location": "prop",
          "prop": "content",
          "template": "{{travel_room_type.bed_type|}}"
        }
      ]
    },
    "travel_room_type.status": {
