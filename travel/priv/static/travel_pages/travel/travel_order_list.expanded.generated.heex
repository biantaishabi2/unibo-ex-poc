<.page title="TravelOrder 列表" id="travel_order_list">
  <.section direction="row" justify="between" align="center" layout="grid" columns={2} id="travel_order_header">
    <.text variant="title" id="travel_order_title">
      <%= @page_title %>
    </.text>
    <.button variant="primary" phx-click="navigate_create" size="md" id="travel_order_create_btn">
      新建
    </.button>
  </.section>
  <.card variant="default" id="travel_order_filter_card">
    <.card_content id="travel_order_filter_content">
      <.flex gap={4} align="center" direction="row" id="travel_order_filter_row">
        <.select name="product_type" label="商品类型" size="md" id="filter_product_type">

        </.select>
        <.select name="booking_mode" label="train 订单预订模式" size="md" id="filter_booking_mode">

        </.select>
        <.select name="status" label="status" size="md" id="filter_status">

        </.select>
        <.select name="change_status" label="change_status" size="md" id="filter_change_status">

        </.select>
        <.select name="waitlist_status" label="waitlist_status" size="md" id="filter_waitlist_status">

        </.select>
        <.button variant="secondary" phx-click="filter_submit" size="md" id="travel_order_filter_submit">
          查询
        </.button>
      </.flex>
    </.card_content>
  </.card>
  <.table id="travel_order_table">
    <.table_header id="travel_order_table_header">
      <.table_row id="travel_order_header_row">
        <.table_head id="th_order_no">
          订单号
        </.table_head>
        <.table_head id="th_product_type">
          商品类型
        </.table_head>
        <.table_head id="th_booking_mode">
          train 订单预订模式
        </.table_head>
        <.table_head id="th_contact_name">
          contact_name
        </.table_head>
        <.table_head id="th_contact_phone">
          contact_phone
        </.table_head>
        <.table_head id="th_traveler_count">
          出行人数量
        </.table_head>
        <.table_head id="th_total_amount">
          订单总金额
        </.table_head>
        <.table_head id="th_points_to_use">
          计划使用的积分数量
        </.table_head>
        <.table_head id="th_points_deduction_amount">
          积分抵现金额
        </.table_head>
        <.table_head id="th_recommended_payment_method">
          宿主 quote 返回的推荐支付方式
        </.table_head>
        <.table_head id="th_currency">
          currency
        </.table_head>
        <.table_head id="th_status">
          status
        </.table_head>
        <.table_head id="th_change_status">
          change_status
        </.table_head>
        <.table_head id="th_waitlist_status">
          waitlist_status
        </.table_head>
        <.table_head id="th_original_order_ref">
          改签链路引用的原订单号或原票号
        </.table_head>
        <.table_head id="th_ticket_passenger_infos">
          乘车人信息快照
        </.table_head>
        <.table_head id="th_seat_selection_snapshot">
          选座与席别偏好快照
        </.table_head>
        <.table_head id="th_supplier_order_ref">
          供应商订单号
        </.table_head>
        <.table_head id="th_payment_external_ref">
          宿主支付侧外部支付流水号
        </.table_head>
        <.table_head id="travel_order_th_actions">
          操作
        </.table_head>
      </.table_row>
    </.table_header>
    <.table_body id="travel_order_table_body">
      <%= for row <- (@rows || []) do %>
        <.table_row>
          <.table_cell>
            <%= get_in(row, [:order_no]) || "" %>
          </.table_cell>
          <.table_cell>
            <%= if (val = get_in(row, [:product_type])) && to_string(val) != "" do %>
              <.badge variant="default" size="sm">
                <%= to_string(val) %>
              </.badge>
            <% end %>
          </.table_cell>
          <.table_cell>
            <%= if (val = get_in(row, [:booking_mode])) && to_string(val) != "" do %>
              <.badge variant="default" size="sm">
                <%= to_string(val) %>
              </.badge>
            <% end %>
          </.table_cell>
          <.table_cell>
            <%= get_in(row, [:contact_name]) || "" %>
          </.table_cell>
          <.table_cell>
            <%= get_in(row, [:contact_phone]) || "" %>
          </.table_cell>
          <.table_cell>
            <%= get_in(row, [:traveler_count]) || "" %>
          </.table_cell>
          <.table_cell>
            <%= get_in(row, [:total_amount]) || "" %>
          </.table_cell>
          <.table_cell>
            <%= get_in(row, [:points_to_use]) || "" %>
          </.table_cell>
          <.table_cell>
            <%= get_in(row, [:points_deduction_amount]) || "" %>
          </.table_cell>
          <.table_cell>
            <%= get_in(row, [:recommended_payment_method]) || "" %>
          </.table_cell>
          <.table_cell>
            <%= get_in(row, [:currency]) || "" %>
          </.table_cell>
          <.table_cell>
            <%= if (val = get_in(row, [:status])) && to_string(val) != "" do %>
              <.badge variant="default" size="sm">
                <%= to_string(val) %>
              </.badge>
            <% end %>
          </.table_cell>
          <.table_cell>
            <%= if (val = get_in(row, [:change_status])) && to_string(val) != "" do %>
              <.badge variant="default" size="sm">
                <%= to_string(val) %>
              </.badge>
            <% end %>
          </.table_cell>
          <.table_cell>
            <%= if (val = get_in(row, [:waitlist_status])) && to_string(val) != "" do %>
              <.badge variant="default" size="sm">
                <%= to_string(val) %>
              </.badge>
            <% end %>
          </.table_cell>
          <.table_cell>
            <%= get_in(row, [:original_order_ref]) || "" %>
          </.table_cell>
          <.table_cell>
            <%= get_in(row, [:ticket_passenger_infos]) || "" %>
          </.table_cell>
          <.table_cell>
            <%= get_in(row, [:seat_selection_snapshot]) || "" %>
          </.table_cell>
          <.table_cell>
            <%= get_in(row, [:supplier_order_ref]) || "" %>
          </.table_cell>
          <.table_cell>
            <%= get_in(row, [:payment_external_ref]) || "" %>
          </.table_cell>
          <.table_cell>
            <.link patch={"/pages/travel/travel_order/#{get_in(row, [:id])}"} id="travel_order_view_btn" variant="link" size="sm">
              查看
            </.link>
          </.table_cell>
        </.table_row>
      <% end %>
    </.table_body>
  </.table>
  <%= if (@rows_empty && @rows_empty != []) do %>
    <.empty_state description="暂无统一酒旅订单,承接 hotel、flight、vacation、train 四类商品的下单和状态流转;通过跨域引用关联 Sales::Customer 和 Payment::Payment数据" id="travel_order_no_data" />
  <% end %>
</.page>