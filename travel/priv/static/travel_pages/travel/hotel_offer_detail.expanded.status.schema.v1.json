{
  "version": 1,
  "defaults": {
    "record": {
      "supplier_code": "",
      "sale_status": "",
      "hotel_code": "",
      "hotel_name": "",
      "city_code": "",
      "room_type_code": "",
      "rate_plan_code": "",
      "checkin_date": "",
      "checkout_date": "",
      "listed_price": "",
      "settlement_price": "",
      "currency": "",
      "inventory_count": "",
      "cancellation_policy": "",
      "guarantee_policy": "",
      "tenant_id": "",
      "host_shop_id": "",
      "city_ref_id": ""
    },
    "editing": false
  },
  "keys": [
    "editing",
    "record",
    "record.cancellation_policy",
    "record.checkin_date",
    "record.checkout_date",
    "record.city_code",
    "record.city_ref_id",
    "record.currency",
    "record.guarantee_policy",
    "record.host_shop_id",
    "record.hotel_code",
    "record.hotel_name",
    "record.inventory_count",
    "record.listed_price",
    "record.rate_plan_code",
    "record.room_type_code",
    "record.sale_status",
    "record.settlement_price",
    "record.supplier_code",
    "record.tenant_id"
  ],
  "required": [
    "editing",
    "record"
  ],
  "urlParams": {},
  "notes": [],
  "layer2": {
    "backend": {
      "api_map": {
        "activate": "Travel.HotelOffer.activate",
        "create": "Travel.HotelOffer.create",
        "deactivate": "Travel.HotelOffer.deactivate",
        "destroy": "Travel.HotelOffer.destroy",
        "expire": "Travel.HotelOffer.expire",
        "get": "Travel.HotelOffer.get",
        "update": "Travel.HotelOffer.update"
      },
      "info": {
        "reload_messages": [
          "page_host_reload"
        ]
      },
      "load": {
        "assigns": {},
        "selection": "cancellation_policy: cancellationPolicy checkin_date: checkinDate checkout_date: checkoutDate city_code: cityCode city_ref_id: cityRefId currency guarantee_policy: guaranteePolicy host_shop_id: hostShopId hotel_code: hotelCode hotel_name: hotelName id inventory_count: inventoryCount listed_price: listedPrice rate_plan_code: ratePlanCode room_type_code: roomTypeCode sale_status: saleStatus settlement_price: settlementPrice supplier_code: supplierCode tenant_id: tenantId"
      },
      "params": {
        "accept": [
          "id"
        ]
      }
    },
    "children": [],
    "domain": "Travel",
    "e2e": {
      "playwright": {
        "auto": true,
        "base_path": "/travel/hotel_offer/:id",
        "cases": [
          {
            "covers": [],
            "name": "页面加载 + 结构可见",
            "steps": [
              {
                "action": "expect_visible",
                "selector": "[data-page='hotel_offer_detail']"
              }
            ]
          },
          {
            "covers": [
              "toggle_edit"
            ],
            "name": "编辑模式切换",
            "steps": [
              {
                "action": "click",
                "selector": "[data-action='toggle_edit']"
              },
              {
                "action": "expect_visible",
                "selector": "form, [data-mode='edit']"
              }
            ]
          },
          {
            "covers": [
              "form_submit"
            ],
            "name": "表单提交",
            "steps": [
              {
                "action": "click",
                "selector": "[data-action='form_submit'], button[type='submit']"
              },
              {
                "action": "expect_text_contains",
                "selector": "#flash-group, [data-flash], [role='alert']",
                "value": "成功"
              }
            ]
          },
          {
            "covers": [
              "action_activate"
            ],
            "name": "动作：activate",
            "steps": [
              {
                "action": "click",
                "selector": "[data-action='action_activate']"
              },
              {
                "action": "expect_visible",
                "selector": "[data-action='action_activate']"
              }
            ]
          },
          {
            "covers": [
              "action_deactivate"
            ],
            "name": "动作：deactivate",
            "steps": [
              {
                "action": "click",
                "selector": "[data-action='action_deactivate']"
              },
              {
                "action": "expect_visible",
                "selector": "[data-action='action_deactivate']"
              }
            ]
          },
          {
            "covers": [
              "action_expire"
            ],
            "name": "动作：expire",
            "steps": [
              {
                "action": "click",
                "selector": "[data-action='action_expire']"
              },
              {
                "action": "expect_visible",
                "selector": "[data-action='action_expire']"
              }
            ]
          }
        ],
        "dto_smoke": []
      }
    },
    "entity": "HotelOffer",
    "page_id": "hotel_offer_detail",
    "page_type": "object_page",
    "runtime_monitoring": null,
    "schema_version": "1.0",
    "state_transitions": [
      {
        "description": "切换编辑模式",
        "from": "*",
        "name": "toggle_edit",
        "to": "*",
        "trigger": "user_action"
      },
      {
        "description": "取消编辑",
        "from": "*",
        "name": "cancel_edit",
        "to": "*",
        "trigger": "user_action"
      },
      {
        "description": "表单字段变更",
        "from": "*",
        "name": "form_change",
        "to": "*",
        "trigger": "user_input"
      },
      {
        "description": "提交表单",
        "from": "editing",
        "name": "form_submit",
        "to": "loading",
        "trigger": "user_action"
      },
      {
        "description": "activate",
        "from": "*",
        "name": "action_activate",
        "to": "loading",
        "trigger": "user_action"
      },
      {
        "description": "deactivate",
        "from": "*",
        "name": "action_deactivate",
        "to": "loading",
        "trigger": "user_action"
      },
      {
        "description": "expire",
        "from": "*",
        "name": "action_expire",
        "to": "loading",
        "trigger": "user_action"
      },
      {
        "description": "删除记录",
        "from": "*",
        "name": "action_destroy",
        "navigate_to": "/travel/hotel_offer",
        "to": "loading",
        "trigger": "user_action"
      }
    ],
    "status_keys": [
      "record",
      "editing",
      "form",
      "loading"
    ],
    "ui": {
      "sections": [],
      "template": {
        "detail": "object_page"
      }
    },
    "version": 1
  }
}