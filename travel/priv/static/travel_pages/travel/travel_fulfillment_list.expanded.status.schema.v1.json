        "change_result": "",
        "boarding_status": "",
        "confirmation_payload": "",
        "failure_reason": "",
        "used_at": "",
        "id": "row_02"
      },
      {
        "fulfillment_type": "",
        "status": "",
        "supplier_booking_ref": "",
        "voucher_or_ticket_ref": "",
        "ticket_refs": "",
        "waitlist_result": "",
        "change_result": "",
        "boarding_status": "",
        "confirmation_payload": "",
        "failure_reason": "",
        "used_at": "",
        "id": "row_03"
      }
    ]
  },
  "keys": [
    "page_title",
    "rows",
    "rows[]",
    "rows[].boarding_status",
    "rows[].change_result",
    "rows[].confirmation_payload",
    "rows[].failure_reason",
    "rows[].fulfillment_type",
    "rows[].id",
    "rows[].status",
    "rows[].supplier_booking_ref",
    "rows[].ticket_refs",
    "rows[].used_at",
    "rows[].voucher_or_ticket_ref",
    "rows[].waitlist_result",
    "rows_empty"
  ],
  "required": [
    "page_title",
    "rows",
    "rows_empty"
  ],
  "urlParams": {},
  "notes": [],
  "layer2": {
    "backend": {
      "api_map": {
        "list": "Travel.TravelFulfillment.list"
      },
      "info": {
        "reload_messages": [
          "page_host_reload"
        ]
      },
      "load": {
        "assigns": {},
        "selection": "boarding_status: boardingStatus change_result: changeResult confirmation_payload: confirmationPayload failure_reason: failureReason fulfillment_type: fulfillmentType id shipment_id: shipmentId status supplier_booking_ref: supplierBookingRef tenant_id: tenantId ticket_refs: ticketRefs used_at: usedAt voucher_or_ticket_ref: voucherOrTicketRef waitlist_result: waitlistResult"
      },
      "params": {
        "accept": [
          "fulfillment_type",
          "status",
          "waitlist_result",
          "change_result",
          "boarding_status",
          "used_at"
        ]
      }
    },
    "domain": "Travel",
    "e2e": {
      "playwright": {
        "auto": true,
        "base_path": "/travel/travel_fulfillment",
        "cases": [
          {
            "covers": [],
            "name": "页面加载 + 结构可见",
            "steps": [
              {
                "action": "expect_visible",
                "selector": "[data-page='travel_fulfillment_list']"
              }
            ]
          },
          {
            "covers": [
              "navigate_create"
            ],
            "name": "新建导航",
            "steps": [
              {
                "action": "click",
                "selector": "#travel_fulfillment_create_btn, [data-action='navigate_create']"
              },
              {
                "action": "expect_url_contains",
                "value": "/travel/travel_fulfillment/new"
              }
            ]
          },
          {
            "covers": [],
            "name": "表格行存在",
            "steps": [
              {
                "action": "expect_visible",
                "selector": "#travel_fulfillment_table, [data-table='travel_fulfillment']"
              }
            ]
          }
        ],
        "dto_smoke": []
      }
    },
    "entity": "TravelFulfillment",
    "page_id": "travel_fulfillment_list",
    "page_type": "list_report",
    "runtime_monitoring": null,
    "schema_version": "1.0",
    "state_transitions": [
      {
        "description": "筛选条件变更",
        "from": "*",
        "name": "filter_change",
        "to": "*",
        "trigger": "user_input"
      },
      {
        "description": "提交筛选查询",
        "from": "*",
        "name": "filter_submit",
        "to": "loading",
        "trigger": "user_action"
      },
      {
        "description": "点击行跳转详情",
        "from": "*",
        "name": "row_click",
        "navigate_to": "/travel/travel_fulfillment/{id}",
        "to": "*",
        "trigger": "user_action"
      },
      {
        "description": "跳转新建页",
        "from": "*",
        "name": "navigate_create",
        "navigate_to": "/travel/travel_fulfillment/new",
        "to": "*",
        "trigger": "user_action"
      }
    ],
    "status_keys": [
      "rows",
      "rows_empty",
      "filter",
      "loading"
    ],
    "ui": {
      "sections": [],
      "template": {
        "list": "list_report"
      }
    },
    "version": 1
  }
}