{
  "version": 1,
  "vars": {
    "travel_airline.airline_code": {
      "uses": [
        {
          "node_type": "Text",
          "node_id": "detail_fields_airline_code_value",
          "location": "prop",
          "prop": "content",
          "template": "{{travel_airline.airline_code|}}"
        }
      ]
    },
    "travel_airline.airline_name": {
      "uses": [
        {
          "node_type": "Text",
          "node_id": "detail_fields_airline_name_value",
          "location": "prop",
          "prop": "content",
          "template": "{{travel_airline.airline_name|}}"
        }
      ]
    },
    "travel_airline.iata_code": {
      "uses": [
        {
          "node_type": "Text",
          "node_id": "detail_fields_iata_code_value",
          "location": "prop",
          "prop": "content",
          "template": "{{travel_airline.iata_code|}}"
        }
      ]
    },
    "travel_airline.icao_code": {
      "uses": [
        {
          "node_type": "Text",
          "node_id": "detail_fields_icao_code_value",
          "location": "prop",
          "prop": "content",
          "template": "{{travel_airline.icao_code|}}"
        }
      ]
    },
    "travel_airline.status": {
      "uses": [
        {
          "node_type": "Text",
          "node_id": "detail_fields_status_value",
          "location": "prop",
          "prop": "content",
          "template": "{{travel_airline.status|}}"
        }
      ]
    }
  },
  "events": {
    "toggle_edit": {
      "triggers": [
        {
          "node_type": "Button",
          "node_id": "edit_btn",
          "prop": "click",
          "raw": "toggle_edit"
        }
      ]
    },
    "action_destroy": {
      "triggers": [
        {
          "node_type": "Button",
          "node_id": "delete_btn",
          "prop": "click",
          "raw": "action_destroy"
        }
      ]
    },
    "form_submit": {
      "triggers": [
        {
          "node_type": "Form",
          "node_id": "travel_airline_edit_form",
          "prop": "submit",
          "raw": "form_submit"
        }
      ]
    },
    "form_change": {
      "triggers": [
        {
          "node_type": "Form",
          "node_id": "travel_airline_edit_form",
          "prop": "change",
          "raw": "form_change"
        }
      ]
    },
    "cancel_edit": {
      "triggers": [
        {
          "node_type": "Button",
          "node_id": "cancel_btn",
          "prop": "click",
          "raw": "cancel_edit"
        }
      ]
    }
  }
}