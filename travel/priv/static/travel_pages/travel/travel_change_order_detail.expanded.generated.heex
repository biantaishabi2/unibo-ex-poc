<.page title="TravelChangeOrder 详情" id="travel_change_order_detail">
  <.breadcrumb id="travel_change_order_breadcrumb">
    <.breadcrumb_list id="travel_change_order_bc_list">
      <.breadcrumb_item id="travel_change_order_bc_list_item">
        <.breadcrumb_link id="travel_change_order_bc_link">
          TravelChangeOrder 列表
        </.breadcrumb_link>
      </.breadcrumb_item>
      <.breadcrumb_separator id="travel_change_order_bc_sep" />
      <.breadcrumb_item id="travel_change_order_bc_current_item">
        <.breadcrumb_page id="travel_change_order_bc_current">
          <%= get_in(@record, [:change_reason]) || "详情" %>
        </.breadcrumb_page>
      </.breadcrumb_item>
    </.breadcrumb_list>
  </.breadcrumb>
  <.section direction="row" justify="between" align="center" layout="grid" columns={2} id="travel_change_order_detail_header">
    <.flex gap={3} align="center" direction="row" id="travel_change_order_title_group">
      <.text variant="title" id="travel_change_order_detail_title">
        <%= get_in(@record, [:change_reason]) || "" %>
      </.text>
      <.badge variant="default" size="sm" id="travel_change_order_status_badge">
        <%= get_in(@record, [:status]) || "" %>
      </.badge>
    </.flex>
    <.flex gap={2} direction="row" id="travel_change_order_actions">
      <.button variant="secondary" phx-click="toggle_edit" size="md" id="travel_change_order_edit_btn">
        编辑
      </.button>
      <.button variant="secondary" phx-click="action_submit" size="md" id="travel_change_order_action_submit">
        提交改签申请,如 approval_mode=oa 则通过 integration 创建 ApprovalInstance
      </.button>
      <%= if @record.status == "pending" do %>
        <.button variant="secondary" phx-click="action_confirm_change" size="md" id="travel_change_order_action_confirm_change">
          confirm_change
        </.button>
      <% end %>
      <%= if @record.status == "pending" do %>
        <.button variant="secondary" phx-click="action_reject_change" size="md" id="travel_change_order_action_reject_change">
          reject_change
        </.button>
      <% end %>
      <%= if @record.status == "approved" do %>
        <.button variant="secondary" phx-click="action_complete" size="md" id="travel_change_order_action_complete">
          complete
        </.button>
      <% end %>
      <%= if @record.status == "pending" do %>
        <.button variant="secondary" phx-click="action_complete_direct" size="md" id="travel_change_order_action_complete_direct">
          complete_direct
        </.button>
      <% end %>
    </.flex>
  </.section>
  <.card variant="default" id="travel_change_order_info_card">
    <.card_header id="travel_change_order_info_header">
      <.card_title id="travel_change_order_info_title">
        基本信息
      </.card_title>
    </.card_header>
    <.card_content id="travel_change_order_info_content">
      <%= if !(@editing && @editing != []) do %>
        <.grid columns={2} gap={4} id="travel_change_order_info_grid">
          <.flex direction="row" id="field_change_reason">
            <.text variant="muted" id="label_change_reason">
              改签原因
            </.text>
            <.text id="value_change_reason">
              <%= get_in(@record, [:change_reason]) || "" %>
            </.text>
          </.flex>
          <.flex direction="row" id="field_price_difference">
            <.text variant="muted" id="label_price_difference">
              差价
            </.text>
            <.text id="value_price_difference">
              <%= get_in(@record, [:price_difference]) || "" %>
            </.text>
          </.flex>
          <.flex direction="row" id="field_change_fee">
            <.text variant="muted" id="label_change_fee">
              改签手续费
            </.text>
            <.text id="value_change_fee">
              <%= get_in(@record, [:change_fee]) || "" %>
            </.text>
          </.flex>
          <.flex direction="row" id="field_status">
            <.text variant="muted" id="label_status">
              status
            </.text>
            <.badge variant="default" size="sm" id="value_status">
              <%= get_in(@record, [:status]) || "" %>
            </.badge>
          </.flex>
          <.flex direction="row" id="field_approval_mode">
            <.text variant="muted" id="label_approval_mode">
              审批模式快照;none 表示跳过审批,self/oa 表示进入审批流
            </.text>
            <.badge variant="default" size="sm" id="value_approval_mode">
              <%= get_in(@record, [:approval_mode]) || "" %>
            </.badge>
          </.flex>
        </.grid>
      <% else %>
        <.form phx-submit="form_submit" phx-change="form_change" id="travel_change_order_edit_form">
          <.grid columns={2} gap={4} id="travel_change_order_form_grid">
            <.input name="change_reason" label="改签原因" placeholder="请输入改签原因" size="md" id="form_change_reason" value={@record.change_reason} />
            <.input name="price_difference" label="差价" placeholder="请输入差价" size="md" id="form_price_difference" value={@record.price_difference} />
            <.input name="change_fee" label="改签手续费" placeholder="请输入改签手续费" size="md" id="form_change_fee" value={@record.change_fee} />
            <.input name="new_offer_id" label="新报价ID（可能是 FlightOffer/TrainOffer/HotelOffer,不做外键）" placeholder="请输入新报价ID（可能是 FlightOffer/TrainOffer/HotelOffer,不做外键）" size="md" id="form_new_offer_id" value={@record.new_offer_id} />
            <.select name="status" label="status" size="md" id="form_status" value={@record.status}>

            </.select>
            <.select name="approval_mode" label="审批模式快照;none 表示跳过审批,self/oa 表示进入审批流" size="md" id="form_approval_mode" value={@record.approval_mode}>

            </.select>
          </.grid>
          <.flex justify="end" gap={2} direction="row" id="travel_change_order_form_actions">
            <.button variant="secondary" phx-click="cancel_edit" size="md" id="travel_change_order_cancel_btn">
              取消
            </.button>
            <.button variant="primary" phx-click="form_submit" size="md" id="travel_change_order_save_btn">
              保存
            </.button>
          </.flex>
        </.form>
      <% end %>
    </.card_content>
  </.card>
</.page>