<.page title="TravelFulfillment 详情" id="travel_fulfillment_detail">
  <.breadcrumb id="travel_fulfillment_breadcrumb">
    <.breadcrumb_list id="travel_fulfillment_bc_list">
      <.breadcrumb_item id="travel_fulfillment_bc_list_item">
        <.breadcrumb_link id="travel_fulfillment_bc_link">
          TravelFulfillment 列表
        </.breadcrumb_link>
      </.breadcrumb_item>
      <.breadcrumb_separator id="travel_fulfillment_bc_sep" />
      <.breadcrumb_item id="travel_fulfillment_bc_current_item">
        <.breadcrumb_page id="travel_fulfillment_bc_current">
          <%= @record.supplier_booking_ref %>
        </.breadcrumb_page>
      </.breadcrumb_item>
    </.breadcrumb_list>
  </.breadcrumb>
  <.section direction="row" justify="between" align="center" layout="grid" columns={2} id="travel_fulfillment_detail_header">
    <.flex gap={3} align="center" direction="row" id="travel_fulfillment_title_group">
      <.text variant="title" id="travel_fulfillment_detail_title">
        <%= @record.supplier_booking_ref %>
      </.text>
      <.badge variant="default" size="sm" id="travel_fulfillment_status_badge">
        <%= @record.status %>
      </.badge>
    </.flex>
    <.flex gap={2} direction="row" id="travel_fulfillment_actions">
      <.button variant="secondary" phx-click="toggle_edit" size="md" id="travel_fulfillment_edit_btn">
        编辑
      </.button>
      <.button variant="secondary" phx-click="action_confirm_booking" size="md" id="travel_fulfillment_action_confirm_booking">
        confirm_booking
      </.button>
      <.button variant="secondary" phx-click="action_issue_voucher_or_ticket" size="md" id="travel_fulfillment_action_issue_voucher_or_ticket">
        issue_voucher_or_ticket
      </.button>
      <.button variant="secondary" phx-click="action_mark_in_use" size="md" id="travel_fulfillment_action_mark_in_use">
        mark_in_use
      </.button>
      <.button variant="secondary" phx-click="action_complete_fulfillment" size="md" id="travel_fulfillment_action_complete_fulfillment">
        complete_fulfillment
      </.button>
      <.button variant="secondary" phx-click="action_cancel_fulfillment" size="md" id="travel_fulfillment_action_cancel_fulfillment">
        cancel_fulfillment
      </.button>
      <.button variant="secondary" phx-click="action_fail_fulfillment" size="md" id="travel_fulfillment_action_fail_fulfillment">
        fail_fulfillment
      </.button>
      <.button variant="danger" phx-click="action_destroy" size="md" id="travel_fulfillment_delete_btn">
        删除
      </.button>
    </.flex>
  </.section>
  <.card variant="default" id="travel_fulfillment_info_card">
    <.card_header id="travel_fulfillment_info_header">
      <.card_title id="travel_fulfillment_info_title">
        基本信息
      </.card_title>
    </.card_header>
    <.card_content id="travel_fulfillment_info_content">
      <%= if !(@editing && @editing != []) do %>
        <.grid columns={2} gap={4} id="travel_fulfillment_info_grid">
          <.flex direction="row" id="field_fulfillment_type">
            <.text variant="muted" id="label_fulfillment_type">
              fulfillment_type
            </.text>
            <.badge variant="default" size="sm" id="value_fulfillment_type">
              <%= @record.fulfillment_type %>
            </.badge>
          </.flex>
          <.flex direction="row" id="field_status">
            <.text variant="muted" id="label_status">
              status
            </.text>
            <.badge variant="default" size="sm" id="value_status">
              <%= @record.status %>
            </.badge>
          </.flex>
          <.flex direction="row" id="field_supplier_booking_ref">
            <.text variant="muted" id="label_supplier_booking_ref">
              供应商预订号
            </.text>
            <.text id="value_supplier_booking_ref">
              <%= @record.supplier_booking_ref %>
            </.text>
          </.flex>
          <.flex direction="row" id="field_voucher_or_ticket_ref">
            <.text variant="muted" id="label_voucher_or_ticket_ref">
              凭证号或票号
            </.text>
            <.text id="value_voucher_or_ticket_ref">
              <%= @record.voucher_or_ticket_ref %>
            </.text>
          </.flex>
          <.flex direction="row" id="field_ticket_refs">
            <.text variant="muted" id="label_ticket_refs">
              多张票号、座席和乘客映射结果
            </.text>
            <.text id="value_ticket_refs">
              <%= @record.ticket_refs %>
            </.text>
          </.flex>
          <.flex direction="row" id="field_waitlist_result">
            <.text variant="muted" id="label_waitlist_result">
              train 候补兑现结果
            </.text>
            <.badge variant="default" size="sm" id="value_waitlist_result">
              <%= @record.waitlist_result %>
            </.badge>
          </.flex>
          <.flex direction="row" id="field_change_result">
            <.text variant="muted" id="label_change_result">
              train 改签结果
            </.text>
            <.badge variant="default" size="sm" id="value_change_result">
              <%= @record.change_result %>
            </.badge>
          </.flex>
          <.flex direction="row" id="field_boarding_status">
            <.text variant="muted" id="label_boarding_status">
              train 乘车状态
            </.text>
            <.badge variant="default" size="sm" id="value_boarding_status">
              <%= @record.boarding_status %>
            </.badge>
          </.flex>
          <.flex direction="row" id="field_confirmation_payload">
            <.text variant="muted" id="label_confirmation_payload">
              确认结果快照
            </.text>
            <.text id="value_confirmation_payload">
              <%= @record.confirmation_payload %>
            </.text>
          </.flex>
          <.flex direction="row" id="field_failure_reason">
            <.text variant="muted" id="label_failure_reason">
              失败原因
            </.text>
            <.text id="value_failure_reason">
              <%= @record.failure_reason %>
            </.text>
          </.flex>
          <.flex direction="row" id="field_used_at">
            <.text variant="muted" id="label_used_at">
              实际使用时间
            </.text>
            <.text id="value_used_at">
              <%= @record.used_at %>
            </.text>
          </.flex>
        </.grid>
      <% else %>
        <.form phx-submit="form_submit" phx-change="form_change" id="travel_fulfillment_edit_form">
          <.grid columns={2} gap={4} id="travel_fulfillment_form_grid">
            <.input name="tenant_id" label="tenant_id" placeholder="请输入tenant_id" required="true" size="md" id="form_tenant_id" />
            <.select name="fulfillment_type" label="fulfillment_type" size="md" id="form_fulfillment_type">

            </.select>
            <.select name="status" label="status" size="md" id="form_status">

            </.select>
            <.input name="supplier_booking_ref" label="供应商预订号" placeholder="请输入供应商预订号" size="md" id="form_supplier_booking_ref" />
            <.input name="voucher_or_ticket_ref" label="凭证号或票号" placeholder="请输入凭证号或票号" size="md" id="form_voucher_or_ticket_ref" />
            <.input name="ticket_refs" label="多张票号、座席和乘客映射结果" placeholder="请输入多张票号、座席和乘客映射结果" size="md" id="form_ticket_refs" />
            <.select name="waitlist_result" label="train 候补兑现结果" size="md" id="form_waitlist_result">

            </.select>
            <.select name="change_result" label="train 改签结果" size="md" id="form_change_result">

            </.select>
            <.select name="boarding_status" label="train 乘车状态" size="md" id="form_boarding_status">

            </.select>
            <.textarea name="confirmation_payload" label="确认结果快照" placeholder="请输入确认结果快照" id="form_confirmation_payload" />
            <.textarea name="failure_reason" label="失败原因" placeholder="请输入失败原因" id="form_failure_reason" />
            <.input name="used_at" label="实际使用时间" placeholder="请输入实际使用时间" size="md" id="form_used_at" />
          </.grid>
          <.flex justify="end" gap={2} direction="row" id="travel_fulfillment_form_actions">
            <.button variant="secondary" phx-click="cancel_edit" size="md" id="travel_fulfillment_cancel_btn">
              取消
            </.button>
            <.button variant="primary" phx-click="form_submit" size="md" id="travel_fulfillment_save_btn">
              保存
            </.button>
          </.flex>
        </.form>
      <% end %>
    </.card_content>
  </.card>
</.page>