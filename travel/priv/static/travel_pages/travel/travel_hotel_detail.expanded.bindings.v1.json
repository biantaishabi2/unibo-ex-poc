{
  "version": 1,
  "vars": {
    "travel_hotel.hotel_code": {
      "uses": [
        {
          "node_type": "Text",
          "node_id": "detail_fields_hotel_code_value",
          "location": "prop",
          "prop": "content",
          "template": "{{travel_hotel.hotel_code|}}"
        }
      ]
    },
    "travel_hotel.hotel_name": {
      "uses": [
        {
          "node_type": "Text",
          "node_id": "detail_fields_hotel_name_value",
          "location": "prop",
          "prop": "content",
          "template": "{{travel_hotel.hotel_name|}}"
        }
      ]
    },
    "travel_hotel.city_code": {
      "uses": [
        {
          "node_type": "Text",
          "node_id": "detail_fields_city_code_value",
          "location": "prop",
          "prop": "content",
          "template": "{{travel_hotel.city_code|}}"
        }
      ]
    },
    "travel_hotel.hotel_star": {
      "uses": [
        {
          "node_type": "Text",
          "node_id": "detail_fields_hotel_star_value",
          "location": "prop",
          "prop": "content",
          "template": "{{travel_hotel.hotel_star|}}"
        }
      ]
    },
    "travel_hotel.status": {
      "uses": [
        {
          "node_type": "Text",
          "node_id": "detail_fields_status_value",
          "location": "prop",
          "prop": "content",
          "template": "{{travel_hotel.status|}}"
        }
      ]
    }
  },
  "events": {
    "toggle_edit": {
      "triggers": [
        {
          "node_type": "Button",
          "node_id": "edit_btn",
          "prop": "click",
          "raw": "toggle_edit"
        }
      ]
    },
    "action_destroy": {
      "triggers": [
        {
          "node_type": "Button",
          "node_id": "delete_btn",
          "prop": "click",
          "raw": "action_destroy"
        }
      ]
    },
    "form_submit": {
      "triggers": [
        {
          "node_type": "Form",
          "node_id": "travel_hotel_edit_form",
          "prop": "submit",
          "raw": "form_submit"
        }
      ]
    },
    "form_change": {
      "triggers": [
        {
          "node_type": "Form",
          "node_id": "travel_hotel_edit_form",
          "prop": "change",
          "raw": "form_change"
        }
      ]
    },
    "cancel_edit": {
      "triggers": [
        {
          "node_type": "Button",
          "node_id": "cancel_btn",
          "prop": "click",
          "raw": "cancel_edit"
        }
      ]
    }
  }
}