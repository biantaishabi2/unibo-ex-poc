{
  "version": 1,
  "vars": {
    "record.hotel_code": {
      "uses": [
        {
          "node_type": "BreadcrumbPage",
          "node_id": "travel_hotel_bc_current",
          "location": "prop",
          "prop": "content",
          "template": "{{record.hotel_code|详情}}"
        },
        {
          "node_type": "Text",
          "node_id": "travel_hotel_detail_title",
          "location": "prop",
          "prop": "content",
          "template": "{{record.hotel_code|}}"
        },
        {
          "node_type": "Text",
          "node_id": "value_hotel_code",
          "location": "prop",
          "prop": "content",
          "template": "{{record.hotel_code|}}"
        }
      ]
    },
    "record.status": {
      "uses": [
        {
          "node_type": "Badge",
          "node_id": "travel_hotel_status_badge",
          "location": "prop",
          "prop": "content",
          "template": "{{record.status|}}"
        },
        {
          "node_type": "Badge",
          "node_id": "value_status",
          "location": "prop",
          "prop": "content",
          "template": "{{record.status|}}"
        }
      ]
    },
    "record.hotel_name": {
      "uses": [
        {
          "node_type": "Text",
          "node_id": "value_hotel_name",
          "location": "prop",
          "prop": "content",
          "template": "{{record.hotel_name|}}"
        }
      ]
    },
    "record.city_code": {
      "uses": [
        {
          "node_type": "Text",
          "node_id": "value_city_code",
          "location": "prop",
          "prop": "content",
          "template": "{{record.city_code|}}"
        }
      ]
    },
    "record.hotel_star": {
      "uses": [
        {
          "node_type": "Text",
          "node_id": "value_hotel_star",
          "location": "prop",
          "prop": "content",
          "template": "{{record.hotel_star|}}"
        }
      ]
    }
  },
  "events": {
    "toggle_edit": {
      "triggers": [
        {
          "node_type": "Button",
          "node_id": "travel_hotel_edit_btn",
          "prop": "click",
          "raw": "toggle_edit"
        }
      ]
    },
    "form_submit": {
      "triggers": [
        {
          "node_type": "Form",
          "node_id": "travel_hotel_edit_form",
          "prop": "submit",
          "raw": "form_submit"
        },
        {
          "node_type": "Button",
          "node_id": "travel_hotel_save_btn",
          "prop": "click",
          "raw": "form_submit"
        }
      ]
    },
    "form_change": {
      "triggers": [
        {
          "node_type": "Form",
          "node_id": "travel_hotel_edit_form",
          "prop": "change",
          "raw": "form_change"
        }
      ]
    },
    "cancel_edit": {
      "triggers": [
        {
          "node_type": "Button",
          "node_id": "travel_hotel_cancel_btn",
          "prop": "click",
          "raw": "cancel_edit"
        }
      ]
    }
  }
}