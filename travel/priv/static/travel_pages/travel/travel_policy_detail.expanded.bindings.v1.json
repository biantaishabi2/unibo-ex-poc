          "location": "prop",
          "prop": "content",
          "template": "{{record.policy_name|详情}}"
        },
        {
          "node_type": "Text",
          "node_id": "travel_policy_detail_title",
          "location": "prop",
          "prop": "content",
          "template": "{{record.policy_name|}}"
        },
        {
          "node_type": "Text",
          "node_id": "value_policy_name",
