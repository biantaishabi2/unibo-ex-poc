{
  "version": 1,
  "vars": {
    "offer.departure_time": {
      "uses": [
        {
          "node_type": "Text",
          "node_id": "departure_time",
          "location": "prop",
          "prop": "content",
          "template": "{{offer.departure_time|}}"
        }
      ]
    },
    "offer.departure_station_name": {
      "uses": [
        {
          "node_type": "Text",
          "node_id": "dep_station_value",
          "location": "prop",
          "prop": "content",
          "template": "{{offer.departure_station_name|}}"
        },
        {
          "node_type": "Text",
          "node_id": "departure_station",
          "location": "prop",
          "prop": "content",
          "template": "{{offer.departure_station_name|}}"
        }
      ]
    },
    "offer.duration_label": {
      "uses": [
        {
          "node_type": "Text",
          "node_id": "duration_label",
          "location": "prop",
          "prop": "content",
          "template": "{{offer.duration_label|}}"
        }
      ]
    },
    "offer.date_label": {
      "uses": [
        {
          "node_type": "Text",
          "node_id": "date_label",
          "location": "prop",
          "prop": "content",
          "template": "{{offer.date_label|}}"
        }
      ]
    },
    "offer.arrival_time": {
      "uses": [
        {
          "node_type": "Text",
          "node_id": "arrival_time",
          "location": "prop",
          "prop": "content",
          "template": "{{offer.arrival_time|}}"
        }
      ]
    },
    "offer.arrival_station_name": {
      "uses": [
        {
          "node_type": "Text",
          "node_id": "arr_station_value",
          "location": "prop",
          "prop": "content",
          "template": "{{offer.arrival_station_name|}}"
        },
        {
          "node_type": "Text",
          "node_id": "arrival_station",
          "location": "prop",
          "prop": "content",
          "template": "{{offer.arrival_station_name|}}"
        }
      ]
    },
    "offer.train_no": {
      "uses": [
        {
          "node_type": "Text",
          "node_id": "train_no_value",
          "location": "prop",
          "prop": "content",
          "template": "{{offer.train_no|}}"
        }
      ]
    },
    "offer.train_type_label": {
      "uses": [
        {
          "node_type": "Text",
          "node_id": "train_type_value",
          "location": "prop",
          "prop": "content",
          "template": "{{offer.train_type_label|}}"
        }
      ]
    }
  },
  "events": {
    "navigate:/travel/train/booking/{{item.offer_id|}}": {
      "triggers": [
        {
          "node_type": "Button",
          "node_id": "book_btn",
          "prop": "click",
          "raw": "navigate:/travel/train/booking/{{item.offer_id|}}"
        }
      ]
    }
  }
}