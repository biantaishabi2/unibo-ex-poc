<.page title="出行人管理" id="traveler_management">
  <.section layout="none" id="header_section">
    <.flex justify="between" align="center" direction="row" id="title_bar">
      <.text variant="h3" weight="bold" id="page_title">
        出行人管理
      </.text>
      <.button variant="primary" size="sm" icon="plus" phx-click="open_dialog:traveler_edit_dialog:create" id="add_traveler_btn">
        新增出行人
      </.button>
    </.flex>
  </.section>
  <.section layout="grid" columns={2} id="traveler_list_section">
    <.stack gap={2} direction="column" id="traveler_cards">
      <%= for item <- @travelers do %>
        <.card variant="default">
          <.card_content>
            <.flex justify="between" align="center" direction="row">
              <.flex gap={2} align="center" direction="row">
                <.avatar size="sm" fallback={item.full_name}>

                </.avatar>
                <.stack gap={0} direction="column">
                  <.flex gap={1} align="center" direction="row">
                    <.text variant="body" weight="bold">
                      <%= item.full_name %>
                    </.text>
                    <%= if (item.is_self && item.is_self != []) do %>
                      <.badge variant="secondary" size="sm">
                        本人
                      </.badge>
                    <% end %>
                  </.flex>
                  <.flex gap={2} direction="row">
                    <.text variant="caption" color="muted">
                      <%= item.id_type %>
                    </.text>
                    <.text variant="caption" color="muted">
                      <%= item.id_number %>
                    </.text>
                  </.flex>
                  <.text variant="caption" color="muted">
                    <%= item.phone %>
                  </.text>
                </.stack>
              </.flex>
              <.flex gap={1} direction="row">
                <.button variant="ghost" size="sm" icon="edit" phx-click="open_dialog:traveler_edit_dialog:edit:{{item.id|}}" />
                <.button variant="ghost" size="sm" icon="trash" color="destructive" phx-click="delete:Travel.TravelerProfile:{{item.id|}}" />
              </.flex>
            </.flex>
          </.card_content>
        </.card>
      <% end %>
    </.stack>
    <%= if (@travelers_empty && @travelers_empty != []) do %>
      <.empty_state title="暂无出行人" description="添加常用出行人,预订时可快速选择" id="no_travelers" />
    <% end %>
  </.section>
  <.section layout="none" id="dialog_section">
    <.dialog title="编辑出行人" id="traveler_edit_dialog">
      <.stack gap={3} direction="column" id="dialog_form">
        <.input label="姓名" placeholder="请输入真实姓名" bind="form.full_name" required="true" size="md" id="input_full_name" />
        <.select label="证件类型" placeholder="请选择证件类型" bind="form.id_type" required="true" size="md" id="select_id_type" options={[%{label: "身份证", value: "id_card"}, %{label: "护照", value: "passport"}, %{label: "港澳通行证", value: "hk_mo_pass"}, %{label: "台湾通行证", value: "tw_pass"}]}>

        </.select>
        <.input label="证件号码" placeholder="请输入证件号码" bind="form.id_number" required="true" size="md" id="input_id_number" />
        <.input label="手机号码" placeholder="请输入手机号码" bind="form.phone" type="tel" size="md" id="input_phone" />
        <.input label="邮箱" placeholder="请输入邮箱地址" bind="form.email" type="email" size="md" id="input_email" />
        <.flex justify="between" align="center" direction="row" id="is_self_row">
          <.text id="is_self_label">
            是否本人
          </.text>
          <.switch bind="form.is_self" size="md" id="switch_is_self" />
        </.flex>
        <.flex gap={2} justify="end" direction="row" id="dialog_actions">
          <.button variant="outline" phx-click="close_dialog:traveler_edit_dialog" size="md" id="cancel_btn">
            取消
          </.button>
          <.button variant="primary" phx-click="submit_form:Travel.TravelerProfile" size="md" id="save_btn">
            保存
          </.button>
        </.flex>
      </.stack>
    </.dialog>
  </.section>
</.page>