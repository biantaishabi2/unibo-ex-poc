<.page title="TrainOffer 详情" id="train_offer_detail">
  <.breadcrumb id="train_offer_breadcrumb">
    <.breadcrumb_list id="train_offer_bc_list">
      <.breadcrumb_item id="train_offer_bc_list_item">
        <.breadcrumb_link id="train_offer_bc_link">
          TrainOffer 列表
        </.breadcrumb_link>
      </.breadcrumb_item>
      <.breadcrumb_separator id="train_offer_bc_sep" />
      <.breadcrumb_item id="train_offer_bc_current_item">
        <.breadcrumb_page id="train_offer_bc_current">
          <%= get_in(@record, [:supplier_code]) || "详情" %>
        </.breadcrumb_page>
      </.breadcrumb_item>
    </.breadcrumb_list>
  </.breadcrumb>
  <.section direction="row" justify="between" align="center" layout="grid" columns={2} id="train_offer_detail_header">
    <.flex gap={3} align="center" direction="row" id="train_offer_title_group">
      <.text variant="title" id="train_offer_detail_title">
        <%= get_in(@record, [:supplier_code]) || "" %>
      </.text>
      <%= if (val = get_in(@record, [:inventory_status])) && to_string(val) != "" do %>
        <.badge variant="default" size="sm" id="train_offer_status_badge">
          <%= to_string(val) %>
        </.badge>
      <% end %>
    </.flex>
    <.flex gap={2} direction="row" id="train_offer_actions">
      <.button variant="secondary" phx-click="toggle_edit" size="md" id="train_offer_edit_btn">
        编辑
      </.button>
      <.button variant="secondary" phx-click="action_activate" size="md" id="train_offer_action_activate">
        activate
      </.button>
      <.button variant="secondary" phx-click="action_deactivate" size="md" id="train_offer_action_deactivate">
        deactivate
      </.button>
      <.button variant="secondary" phx-click="action_expire" size="md" id="train_offer_action_expire">
        expire
      </.button>
      <.button variant="danger" phx-click="action_destroy" size="md" id="train_offer_delete_btn">
        删除
      </.button>
    </.flex>
  </.section>
  <.card variant="default" id="train_offer_info_card">
    <.card_header id="train_offer_info_header">
      <.card_title id="train_offer_info_title">
        基本信息
      </.card_title>
    </.card_header>
    <.card_content id="train_offer_info_content">
      <%= if !(@editing && @editing != []) do %>
        <.grid columns={2} gap={4} id="train_offer_info_grid">
          <.flex direction="row" id="field_supplier_code">
            <.text variant="muted" id="label_supplier_code">
              供应商编码
            </.text>
            <.text id="value_supplier_code">
              <%= get_in(@record, [:supplier_code]) || "" %>
            </.text>
          </.flex>
          <.flex direction="row" id="field_train_no">
            <.text variant="muted" id="label_train_no">
              车次号
            </.text>
            <.text id="value_train_no">
              <%= get_in(@record, [:train_no]) || "" %>
            </.text>
          </.flex>
          <.flex direction="row" id="field_departure_station_code">
            <.text variant="muted" id="label_departure_station_code">
              出发站编码
            </.text>
            <.text id="value_departure_station_code">
              <%= get_in(@record, [:departure_station_code]) || "" %>
            </.text>
          </.flex>
          <.flex direction="row" id="field_departure_station_name">
            <.text variant="muted" id="label_departure_station_name">
              出发站名称
            </.text>
            <.text id="value_departure_station_name">
              <%= get_in(@record, [:departure_station_name]) || "" %>
            </.text>
          </.flex>
          <.flex direction="row" id="field_arrival_station_code">
            <.text variant="muted" id="label_arrival_station_code">
              到达站编码
            </.text>
            <.text id="value_arrival_station_code">
              <%= get_in(@record, [:arrival_station_code]) || "" %>
            </.text>
          </.flex>
          <.flex direction="row" id="field_arrival_station_name">
            <.text variant="muted" id="label_arrival_station_name">
              到达站名称
            </.text>
            <.text id="value_arrival_station_name">
              <%= get_in(@record, [:arrival_station_name]) || "" %>
            </.text>
          </.flex>
          <.flex direction="row" id="field_travel_date">
            <.text variant="muted" id="label_travel_date">
              乘车日期
            </.text>
            <.text id="value_travel_date">
              <%= get_in(@record, [:travel_date]) || "" %>
            </.text>
          </.flex>
          <.flex direction="row" id="field_departure_at">
            <.text variant="muted" id="label_departure_at">
              发车时间
            </.text>
            <.text id="value_departure_at">
              <%= get_in(@record, [:departure_at]) || "" %>
            </.text>
          </.flex>
          <.flex direction="row" id="field_arrival_at">
            <.text variant="muted" id="label_arrival_at">
              到达时间
            </.text>
            <.text id="value_arrival_at">
              <%= get_in(@record, [:arrival_at]) || "" %>
            </.text>
          </.flex>
          <.flex direction="row" id="field_seat_class">
            <.text variant="muted" id="label_seat_class">
              席别名称
            </.text>
            <.text id="value_seat_class">
              <%= get_in(@record, [:seat_class]) || "" %>
            </.text>
          </.flex>
          <.flex direction="row" id="field_seat_code">
            <.text variant="muted" id="label_seat_code">
              席别编码
            </.text>
            <.text id="value_seat_code">
              <%= get_in(@record, [:seat_code]) || "" %>
            </.text>
          </.flex>
          <.flex direction="row" id="field_is_no_seat">
            <.text variant="muted" id="label_is_no_seat">
              是否无座票
            </.text>
            <%= if (val = get_in(@record, [:is_no_seat])) && to_string(val) != "" do %>
              <.badge variant="default" size="sm" id="value_is_no_seat">
                <%= to_string(val) %>
              </.badge>
            <% end %>
          </.flex>
          <.flex direction="row" id="field_inventory_status">
            <.text variant="muted" id="label_inventory_status">
              余票或候补可用状态
            </.text>
            <%= if (val = get_in(@record, [:inventory_status])) && to_string(val) != "" do %>
              <.badge variant="default" size="sm" id="value_inventory_status">
                <%= to_string(val) %>
              </.badge>
            <% end %>
          </.flex>
          <.flex direction="row" id="field_waitlist_supported">
            <.text variant="muted" id="label_waitlist_supported">
              是否支持候补
            </.text>
            <%= if (val = get_in(@record, [:waitlist_supported])) && to_string(val) != "" do %>
              <.badge variant="default" size="sm" id="value_waitlist_supported">
                <%= to_string(val) %>
              </.badge>
            <% end %>
          </.flex>
          <.flex direction="row" id="field_listed_price">
            <.text variant="muted" id="label_listed_price">
              对客展示价快照
            </.text>
            <.text id="value_listed_price">
              <%= get_in(@record, [:listed_price]) || "" %>
            </.text>
          </.flex>
          <.flex direction="row" id="field_settlement_price">
            <.text variant="muted" id="label_settlement_price">
              结算价快照
            </.text>
            <.text id="value_settlement_price">
              <%= get_in(@record, [:settlement_price]) || "" %>
            </.text>
          </.flex>
          <.flex direction="row" id="field_currency">
            <.text variant="muted" id="label_currency">
              currency
            </.text>
            <.text id="value_currency">
              <%= get_in(@record, [:currency]) || "" %>
            </.text>
          </.flex>
          <.flex direction="row" id="field_booking_rules_snapshot">
            <.text variant="muted" id="label_booking_rules_snapshot">
              预订规则快照
            </.text>
            <.text id="value_booking_rules_snapshot">
              <%= get_in(@record, [:booking_rules_snapshot]) || "" %>
            </.text>
          </.flex>
          <.flex direction="row" id="field_change_rules_snapshot">
            <.text variant="muted" id="label_change_rules_snapshot">
              改签规则快照
            </.text>
            <.text id="value_change_rules_snapshot">
              <%= get_in(@record, [:change_rules_snapshot]) || "" %>
            </.text>
          </.flex>
          <.flex direction="row" id="field_refund_rules_snapshot">
            <.text variant="muted" id="label_refund_rules_snapshot">
              退票规则快照
            </.text>
            <.text id="value_refund_rules_snapshot">
              <%= get_in(@record, [:refund_rules_snapshot]) || "" %>
            </.text>
          </.flex>
          <.flex direction="row" id="field_sale_status">
            <.text variant="muted" id="label_sale_status">
              可售状态
            </.text>
            <%= if (val = get_in(@record, [:sale_status])) && to_string(val) != "" do %>
              <.badge variant="default" size="sm" id="value_sale_status">
                <%= to_string(val) %>
              </.badge>
            <% end %>
          </.flex>
        </.grid>
      <% else %>
        <.form phx-submit="form_submit" phx-change="form_change" id="train_offer_edit_form">
          <.grid columns={2} gap={4} id="train_offer_form_grid">
            <.input name="tenant_id" label="tenant_id" placeholder="请输入tenant_id" required="true" size="md" id="form_tenant_id" value={@record.tenant_id} />
            <.input name="host_shop_id" label="宿主商城 ID,仅用于宿主侧隔离和桥接上下文" placeholder="请输入宿主商城 ID,仅用于宿主侧隔离和桥接上下文" size="md" id="form_host_shop_id" value={@record.host_shop_id} />
            <.input name="supplier_code" label="供应商编码" placeholder="请输入供应商编码" required="true" size="md" id="form_supplier_code" value={@record.supplier_code} />
            <.input name="train_no" label="车次号" placeholder="请输入车次号" required="true" size="md" id="form_train_no" value={@record.train_no} />
            <.input name="departure_station_code" label="出发站编码" placeholder="请输入出发站编码" required="true" size="md" id="form_departure_station_code" value={@record.departure_station_code} />
            <.input name="departure_station_name" label="出发站名称" placeholder="请输入出发站名称" required="true" size="md" id="form_departure_station_name" value={@record.departure_station_name} />
            <.input name="arrival_station_code" label="到达站编码" placeholder="请输入到达站编码" required="true" size="md" id="form_arrival_station_code" value={@record.arrival_station_code} />
            <.input name="arrival_station_name" label="到达站名称" placeholder="请输入到达站名称" required="true" size="md" id="form_arrival_station_name" value={@record.arrival_station_name} />
            <.input name="travel_date" label="乘车日期" placeholder="请输入乘车日期" required="true" size="md" id="form_travel_date" value={@record.travel_date} />
            <.input name="departure_at" label="发车时间" placeholder="请输入发车时间" required="true" size="md" id="form_departure_at" value={@record.departure_at} />
            <.input name="arrival_at" label="到达时间" placeholder="请输入到达时间" required="true" size="md" id="form_arrival_at" value={@record.arrival_at} />
            <.input name="seat_class" label="席别名称" placeholder="请输入席别名称" required="true" size="md" id="form_seat_class" value={@record.seat_class} />
            <.input name="seat_code" label="席别编码" placeholder="请输入席别编码" required="true" size="md" id="form_seat_code" value={@record.seat_code} />
            <.switch name="is_no_seat" label="是否无座票" size="md" id="form_is_no_seat" value={@record.is_no_seat} />
            <.select name="inventory_status" label="余票或候补可用状态" size="md" id="form_inventory_status" value={@record.inventory_status}>

            </.select>
            <.switch name="waitlist_supported" label="是否支持候补" size="md" id="form_waitlist_supported" value={@record.waitlist_supported} />
            <.input name="listed_price" label="对客展示价快照" placeholder="请输入对客展示价快照" required="true" size="md" id="form_listed_price" value={@record.listed_price} />
            <.input name="settlement_price" label="结算价快照" placeholder="请输入结算价快照" size="md" id="form_settlement_price" value={@record.settlement_price} />
            <.input name="currency" label="currency" placeholder="请输入currency" size="md" id="form_currency" value={@record.currency} />
            <.textarea name="booking_rules_snapshot" label="预订规则快照" placeholder="请输入预订规则快照" id="form_booking_rules_snapshot" value={@record.booking_rules_snapshot} />
            <.textarea name="change_rules_snapshot" label="改签规则快照" placeholder="请输入改签规则快照" id="form_change_rules_snapshot" value={@record.change_rules_snapshot} />
            <.textarea name="refund_rules_snapshot" label="退票规则快照" placeholder="请输入退票规则快照" id="form_refund_rules_snapshot" value={@record.refund_rules_snapshot} />
            <.select name="sale_status" label="可售状态" size="md" id="form_sale_status" value={@record.sale_status}>

            </.select>
            <.input name="departure_station_ref_id" label="Travel 出发站主数据引用（跨域引用 Ecommerce.TravelStation）" placeholder="请输入Travel 出发站主数据引用（跨域引用 Ecommerce.TravelStation）" size="md" id="form_departure_station_ref_id" value={@record.departure_station_ref_id} />
            <.input name="arrival_station_ref_id" label="Travel 到达站主数据引用（跨域引用 Ecommerce.TravelStation）" placeholder="请输入Travel 到达站主数据引用（跨域引用 Ecommerce.TravelStation）" size="md" id="form_arrival_station_ref_id" value={@record.arrival_station_ref_id} />
          </.grid>
          <.flex justify="end" gap={2} direction="row" id="train_offer_form_actions">
            <.button variant="secondary" phx-click="cancel_edit" size="md" id="train_offer_cancel_btn">
              取消
            </.button>
            <.button variant="primary" phx-click="form_submit" size="md" id="train_offer_save_btn">
              保存
            </.button>
          </.flex>
        </.form>
      <% end %>
    </.card_content>
  </.card>
</.page>