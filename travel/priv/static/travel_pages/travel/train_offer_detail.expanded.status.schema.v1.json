  "urlParams": {},
  "notes": [],
  "layer2": {
    "backend": {
      "api_map": {
        "activate": "Travel.TrainOffer.activate",
        "create": "Travel.TrainOffer.create",
        "deactivate": "Travel.TrainOffer.deactivate",
        "destroy": "Travel.TrainOffer.destroy",
        "expire": "Travel.TrainOffer.expire",
        "get": "Travel.TrainOffer.get",
        "update": "Travel.TrainOffer.update"
      },
      "info": {
        "reload_messages": [
          "page_host_reload"
        ]
      },
      "load": {
        "assigns": {},
        "selection": "arrival_at: arrivalAt arrival_station_code: arrivalStationCode arrival_station_name: arrivalStationName arrival_station_ref_id: arrivalStationRefId booking_rules_snapshot: bookingRulesSnapshot change_rules_snapshot: changeRulesSnapshot currency departure_at: departureAt departure_station_code: departureStationCode departure_station_name: departureStationName departure_station_ref_id: departureStationRefId host_shop_id: hostShopId id inventory_status: inventoryStatus is_no_seat: isNoSeat listed_price: listedPrice refund_rules_snapshot: refundRulesSnapshot sale_status: saleStatus seat_class: seatClass seat_code: seatCode settlement_price: settlementPrice supplier_code: supplierCode tenant_id: tenantId train_no: trainNo travel_date: travelDate waitlist_supported: waitlistSupported"
      },
      "params": {
        "accept": [
          "id"
        ]
      }
    },
    "children": [],
    "domain": "Travel",
    "e2e": {
      "playwright": {
        "auto": true,
        "base_path": "/travel/train_offer/:id",
        "cases": [
          {
            "covers": [],
            "name": "页面加载 + 结构可见",
            "steps": [
              {
                "action": "expect_visible",
                "selector": "[data-page='train_offer_detail']"
              }
            ]
          },
          {
            "covers": [
              "toggle_edit"
            ],
            "name": "编辑模式切换",
            "steps": [
              {
                "action": "click",
                "selector": "[data-action='toggle_edit']"
              },
              {
                "action": "expect_visible",
                "selector": "form, [data-mode='edit']"
              }
            ]
          },
          {
            "covers": [
              "form_submit"
            ],
            "name": "表单提交",
            "steps": [
              {
                "action": "click",
                "selector": "[data-action='form_submit'], button[type='submit']"
              },
              {
                "action": "expect_text_contains",
                "selector": "#flash-group, [data-flash], [role='alert']",
                "value": "成功"
              }
            ]
          },
          {
            "covers": [
              "action_activate"
            ],
            "name": "动作：activate",
            "steps": [
              {
                "action": "click",
                "selector": "[data-action='action_activate']"
              },
              {
                "action": "expect_visible",
                "selector": "[data-action='action_activate']"
              }
            ]
          },
          {
            "covers": [
              "action_deactivate"
            ],
            "name": "动作：deactivate",
            "steps": [
              {
                "action": "click",
                "selector": "[data-action='action_deactivate']"
              },
              {
                "action": "expect_visible",
                "selector": "[data-action='action_deactivate']"
              }
            ]
          },
          {
            "covers": [
              "action_expire"
            ],
            "name": "动作：expire",
            "steps": [
              {
                "action": "click",
                "selector": "[data-action='action_expire']"
              },
              {
                "action": "expect_visible",
                "selector": "[data-action='action_expire']"
              }
            ]
          }
        ],
        "dto_smoke": []
      }
    },
    "entity": "TrainOffer",
    "page_id": "train_offer_detail",
    "page_type": "object_page",
    "runtime_monitoring": null,
    "schema_version": "1.0",
    "state_transitions": [
      {
        "description": "切换编辑模式",
        "from": "*",
        "name": "toggle_edit",
        "to": "*",
        "trigger": "user_action"
      },
      {
        "description": "取消编辑",
        "from": "*",
        "name": "cancel_edit",
        "to": "*",
        "trigger": "user_action"
      },
      {
        "description": "表单字段变更",
        "from": "*",
        "name": "form_change",
        "to": "*",
        "trigger": "user_input"
      },
      {
        "description": "提交表单",
        "from": "editing",
        "name": "form_submit",
        "to": "loading",
        "trigger": "user_action"
      },
      {
        "description": "activate",
        "from": "*",
        "name": "action_activate",
        "to": "loading",
        "trigger": "user_action"
      },
      {
        "description": "deactivate",
        "from": "*",
        "name": "action_deactivate",
        "to": "loading",
        "trigger": "user_action"
      },
      {
        "description": "expire",
        "from": "*",
        "name": "action_expire",
        "to": "loading",
        "trigger": "user_action"
      },
      {
        "description": "删除记录",
        "from": "*",
        "name": "action_destroy",
        "navigate_to": "/travel/train_offer",
        "to": "loading",
        "trigger": "user_action"
      }
    ],
    "status_keys": [
      "record",
      "editing",
      "form",
      "loading"
    ],
    "ui": {
      "sections": [],
      "template": {
        "detail": "object_page"
      }
    },
    "version": 1
  }
}