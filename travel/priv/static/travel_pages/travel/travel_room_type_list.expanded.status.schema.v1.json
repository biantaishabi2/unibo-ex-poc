{
  "version": 1,
  "defaults": {
    "travel_room_type": {
      "page": "",
      "total_pages": ""
    },
    "rows_empty": true,
    "rows": [
      {
        "room_type_code": "",
        "room_type_name": "",
        "hotel_code": "",
        "bed_type": "",
        "status": ""
      },
      {
        "room_type_code": "",
        "room_type_name": "",
        "hotel_code": "",
        "bed_type": "",
        "status": ""
      },
      {
        "room_type_code": "",
        "room_type_name": "",
        "hotel_code": "",
        "bed_type": "",
        "status": ""
      }
    ]
  },
  "keys": [
    "rows",
    "rows[]",
    "rows[].bed_type",
    "rows[].hotel_code",
    "rows[].room_type_code",
    "rows[].room_type_name",
    "rows[].status",
    "rows_empty",
    "travel_room_type",
    "travel_room_type.page",
    "travel_room_type.total_pages"
  ],
  "required": [
    "rows",
    "rows_empty",
    "travel_room_type"
  ],
  "urlParams": {},
  "notes": [],
  "layer2": {
    "backend": {
      "api_map": {
        "list": "Travel.TravelRoomType.list"
      },
      "info": {
        "reload_messages": [
          "page_host_reload"
        ]
      },
      "load": {
        "assigns": {},
        "selection": "bed_type: bedType hotel_code: hotelCode id room_type_code: roomTypeCode room_type_name: roomTypeName status"
      },
      "params": {
        "accept": [
          "status"
        ]
      }
    },
    "domain": "Travel",
    "e2e": {
      "playwright": {
        "auto": true,
        "base_path": "/travel/travel_room_type",
        "cases": [
          {
            "covers": [],
            "name": "页面加载 + 结构可见",
            "steps": [
              {
                "action": "expect_visible",
                "selector": "[data-page='travel_room_type_list']"
              }
            ]
          },
          {
            "covers": [
              "navigate_create"
            ],
            "name": "新建导航",
            "steps": [
              {
                "action": "click",
                "selector": "#travel_room_type_create_btn, [data-action='navigate_create']"
              },
              {
                "action": "expect_url_contains",
                "value": "/travel/travel_room_type/new"
              }
            ]
          },
          {
            "covers": [],
            "name": "表格行存在",
            "steps": [
              {
                "action": "expect_visible",
                "selector": "#travel_room_type_table, [data-table='travel_room_type']"
              }
            ]
          }
        ],
        "dto_smoke": []
      }
    },
    "entity": "TravelRoomType",
    "page_id": "travel_room_type_list",
    "page_type": "list_report",
    "runtime_monitoring": null,
    "schema_version": "1.0",
    "state_transitions": [
      {
        "description": "筛选条件变更",
        "from": "*",
        "name": "filter_change",
        "to": "*",
        "trigger": "user_input"
      },
      {
        "description": "提交筛选查询",
        "from": "*",
        "name": "filter_submit",
        "to": "loading",
        "trigger": "user_action"
      },
      {
        "description": "点击行跳转详情",
        "from": "*",
        "name": "row_click",
        "navigate_to": "/travel/travel_room_type/{id}",
        "to": "*",
        "trigger": "user_action"
      },
      {
        "description": "跳转新建页",
        "from": "*",
        "name": "navigate_create",
        "navigate_to": "/travel/travel_room_type/new",
        "to": "*",
        "trigger": "user_action"
      }
    ],
    "status_keys": [
      "rows",
      "rows_empty",
      "filter",
      "loading"
    ],
    "ui": {
      "sections": [],
      "template": {
        "list": "list_report"
      }
    },
    "version": 1
  }
}