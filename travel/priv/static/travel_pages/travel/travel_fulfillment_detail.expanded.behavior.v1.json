{
  "backend": {
    "api_map": {
      "cancel_fulfillment": "Travel.TravelFulfillment.cancel_fulfillment",
      "complete_fulfillment": "Travel.TravelFulfillment.complete_fulfillment",
      "confirm_booking": "Travel.TravelFulfillment.confirm_booking",
      "create": "Travel.TravelFulfillment.create",
      "destroy": "Travel.TravelFulfillment.destroy",
      "fail_fulfillment": "Travel.TravelFulfillment.fail_fulfillment",
      "get": "Travel.TravelFulfillment.get",
      "issue_voucher_or_ticket": "Travel.TravelFulfillment.issue_voucher_or_ticket",
      "mark_in_use": "Travel.TravelFulfillment.mark_in_use",
      "update": "Travel.TravelFulfillment.update"
    },
    "info": {
      "reload_messages": [
        "page_host_reload"
      ]
    },
    "load": {
      "assigns": {},
      "selection": "boarding_status: boardingStatus change_result: changeResult confirmation_payload: confirmationPayload failure_reason: failureReason fulfillment_type: fulfillmentType id shipment_id: shipmentId status supplier_booking_ref: supplierBookingRef tenant_id: tenantId ticket_refs: ticketRefs used_at: usedAt voucher_or_ticket_ref: voucherOrTicketRef waitlist_result: waitlistResult"
    },
    "params": {
      "accept": [
        "id"
      ]
    }
  },
  "children": [],
  "domain": "Travel",
  "e2e": {
    "playwright": {
      "auto": true,
      "base_path": "/travel/travel_fulfillment/:id",
      "cases": [
        {
          "covers": [],
          "name": "页面加载 + 结构可见",
          "steps": [
            {
              "action": "expect_visible",
              "selector": "[data-page='travel_fulfillment_detail']"
            }
          ]
        },
        {
          "covers": [
            "toggle_edit"
          ],
          "name": "编辑模式切换",
          "steps": [
            {
              "action": "click",
              "selector": "[data-action='toggle_edit']"
            },
            {
              "action": "expect_visible",
              "selector": "form, [data-mode='edit']"
            }
          ]
        },
        {
          "covers": [
            "form_submit"
          ],
          "name": "表单提交",
          "steps": [
            {
              "action": "click",
              "selector": "[data-action='form_submit'], button[type='submit']"
            },
            {
              "action": "expect_text_contains",
              "selector": "#flash-group, [data-flash], [role='alert']",
              "value": "成功"
            }
          ]
        },
        {
          "covers": [
            "action_confirm_booking"
          ],
          "name": "动作：confirm_booking",
          "steps": [
            {
              "action": "click",
              "selector": "[data-action='action_confirm_booking']"
            },
            {
              "action": "expect_visible",
              "selector": "[data-action='action_confirm_booking']"
            }
          ]
        },
        {
          "covers": [
            "action_issue_voucher_or_ticket"
          ],
          "name": "动作：issue_voucher_or_ticket",
          "steps": [
            {
              "action": "click",
              "selector": "[data-action='action_issue_voucher_or_ticket']"
            },
            {
              "action": "expect_visible",
              "selector": "[data-action='action_issue_voucher_or_ticket']"
            }
          ]
        },
        {
          "covers": [
            "action_mark_in_use"
          ],
          "name": "动作：mark_in_use",
          "steps": [
            {
              "action": "click",
              "selector": "[data-action='action_mark_in_use']"
            },
            {
              "action": "expect_visible",
              "selector": "[data-action='action_mark_in_use']"
            }
          ]
        },
        {
          "covers": [
            "action_complete_fulfillment"
          ],
          "name": "动作：complete_fulfillment",
          "steps": [
            {
              "action": "click",
              "selector": "[data-action='action_complete_fulfillment']"
            },
            {
              "action": "expect_visible",
              "selector": "[data-action='action_complete_fulfillment']"
            }
          ]
        },
        {
          "covers": [
            "action_cancel_fulfillment"
          ],
          "name": "动作：cancel_fulfillment",
          "steps": [
            {
              "action": "click",
              "selector": "[data-action='action_cancel_fulfillment']"
            },
            {
              "action": "expect_visible",
              "selector": "[data-action='action_cancel_fulfillment']"
            }
          ]
        },
        {
          "covers": [
            "action_fail_fulfillment"
          ],
          "name": "动作：fail_fulfillment",
          "steps": [
            {
              "action": "click",
              "selector": "[data-action='action_fail_fulfillment']"
            },
            {
              "action": "expect_visible",
              "selector": "[data-action='action_fail_fulfillment']"
            }
          ]
        }
      ],
      "dto_smoke": []
    }
  },
  "entity": "TravelFulfillment",
  "page_id": "travel_fulfillment_detail",
  "page_type": "object_page",
  "runtime_monitoring": null,
  "schema_version": "1.0",
  "state_transitions": [
    {
      "description": "切换编辑模式",
      "from": "*",
      "name": "toggle_edit",
      "to": "*",
      "trigger": "user_action"
    },
    {
      "description": "取消编辑",
      "from": "*",
      "name": "cancel_edit",
      "to": "*",
      "trigger": "user_action"
    },
    {
      "description": "表单字段变更",
      "from": "*",
      "name": "form_change",
      "to": "*",
      "trigger": "user_input"
    },
    {
      "description": "提交表单",
      "from": "editing",
      "name": "form_submit",
      "to": "loading",
      "trigger": "user_action"
    },
    {
      "description": "confirm_booking",
      "from": "*",
      "name": "action_confirm_booking",
      "to": "loading",
      "trigger": "user_action"
    },
    {
      "description": "issue_voucher_or_ticket",
      "from": "*",
      "name": "action_issue_voucher_or_ticket",
      "to": "loading",
      "trigger": "user_action"
    },
    {
      "description": "mark_in_use",
      "from": "*",
      "name": "action_mark_in_use",
      "to": "loading",
      "trigger": "user_action"
    },
    {
      "description": "complete_fulfillment",
      "from": "*",
      "name": "action_complete_fulfillment",
      "to": "loading",
      "trigger": "user_action"
    },
    {
      "description": "cancel_fulfillment",
      "from": "*",
      "name": "action_cancel_fulfillment",
      "to": "loading",
      "trigger": "user_action"
    },
    {
      "description": "fail_fulfillment",
      "from": "*",
      "name": "action_fail_fulfillment",
      "to": "loading",
      "trigger": "user_action"
    },
    {
      "description": "删除记录",
      "from": "*",
      "name": "action_destroy",
      "navigate_to": "/travel/travel_fulfillment",
      "to": "loading",
      "trigger": "user_action"
    }
  ],
  "status_keys": [
    "record",
    "editing",
    "form",
    "loading"
  ],
  "ui": {
    "sections": [],
    "template": {
      "detail": "object_page"
    }
  },
  "version": 1
}