<.page title="详情" id="train_detail">
  <.section layout="none" id="breadcrumb_section">
    <.breadcrumb id="page_breadcrumb">
      <.breadcrumb_list id="bc_list">
        <.breadcrumb_item id="bc_list_item">
          <.breadcrumb_link id="bc_link">
            列表
          </.breadcrumb_link>
        </.breadcrumb_item>
        <.breadcrumb_separator id="bc_sep" />
        <.breadcrumb_item id="bc_current_item">
          <.breadcrumb_page id="bc_current">
            详情
          </.breadcrumb_page>
        </.breadcrumb_item>
      </.breadcrumb_list>
    </.breadcrumb>
  </.section>
  <.section direction="row" justify="between" align="center" layout="grid" columns={2} id="detail_header">
    <.flex gap={3} align="center" direction="row" id="title_group">
      <.stack direction="column" id="title_meta">
        <.text variant="caption" color="muted" id="breadcrumb">
          TrainOffer
        </.text>
        <.text variant="h1" id="page_title">
          火车票可售 offer,承载车次、席别、候补和退改规则快照
        </.text>
      </.stack>
      <.badge bind="train_offer.status" variant="default" size="sm" id="status_badge" />
    </.flex>
    <.flex gap={2} direction="row" id="actions_group">
      <.button variant="secondary" phx-click="toggle_edit" size="md" id="edit_btn">
        编辑
      </.button>
      <%= if get_in(@record, [:sale_status]) == "draft" || get_in(@record, [:sale_status]) == "inactive" do %>
        <.button variant="secondary" phx-click="action_activate" size="md" id="train_offer_action_activate">
          activate
        </.button>
      <% end %>
      <%= if get_in(@record, [:sale_status]) == "active" do %>
        <.button variant="secondary" phx-click="action_deactivate" size="md" id="train_offer_action_deactivate">
          deactivate
        </.button>
      <% end %>
      <%= if get_in(@record, [:sale_status]) == "active" do %>
        <.button variant="secondary" phx-click="action_expire" size="md" id="train_offer_action_expire">
          expire
        </.button>
      <% end %>
      <.button variant="danger" phx-click="action_destroy" size="md" id="delete_btn">
        删除
      </.button>
    </.flex>
  </.section>
  <.section layout="none" id="info_section">
    <.card variant="default" id="info_card">
      <.card_header id="info_header">
        <.card_title id="info_title">
          基本信息
        </.card_title>
      </.card_header>
      <.card_content id="info_content">
        <%= if !(@editing && @editing != []) do %>
          <.grid columns={2} gap={4} id="info_grid">
            <.grid columns={2} gap={3} id="detail_fields">
              <.stack gap={0} direction="column" id="detail_fields_supplier_code">
                <.text variant="caption" color="muted" id="detail_fields_supplier_code_label">
                  供应商编码
                </.text>
                <.text id="detail_fields_supplier_code_value">
                  <%= get_in(@train_offer, [:supplier_code]) |> then(fn v when is_binary(v) and v != "" -> v; _ -> "" end) %>
                </.text>
              </.stack>
              <.stack gap={0} direction="column" id="detail_fields_train_no">
                <.text variant="caption" color="muted" id="detail_fields_train_no_label">
                  车次号
                </.text>
                <.text id="detail_fields_train_no_value">
                  <%= get_in(@train_offer, [:train_no]) |> then(fn v when is_binary(v) and v != "" -> v; _ -> "" end) %>
                </.text>
              </.stack>
              <.stack gap={0} direction="column" id="detail_fields_departure_station_code">
                <.text variant="caption" color="muted" id="detail_fields_departure_station_code_label">
                  出发站编码
                </.text>
                <.text id="detail_fields_departure_station_code_value">
                  <%= get_in(@train_offer, [:departure_station_code]) |> then(fn v when is_binary(v) and v != "" -> v; _ -> "" end) %>
                </.text>
              </.stack>
              <.stack gap={0} direction="column" id="detail_fields_departure_station_name">
                <.text variant="caption" color="muted" id="detail_fields_departure_station_name_label">
                  出发站名称
                </.text>
                <.text id="detail_fields_departure_station_name_value">
                  <%= get_in(@train_offer, [:departure_station_name]) |> then(fn v when is_binary(v) and v != "" -> v; _ -> "" end) %>
                </.text>
              </.stack>
              <.stack gap={0} direction="column" id="detail_fields_arrival_station_code">
                <.text variant="caption" color="muted" id="detail_fields_arrival_station_code_label">
                  到达站编码
                </.text>
                <.text id="detail_fields_arrival_station_code_value">
                  <%= get_in(@train_offer, [:arrival_station_code]) |> then(fn v when is_binary(v) and v != "" -> v; _ -> "" end) %>
                </.text>
              </.stack>
              <.stack gap={0} direction="column" id="detail_fields_arrival_station_name">
                <.text variant="caption" color="muted" id="detail_fields_arrival_station_name_label">
                  到达站名称
                </.text>
                <.text id="detail_fields_arrival_station_name_value">
                  <%= get_in(@train_offer, [:arrival_station_name]) |> then(fn v when is_binary(v) and v != "" -> v; _ -> "" end) %>
                </.text>
              </.stack>
              <.stack gap={0} direction="column" id="detail_fields_travel_date">
                <.text variant="caption" color="muted" id="detail_fields_travel_date_label">
                  乘车日期
                </.text>
                <.text id="detail_fields_travel_date_value">
                  <%= get_in(@train_offer, [:travel_date]) |> then(fn v when is_binary(v) and v != "" -> v; _ -> "" end) %>
                </.text>
              </.stack>
              <.stack gap={0} direction="column" id="detail_fields_departure_at">
                <.text variant="caption" color="muted" id="detail_fields_departure_at_label">
                  发车时间
                </.text>
                <.text id="detail_fields_departure_at_value">
                  <%= get_in(@train_offer, [:departure_at]) |> then(fn v when is_binary(v) and v != "" -> v; _ -> "" end) %>
                </.text>
              </.stack>
              <.stack gap={0} direction="column" id="detail_fields_arrival_at">
                <.text variant="caption" color="muted" id="detail_fields_arrival_at_label">
                  到达时间
                </.text>
                <.text id="detail_fields_arrival_at_value">
                  <%= get_in(@train_offer, [:arrival_at]) |> then(fn v when is_binary(v) and v != "" -> v; _ -> "" end) %>
                </.text>
              </.stack>
              <.stack gap={0} direction="column" id="detail_fields_seat_class">
                <.text variant="caption" color="muted" id="detail_fields_seat_class_label">
                  席别名称
                </.text>
                <.text id="detail_fields_seat_class_value">
                  <%= get_in(@train_offer, [:seat_class]) |> then(fn v when is_binary(v) and v != "" -> v; _ -> "" end) %>
                </.text>
              </.stack>
              <.stack gap={0} direction="column" id="detail_fields_seat_code">
                <.text variant="caption" color="muted" id="detail_fields_seat_code_label">
                  席别编码
                </.text>
                <.text id="detail_fields_seat_code_value">
                  <%= get_in(@train_offer, [:seat_code]) |> then(fn v when is_binary(v) and v != "" -> v; _ -> "" end) %>
                </.text>
              </.stack>
              <.stack gap={0} direction="column" id="detail_fields_is_no_seat">
                <.text variant="caption" color="muted" id="detail_fields_is_no_seat_label">
                  是否无座票
                </.text>
                <.text id="detail_fields_is_no_seat_value">
                  <%= get_in(@train_offer, [:is_no_seat]) |> then(fn v when is_binary(v) and v != "" -> v; _ -> "" end) %>
                </.text>
              </.stack>
              <.stack gap={0} direction="column" id="detail_fields_inventory_status">
                <.text variant="caption" color="muted" id="detail_fields_inventory_status_label">
                  余票或候补可用状态
                </.text>
                <.text id="detail_fields_inventory_status_value">
                  <%= get_in(@train_offer, [:inventory_status]) |> then(fn v when is_binary(v) and v != "" -> v; _ -> "" end) %>
                </.text>
              </.stack>
              <.stack gap={0} direction="column" id="detail_fields_waitlist_supported">
                <.text variant="caption" color="muted" id="detail_fields_waitlist_supported_label">
                  是否支持候补
                </.text>
                <.text id="detail_fields_waitlist_supported_value">
                  <%= get_in(@train_offer, [:waitlist_supported]) |> then(fn v when is_binary(v) and v != "" -> v; _ -> "" end) %>
                </.text>
              </.stack>
              <.stack gap={0} direction="column" id="detail_fields_listed_price">
                <.text variant="caption" color="muted" id="detail_fields_listed_price_label">
                  对客展示价快照
                </.text>
                <.text id="detail_fields_listed_price_value">
                  <%= get_in(@train_offer, [:listed_price]) |> then(fn v when is_binary(v) and v != "" -> v; _ -> "" end) %>
                </.text>
              </.stack>
              <.stack gap={0} direction="column" id="detail_fields_settlement_price">
                <.text variant="caption" color="muted" id="detail_fields_settlement_price_label">
                  结算价快照
                </.text>
                <.text id="detail_fields_settlement_price_value">
                  <%= get_in(@train_offer, [:settlement_price]) |> then(fn v when is_binary(v) and v != "" -> v; _ -> "" end) %>
                </.text>
              </.stack>
              <.stack gap={0} direction="column" id="detail_fields_currency">
                <.text variant="caption" color="muted" id="detail_fields_currency_label">
                  currency
                </.text>
                <.text id="detail_fields_currency_value">
                  <%= get_in(@train_offer, [:currency]) |> then(fn v when is_binary(v) and v != "" -> v; _ -> "" end) %>
                </.text>
              </.stack>
              <.stack gap={0} direction="column" id="detail_fields_booking_rules_snapshot">
                <.text variant="caption" color="muted" id="detail_fields_booking_rules_snapshot_label">
                  预订规则快照
                </.text>
                <.text id="detail_fields_booking_rules_snapshot_value">
                  <%= get_in(@train_offer, [:booking_rules_snapshot]) |> then(fn v when is_binary(v) and v != "" -> v; _ -> "" end) %>
                </.text>
              </.stack>
              <.stack gap={0} direction="column" id="detail_fields_change_rules_snapshot">
                <.text variant="caption" color="muted" id="detail_fields_change_rules_snapshot_label">
                  改签规则快照
                </.text>
                <.text id="detail_fields_change_rules_snapshot_value">
                  <%= get_in(@train_offer, [:change_rules_snapshot]) |> then(fn v when is_binary(v) and v != "" -> v; _ -> "" end) %>
                </.text>
              </.stack>
              <.stack gap={0} direction="column" id="detail_fields_refund_rules_snapshot">
                <.text variant="caption" color="muted" id="detail_fields_refund_rules_snapshot_label">
                  退票规则快照
                </.text>
                <.text id="detail_fields_refund_rules_snapshot_value">
                  <%= get_in(@train_offer, [:refund_rules_snapshot]) |> then(fn v when is_binary(v) and v != "" -> v; _ -> "" end) %>
                </.text>
              </.stack>
              <.stack gap={0} direction="column" id="detail_fields_sale_status">
                <.text variant="caption" color="muted" id="detail_fields_sale_status_label">
                  可售状态
                </.text>
                <.text id="detail_fields_sale_status_value">
                  <%= get_in(@train_offer, [:sale_status]) |> then(fn v when is_binary(v) and v != "" -> v; _ -> "" end) %>
                </.text>
              </.stack>
            </.grid>
          </.grid>
        <% else %>
          <.form for={%{}} phx-submit="form_submit" phx-change="form_change" id="train_offer_edit_form">
            <.grid columns={2} gap={4} id="form_grid">
              <.stack direction="column" id="form_fields">
                <.input size="md" name="train_offer[tenant_id]" id="train_offer_form_tenant_id" value={get_in(@train_offer, [:tenant_id]) || ""} />
                <.input size="md" name="train_offer[host_shop_id]" id="train_offer_form_host_shop_id" value={get_in(@train_offer, [:host_shop_id]) || ""} />
                <.input size="md" name="train_offer[supplier_code]" id="train_offer_form_supplier_code" value={get_in(@train_offer, [:supplier_code]) || ""} />
                <.input size="md" name="train_offer[train_no]" id="train_offer_form_train_no" value={get_in(@train_offer, [:train_no]) || ""} />
                <.input size="md" name="train_offer[departure_station_code]" id="train_offer_form_departure_station_code" value={get_in(@train_offer, [:departure_station_code]) || ""} />
                <.input size="md" name="train_offer[departure_station_ref_id]" id="train_offer_form_departure_station_ref_id" value={get_in(@train_offer, [:departure_station_ref_id]) || ""} />
                <.input size="md" name="train_offer[departure_station_name]" id="train_offer_form_departure_station_name" value={get_in(@train_offer, [:departure_station_name]) || ""} />
                <.input size="md" name="train_offer[arrival_station_code]" id="train_offer_form_arrival_station_code" value={get_in(@train_offer, [:arrival_station_code]) || ""} />
                <.input size="md" name="train_offer[arrival_station_ref_id]" id="train_offer_form_arrival_station_ref_id" value={get_in(@train_offer, [:arrival_station_ref_id]) || ""} />
                <.input size="md" name="train_offer[arrival_station_name]" id="train_offer_form_arrival_station_name" value={get_in(@train_offer, [:arrival_station_name]) || ""} />
                <.input size="md" name="train_offer[travel_date]" id="train_offer_form_travel_date" value={get_in(@train_offer, [:travel_date]) || ""} />
                <.input size="md" name="train_offer[departure_at]" id="train_offer_form_departure_at" value={get_in(@train_offer, [:departure_at]) || ""} />
                <.input size="md" name="train_offer[arrival_at]" id="train_offer_form_arrival_at" value={get_in(@train_offer, [:arrival_at]) || ""} />
                <.input size="md" name="train_offer[seat_class]" id="train_offer_form_seat_class" value={get_in(@train_offer, [:seat_class]) || ""} />
                <.input size="md" name="train_offer[seat_code]" id="train_offer_form_seat_code" value={get_in(@train_offer, [:seat_code]) || ""} />
                <.switch size="md" name="train_offer[is_no_seat]" id="train_offer_form_is_no_seat" value={get_in(@train_offer, [:is_no_seat]) || ""} />
                <.select size="md" name="train_offer[inventory_status]" id="train_offer_form_inventory_status" :let={builder} value={get_in(@train_offer, [:inventory_status]) || ""}>
                  <.select_trigger builder={builder} />
                  <.select_content builder={builder}>
                    <.select_group>
                      <.select_item builder={builder} value="available" label="available">available</.select_item>
                      <.select_item builder={builder} value="waitlist_only" label="waitlist_only">waitlist_only</.select_item>
                      <.select_item builder={builder} value="sold_out" label="sold_out">sold_out</.select_item>
                      <.select_item builder={builder} value="unavailable" label="unavailable">unavailable</.select_item>
                    </.select_group>
                  </.select_content>
                </.select>
                <.switch size="md" name="train_offer[waitlist_supported]" id="train_offer_form_waitlist_supported" value={get_in(@train_offer, [:waitlist_supported]) || ""} />
                <.input size="md" name="train_offer[listed_price]" id="train_offer_form_listed_price" value={get_in(@train_offer, [:listed_price]) || ""} />
                <.input size="md" name="train_offer[settlement_price]" id="train_offer_form_settlement_price" value={get_in(@train_offer, [:settlement_price]) || ""} />
                <.input size="md" name="train_offer[currency]" id="train_offer_form_currency" value={get_in(@train_offer, [:currency]) || ""} />
                <.textarea name="train_offer[booking_rules_snapshot]" id="train_offer_form_booking_rules_snapshot" value={get_in(@train_offer, [:booking_rules_snapshot]) || ""} />
                <.textarea name="train_offer[change_rules_snapshot]" id="train_offer_form_change_rules_snapshot" value={get_in(@train_offer, [:change_rules_snapshot]) || ""} />
                <.textarea name="train_offer[refund_rules_snapshot]" id="train_offer_form_refund_rules_snapshot" value={get_in(@train_offer, [:refund_rules_snapshot]) || ""} />
                <.select size="md" name="train_offer[sale_status]" id="train_offer_form_sale_status" :let={builder} value={get_in(@train_offer, [:sale_status]) || ""}>
                  <.select_trigger builder={builder} />
                  <.select_content builder={builder}>
                    <.select_group>
                      <.select_item builder={builder} value="draft" label="draft">draft</.select_item>
                      <.select_item builder={builder} value="active" label="active">active</.select_item>
                      <.select_item builder={builder} value="inactive" label="inactive">inactive</.select_item>
                      <.select_item builder={builder} value="expired" label="expired">expired</.select_item>
                    </.select_group>
                  </.select_content>
                </.select>
              </.stack>
            </.grid>
            <.flex justify="end" gap={2} direction="row" id="form_actions">
              <.button variant="secondary" phx-click="cancel_edit" size="md" id="cancel_btn">
                取消
              </.button>
              <.button variant="primary" size="md" type="submit" id="save_btn">
                保存
              </.button>
            </.flex>
          </.form>
        <% end %>
      </.card_content>
    </.card>
  </.section>
</.page>