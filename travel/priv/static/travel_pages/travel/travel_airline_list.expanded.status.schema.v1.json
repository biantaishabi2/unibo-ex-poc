{
  "version": 1,
  "defaults": {
    "page_title": "TravelAirline 列表",
    "rows_empty": true,
    "rows": [
      {
        "airline_code": "",
        "airline_name": "",
        "iata_code": "",
        "icao_code": "",
        "status": "",
        "id": "row_01"
      },
      {
        "airline_code": "",
        "airline_name": "",
        "iata_code": "",
        "icao_code": "",
        "status": "",
        "id": "row_02"
      },
      {
        "airline_code": "",
        "airline_name": "",
        "iata_code": "",
        "icao_code": "",
        "status": "",
        "id": "row_03"
      }
    ]
  },
  "keys": [
    "page_title",
    "rows",
    "rows[]",
    "rows[].airline_code",
    "rows[].airline_name",
    "rows[].iata_code",
    "rows[].icao_code",
    "rows[].id",
    "rows[].status",
    "rows_empty"
  ],
  "required": [
    "page_title",
    "rows",
    "rows_empty"
  ],
  "urlParams": {},
  "notes": [],
  "layer2": {
    "backend": {
      "api_map": {
        "list": "Travel.TravelAirline.list"
      },
      "info": {
        "reload_messages": [
          "page_host_reload"
        ]
      },
      "load": {
        "assigns": {},
        "selection": "airline_code: airlineCode airline_name: airlineName iata_code: iataCode icao_code: icaoCode id status"
      },
      "params": {
        "accept": [
          "status"
        ]
      }
    },
    "domain": "Travel",
    "e2e": {
      "playwright": {
        "auto": true,
        "base_path": "/travel/travel_airline",
        "cases": [
          {
            "covers": [],
            "name": "页面加载 + 结构可见",
            "steps": [
              {
                "action": "expect_visible",
                "selector": "[data-page='travel_airline_list']"
              }
            ]
          },
          {
            "covers": [
              "navigate_create"
            ],
            "name": "新建导航",
            "steps": [
              {
                "action": "click",
                "selector": "#travel_airline_create_btn, [data-action='navigate_create']"
              },
              {
                "action": "expect_url_contains",
                "value": "/travel/travel_airline/new"
              }
            ]
          },
          {
            "covers": [],
            "name": "表格行存在",
            "steps": [
              {
                "action": "expect_visible",
                "selector": "#travel_airline_table, [data-table='travel_airline']"
              }
            ]
          }
        ],
        "dto_smoke": []
      }
    },
    "entity": "TravelAirline",
    "page_id": "travel_airline_list",
    "page_type": "list_report",
    "runtime_monitoring": null,
    "schema_version": "1.0",
    "state_transitions": [
      {
        "description": "筛选条件变更",
        "from": "*",
        "name": "filter_change",
        "to": "*",
        "trigger": "user_input"
      },
      {
        "description": "提交筛选查询",
        "from": "*",
        "name": "filter_submit",
        "to": "loading",
        "trigger": "user_action"
      },
      {
        "description": "点击行跳转详情",
        "from": "*",
        "name": "row_click",
        "navigate_to": "/travel/travel_airline/{id}",
        "to": "*",
        "trigger": "user_action"
      },
      {
        "description": "跳转新建页",
        "from": "*",
        "name": "navigate_create",
        "navigate_to": "/travel/travel_airline/new",
        "to": "*",
        "trigger": "user_action"
      }
    ],
    "status_keys": [
      "rows",
      "rows_empty",
      "filter",
      "loading"
    ],
    "ui": {
      "sections": [],
      "template": {
        "list": "list_report"
      }
    },
    "version": 1
  }
}