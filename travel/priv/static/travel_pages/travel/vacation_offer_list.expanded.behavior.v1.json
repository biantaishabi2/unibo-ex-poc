{
  "backend": {
    "api_map": {
      "list": "Travel.VacationOffer.list"
    }
  },
  "domain": "Travel",
  "e2e": {
    "playwright": {
      "auto": true,
      "base_path": "/travel/vacation_offer",
      "cases": [
        {
          "covers": [],
          "name": "页面加载 + 结构可见",
          "steps": [
            {
              "action": "expect_visible",
              "selector": "[data-page='vacation_offer_list']"
            }
          ]
        },
        {
          "covers": [
            "navigate_create"
          ],
          "name": "新建导航",
          "steps": [
            {
              "action": "click",
              "selector": "#vacation_offer_create_btn, [data-action='navigate_create']"
            },
            {
              "action": "expect_url_contains",
              "value": "/travel/vacation_offer/new"
            }
          ]
        },
        {
          "covers": [],
          "name": "表格行存在",
          "steps": [
            {
              "action": "expect_visible",
              "selector": "#vacation_offer_table, [data-table='vacation_offer']"
            }
          ]
        }
      ],
      "dto_smoke": []
    }
  },
  "entity": "VacationOffer",
  "page_id": "vacation_offer_list",
  "page_type": "list_report",
  "runtime_monitoring": null,
  "schema_version": "1.0",
  "state_transitions": [
    {
      "description": "筛选条件变更",
      "from": "*",
      "name": "filter_change",
      "to": "*",
      "trigger": "user_input"
    },
    {
      "description": "提交筛选查询",
      "from": "*",
      "name": "filter_submit",
      "to": "loading",
      "trigger": "user_action"
    },
    {
      "description": "点击行跳转详情",
      "from": "*",
      "name": "row_click",
      "navigate_to": "/travel/vacation_offer/{id}",
      "to": "*",
      "trigger": "user_action"
    },
    {
      "description": "跳转新建页",
      "from": "*",
      "name": "navigate_create",
      "navigate_to": "/travel/vacation_offer/new",
      "to": "*",
      "trigger": "user_action"
    }
  ],
  "status_keys": [
    "rows",
    "rows_empty",
    "filter",
    "loading"
  ],
  "ui": {
    "sections": [],
    "template": {
      "list": "list_report"
    }
  },
  "version": 1
}