{
  "version": 1,
  "defaults": {
    "flight_offer": {
      "supplier_code": "",
      "itinerary_code": "",
      "flight_no": "",
      "departure_airport_code": "",
      "arrival_airport_code": "",
      "departure_at": "",
      "arrival_at": "",
      "cabin_class": "",
      "fare_family": "",
      "listed_price": "",
      "settlement_price": "",
      "currency": "",
      "seats_available": "",
      "baggage_policy": "",
      "refund_change_policy": "",
      "sale_status": ""
    },
    "editing": false
  },
  "keys": [
    "editing",
    "flight_offer",
    "flight_offer.arrival_airport_code",
    "flight_offer.arrival_at",
    "flight_offer.baggage_policy",
    "flight_offer.cabin_class",
    "flight_offer.currency",
    "flight_offer.departure_airport_code",
    "flight_offer.departure_at",
    "flight_offer.fare_family",
    "flight_offer.flight_no",
    "flight_offer.itinerary_code",
    "flight_offer.listed_price",
    "flight_offer.refund_change_policy",
    "flight_offer.sale_status",
    "flight_offer.seats_available",
    "flight_offer.settlement_price",
    "flight_offer.supplier_code"
  ],
  "required": [
    "editing",
    "flight_offer"
  ],
  "urlParams": {},
  "notes": [],
  "layer2": {
    "backend": {
      "api_map": {
        "activate": "Travel.FlightOffer.activate",
        "create": "Travel.FlightOffer.create",
        "deactivate": "Travel.FlightOffer.deactivate",
        "destroy": "Travel.FlightOffer.destroy",
        "expire": "Travel.FlightOffer.expire",
        "get": "Travel.FlightOffer.get",
        "update": "Travel.FlightOffer.update"
      },
      "info": {
        "reload_messages": [
          "page_host_reload"
        ]
      },
      "load": {
        "assigns": {},
        "selection": "arrival_airport_code: arrivalAirportCode arrival_airport_ref_id: arrivalAirportRefId arrival_at: arrivalAt baggage_policy: baggagePolicy cabin_class: cabinClass currency departure_airport_code: departureAirportCode departure_airport_ref_id: departureAirportRefId departure_at: departureAt fare_family: fareFamily flight_no: flightNo host_shop_id: hostShopId id itinerary_code: itineraryCode listed_price: listedPrice refund_change_policy: refundChangePolicy sale_status: saleStatus seats_available: seatsAvailable settlement_price: settlementPrice supplier_code: supplierCode tenant_id: tenantId"
      },
      "params": {
        "accept": [
          "id"
        ]
      }
    },
    "children": [],
    "domain": "Travel",
    "e2e": {
      "playwright": {
        "auto": true,
        "base_path": "/travel/flight_offer/:id",
        "cases": [
          {
            "covers": [],
            "name": "页面加载 + 结构可见",
            "steps": [
              {
                "action": "expect_visible",
                "selector": "[data-page='flight_offer_detail']"
              }
            ]
          },
          {
            "covers": [
              "toggle_edit"
            ],
            "name": "编辑模式切换",
            "steps": [
              {
                "action": "click",
                "selector": "[data-action='toggle_edit']"
              },
              {
                "action": "expect_visible",
                "selector": "form, [data-mode='edit']"
              }
            ]
          },
          {
            "covers": [
              "form_submit"
            ],
            "name": "表单提交",
            "steps": [
              {
                "action": "click",
                "selector": "[data-action='form_submit'], button[type='submit']"
              },
              {
                "action": "expect_text_contains",
                "selector": "#flash-group, [data-flash], [role='alert']",
                "value": "成功"
              }
            ]
          },
          {
            "covers": [
              "action_activate"
            ],
            "name": "动作：activate",
            "steps": [
              {
                "action": "click",
                "selector": "[data-action='action_activate']"
              },
              {
                "action": "expect_visible",
                "selector": "[data-action='action_activate']"
              }
            ]
          },
          {
            "covers": [
              "action_deactivate"
            ],
            "name": "动作：deactivate",
            "steps": [
              {
                "action": "click",
                "selector": "[data-action='action_deactivate']"
              },
              {
                "action": "expect_visible",
                "selector": "[data-action='action_deactivate']"
              }
            ]
          },
          {
            "covers": [
              "action_expire"
            ],
            "name": "动作：expire",
            "steps": [
              {
                "action": "click",
                "selector": "[data-action='action_expire']"
              },
              {
                "action": "expect_visible",
                "selector": "[data-action='action_expire']"
              }
            ]
          }
        ],
        "dto_smoke": []
      }
    },
    "entity": "FlightOffer",
    "page_id": "flight_offer_detail",
    "page_type": "object_page",
    "runtime_monitoring": null,
    "schema_version": "1.0",
    "state_transitions": [
      {
        "description": "切换编辑模式",
        "from": "*",
        "name": "toggle_edit",
        "to": "*",
        "trigger": "user_action"
      },
      {
        "description": "取消编辑",
        "from": "*",
        "name": "cancel_edit",
        "to": "*",
        "trigger": "user_action"
      },
      {
        "description": "表单字段变更",
        "from": "*",
        "name": "form_change",
        "to": "*",
        "trigger": "user_input"
      },
      {
        "description": "提交表单",
        "from": "editing",
        "name": "form_submit",
        "to": "loading",
        "trigger": "user_action"
      },
      {
        "description": "activate",
        "from": "*",
        "name": "action_activate",
        "to": "loading",
        "trigger": "user_action"
      },
      {
        "description": "deactivate",
        "from": "*",
        "name": "action_deactivate",
        "to": "loading",
        "trigger": "user_action"
      },
      {
        "description": "expire",
        "from": "*",
        "name": "action_expire",
        "to": "loading",
        "trigger": "user_action"
      },
      {
        "description": "删除记录",
        "from": "*",
        "name": "action_destroy",
        "navigate_to": "/travel/flight_offer",
        "to": "loading",
        "trigger": "user_action"
      }
    ],
    "status_keys": [
      "record",
      "editing",
      "form",
      "loading"
    ],
    "ui": {
      "sections": [],
      "template": {
        "detail": "object_page"
      }
    },
    "version": 1
  }
}