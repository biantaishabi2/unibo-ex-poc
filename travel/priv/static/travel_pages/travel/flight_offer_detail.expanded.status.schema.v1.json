{
  "version": 1,
  "defaults": {
    "record": {
      "supplier_code": "",
      "sale_status": "",
      "itinerary_code": "",
      "flight_no": "",
      "departure_airport_code": "",
      "arrival_airport_code": "",
      "departure_at": "",
      "arrival_at": "",
      "cabin_class": "",
      "fare_family": "",
      "listed_price": "",
      "settlement_price": "",
      "currency": "",
      "seats_available": "",
      "baggage_policy": "",
      "refund_change_policy": ""
    },
    "editing": true
  },
  "keys": [
    "editing",
    "record",
    "record.arrival_airport_code",
    "record.arrival_at",
    "record.baggage_policy",
    "record.cabin_class",
    "record.currency",
    "record.departure_airport_code",
    "record.departure_at",
    "record.fare_family",
    "record.flight_no",
    "record.itinerary_code",
    "record.listed_price",
    "record.refund_change_policy",
    "record.sale_status",
    "record.seats_available",
    "record.settlement_price",
    "record.supplier_code"
  ],
  "required": [
    "editing",
    "record"
  ],
  "urlParams": {},
  "notes": [],
  "layer2": {
    "backend": {
      "api_map": {
        "activate": "Travel.FlightOffer.activate",
        "deactivate": "Travel.FlightOffer.deactivate",
        "destroy": "Travel.FlightOffer.destroy",
        "expire": "Travel.FlightOffer.expire",
        "get": "Travel.FlightOffer.get",
        "update": "Travel.FlightOffer.update"
      }
    },
    "children": [],
    "domain": "Travel",
    "e2e": {
      "playwright": {
        "auto": true,
        "base_path": "/travel/flight_offer/:id",
        "cases": [
          {
            "covers": [],
            "name": "页面加载 + 结构可见",
            "steps": [
              {
                "action": "expect_visible",
                "selector": "[data-page='flight_offer_detail']"
              }
            ]
          },
          {
            "covers": [
              "toggle_edit"
            ],
            "name": "编辑模式切换",
            "steps": [
              {
                "action": "click",
                "selector": "[data-action='toggle_edit']"
              },
              {
                "action": "expect_visible",
                "selector": "form, [data-mode='edit']"
              }
            ]
          },
          {
            "covers": [
              "form_submit"
            ],
            "name": "表单提交",
            "steps": [
              {
                "action": "click",
                "selector": "[data-action='form_submit'], button[type='submit']"
              },
              {
                "action": "expect_text_contains",
                "selector": "#flash-group, [data-flash], [role='alert']",
                "value": "成功"
              }
            ]
          }
        ],
        "dto_smoke": []
      }
    },
    "entity": "FlightOffer",
    "page_id": "flight_offer_detail",
    "page_type": "object_page",
    "runtime_monitoring": null,
    "schema_version": "1.0",
    "state_transitions": [
      {
        "description": "切换编辑模式",
        "from": "*",
        "name": "toggle_edit",
        "to": "*",
        "trigger": "user_action"
      },
      {
        "description": "取消编辑",
        "from": "*",
        "name": "cancel_edit",
        "to": "*",
        "trigger": "user_action"
      },
      {
        "description": "表单字段变更",
        "from": "*",
        "name": "form_change",
        "to": "*",
        "trigger": "user_input"
      },
      {
        "description": "提交表单",
        "from": "editing",
        "name": "form_submit",
        "to": "loading",
        "trigger": "user_action"
      },
      {
        "description": "activate",
        "from": "*",
        "name": "action_activate",
        "to": "loading",
        "trigger": "user_action"
      },
      {
        "description": "deactivate",
        "from": "*",
        "name": "action_deactivate",
        "to": "loading",
        "trigger": "user_action"
      },
      {
        "description": "expire",
        "from": "*",
        "name": "action_expire",
        "to": "loading",
        "trigger": "user_action"
      },
      {
        "description": "删除记录",
        "from": "*",
        "name": "action_destroy",
        "navigate_to": "/travel/flight_offer",
        "to": "loading",
        "trigger": "user_action"
      }
    ],
    "status_keys": [
      "record",
      "editing",
      "form",
      "loading"
    ],
    "ui": {
      "sections": [],
      "template": {
        "detail": "object_page"
      }
    },
    "version": 1
  }
}