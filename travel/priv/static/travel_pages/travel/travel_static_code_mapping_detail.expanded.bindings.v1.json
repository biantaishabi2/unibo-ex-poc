{
  "version": 1,
  "vars": {
    "record.supplier_code": {
      "uses": [
        {
          "node_type": "BreadcrumbPage",
          "node_id": "travel_static_code_mapping_bc_current",
          "location": "prop",
          "prop": "content",
          "template": "{{record.supplier_code|详情}}"
        },
        {
          "node_type": "Text",
          "node_id": "travel_static_code_mapping_detail_title",
          "location": "prop",
          "prop": "content",
          "template": "{{record.supplier_code|}}"
        },
        {
          "node_type": "Text",
          "node_id": "value_supplier_code",
          "location": "prop",
          "prop": "content",
          "template": "{{record.supplier_code|}}"
        }
      ]
    },
    "record.status": {
      "uses": [
        {
          "node_type": "Badge",
          "node_id": "travel_static_code_mapping_status_badge",
          "location": "prop",
          "prop": "content",
          "template": "{{record.status|}}"
        },
        {
          "node_type": "Badge",
          "node_id": "value_status",
          "location": "prop",
          "prop": "content",
          "template": "{{record.status|}}"
        }
      ]
    },
    "record.object_type": {
      "uses": [
        {
          "node_type": "Badge",
          "node_id": "value_object_type",
          "location": "prop",
          "prop": "content",
          "template": "{{record.object_type|}}"
        }
      ]
    },
    "record.canonical_entity": {
      "uses": [
        {
          "node_type": "Text",
          "node_id": "value_canonical_entity",
          "location": "prop",
          "prop": "content",
          "template": "{{record.canonical_entity|}}"
        }
      ]
    },
    "record.external_code": {
      "uses": [
        {
          "node_type": "Text",
          "node_id": "value_external_code",
          "location": "prop",
          "prop": "content",
          "template": "{{record.external_code|}}"
        }
      ]
    },
    "record.external_name": {
      "uses": [
        {
          "node_type": "Text",
          "node_id": "value_external_name",
          "location": "prop",
          "prop": "content",
          "template": "{{record.external_name|}}"
        }
      ]
    }
  },
  "events": {
    "toggle_edit": {
      "triggers": [
        {
          "node_type": "Button",
          "node_id": "travel_static_code_mapping_edit_btn",
          "prop": "click",
          "raw": "toggle_edit"
        }
      ]
    },
    "form_submit": {
      "triggers": [
        {
          "node_type": "Form",
          "node_id": "travel_static_code_mapping_edit_form",
          "prop": "submit",
          "raw": "form_submit"
        },
        {
          "node_type": "Button",
          "node_id": "travel_static_code_mapping_save_btn",
          "prop": "click",
          "raw": "form_submit"
        }
      ]
    },
    "form_change": {
      "triggers": [
        {
          "node_type": "Form",
          "node_id": "travel_static_code_mapping_edit_form",
          "prop": "change",
          "raw": "form_change"
        }
      ]
    },
    "cancel_edit": {
      "triggers": [
        {
          "node_type": "Button",
          "node_id": "travel_static_code_mapping_cancel_btn",
          "prop": "click",
          "raw": "cancel_edit"
        }
      ]
    }
  }
}