<.page title="列表" id="flight_offer_tree">
  <.section layout="none" id="header">
    <.flex justify="between" align="center" direction="row" id="header_bar">
      <.stack direction="column" id="page_meta">
        <.text variant="caption" color="muted" id="breadcrumb">
          FlightOffer
        </.text>
        <.text variant="h1" id="page_title">
          机票可售 offer,承载航班、舱位、票规和库存快照
        </.text>
      </.stack>
      <.button variant="primary" phx-click="navigate_create" size="md" id="create_btn">
        新建
      </.button>
    </.flex>
  </.section>
  <.section layout="none" id="view_tabs">
    <.tabs default_value="all" id="view_selector">
      <.tabs_list id="view_tab_list">
        <.tabs_trigger value="all" active_value="all" id="trigger_all">
          全部
        </.tabs_trigger>
      </.tabs_list>
    </.tabs>
  </.section>
  <.section layout="none" id="filter_section">
    <.card variant="default" id="filter_card">
      <.card_content id="filter_content">
        <.flex gap={4} align="center" direction="row" id="filter_row">
          <.input name="departure_at_from" label="起飞时间 起" size="md" id="filter_departure_at" />
          <.select size="md" name="flight_offer[sale_status]" id="filter_sale_status" :let={builder}>
            <.select_trigger builder={builder} />
            <.select_content builder={builder}>
              <.select_group>
                <.select_item builder={builder} value="draft" label="draft">draft</.select_item>
                <.select_item builder={builder} value="active" label="active">active</.select_item>
                <.select_item builder={builder} value="inactive" label="inactive">inactive</.select_item>
                <.select_item builder={builder} value="" label="expired">expired</.select_item>
              </.select_group>
            </.select_content>
          </.select>
          <.button variant="secondary" phx-click="filter_submit" size="md" id="filter_submit">
            查询
          </.button>
        </.flex>
      </.card_content>
    </.card>
  </.section>
  <.section layout="grid" columns={2} id="table_section">
    <.split ratio="1:3" id="main_split">
      <.stack direction="column" id="left_panel">
        <.tree content="按航空公司分组" id="airline_tree" />
      </.stack>
      <.stack direction="column" id="right_panel" />
    </.split>
    <.table id="data_table">
      <.table_header id="data_header">
        <.table_row id="header_row">
          <.table_head id="th_supplier_code">
            供应商编码
          </.table_head>
          <.table_head id="th_itinerary_code">
            行程编码
          </.table_head>
          <.table_head id="th_flight_no">
            航班号
          </.table_head>
          <.table_head id="th_departure_airport_code">
            出发机场编码
          </.table_head>
          <.table_head id="th_arrival_airport_code">
            到达机场编码
          </.table_head>
          <.table_head id="th_departure_at">
            起飞时间
          </.table_head>
          <.table_head id="th_arrival_at">
            到达时间
          </.table_head>
          <.table_head id="th_cabin_class">
            舱等
          </.table_head>
          <.table_head id="th_fare_family">
            运价族
          </.table_head>
          <.table_head id="th_listed_price">
            对客展示价快照
          </.table_head>
          <.table_head id="th_settlement_price">
            结算价快照
          </.table_head>
          <.table_head id="th_currency">
            currency
          </.table_head>
          <.table_head id="th_seats_available">
            可售座位快照
          </.table_head>
          <.table_head id="th_baggage_policy">
            行李规则快照
          </.table_head>
          <.table_head id="th_refund_change_policy">
            退改规则快照
          </.table_head>
          <.table_head id="th_sale_status">
            sale_status
          </.table_head>
        </.table_row>
      </.table_header>
      <.table_body id="data_body">
        <%= for {row, idx} <- Enum.with_index((@rows || [])) do %>
          <.table_row phx-click="row_click" phx-value-id={row.id} id="flight_offer_row">
            <.table_cell id="td_supplier_code">
              <%= get_in(row, [:supplier_code]) |> then(fn v when is_binary(v) and v != "" -> v; _ -> "" end) %>
            </.table_cell>
            <.table_cell id="td_itinerary_code">
              <%= get_in(row, [:itinerary_code]) |> then(fn v when is_binary(v) and v != "" -> v; _ -> "" end) %>
            </.table_cell>
            <.table_cell id="td_flight_no">
              <%= get_in(row, [:flight_no]) |> then(fn v when is_binary(v) and v != "" -> v; _ -> "" end) %>
            </.table_cell>
            <.table_cell id="td_departure_airport_code">
              <%= get_in(row, [:departure_airport_code]) |> then(fn v when is_binary(v) and v != "" -> v; _ -> "" end) %>
            </.table_cell>
            <.table_cell id="td_arrival_airport_code">
              <%= get_in(row, [:arrival_airport_code]) |> then(fn v when is_binary(v) and v != "" -> v; _ -> "" end) %>
            </.table_cell>
            <.table_cell id="td_departure_at">
              <%= get_in(row, [:departure_at]) |> then(fn v when is_binary(v) and v != "" -> v; _ -> "" end) %>
            </.table_cell>
            <.table_cell id="td_arrival_at">
              <%= get_in(row, [:arrival_at]) |> then(fn v when is_binary(v) and v != "" -> v; _ -> "" end) %>
            </.table_cell>
            <.table_cell id="td_cabin_class">
              <%= get_in(row, [:cabin_class]) |> then(fn v when is_binary(v) and v != "" -> v; _ -> "" end) %>
            </.table_cell>
            <.table_cell id="td_fare_family">
              <%= get_in(row, [:fare_family]) |> then(fn v when is_binary(v) and v != "" -> v; _ -> "" end) %>
            </.table_cell>
            <.table_cell id="td_listed_price">
              <%= get_in(row, [:listed_price]) |> then(fn v when is_binary(v) and v != "" -> v; _ -> "" end) %>
            </.table_cell>
            <.table_cell id="td_settlement_price">
              <%= get_in(row, [:settlement_price]) |> then(fn v when is_binary(v) and v != "" -> v; _ -> "" end) %>
            </.table_cell>
            <.table_cell id="td_currency">
              <%= get_in(row, [:currency]) |> then(fn v when is_binary(v) and v != "" -> v; _ -> "" end) %>
            </.table_cell>
            <.table_cell id="td_seats_available">
              <%= get_in(row, [:seats_available]) |> then(fn v when is_binary(v) and v != "" -> v; _ -> "" end) %>
            </.table_cell>
            <.table_cell id="td_baggage_policy">
              <%= get_in(row, [:baggage_policy]) |> then(fn v when is_binary(v) and v != "" -> v; _ -> "" end) %>
            </.table_cell>
            <.table_cell id="td_refund_change_policy">
              <%= get_in(row, [:refund_change_policy]) |> then(fn v when is_binary(v) and v != "" -> v; _ -> "" end) %>
            </.table_cell>
            <.table_cell id="td_sale_status">
              <%= if (val = get_in(row, [:sale_status])) && to_string(val) != "" do %>
                <.badge variant="default" size="sm" id="badge_sale_status">
                  <%= to_string(val) %>
                </.badge>
              <% end %>
            </.table_cell>
          </.table_row>
        <% end %>
      </.table_body>
    </.table>
  </.section>
  <.section layout="none" id="empty_section">
    <%= if (@rows_empty && @rows_empty != []) do %>
      <.empty_state description="暂无数据" id="no_data" />
    <% end %>
  </.section>
  <.section layout="none" id="footer">
    <.flex gap={2} direction="row" justify="center" id="pagination_bar">
      <.button phx-click="flight_offer_page_prev" variant="primary" size="md" id="page_prev">
        上一页
      </.button>
      <.text id="page_info">
        <%= get_in(@flight_offer, [:page]) |> then(fn v when is_binary(v) and v != "" -> v; _ -> "" end) %> / <%= get_in(@flight_offer, [:total_pages]) |> then(fn v when is_binary(v) and v != "" -> v; _ -> "" end) %>
      </.text>
      <.button phx-click="flight_offer_page_next" variant="primary" size="md" id="page_next">
        下一页
      </.button>
    </.flex>
  </.section>
</.page>