{
  "backend": {
    "api_map": {
      "list": "Travel.FlightOffer.list"
    },
    "info": {
      "reload_messages": [
        "page_host_reload"
      ]
    },
    "load": {
      "assigns": {},
      "selection": "arrival_airport_code: arrivalAirportCode arrival_airport_ref_id: arrivalAirportRefId arrival_at: arrivalAt baggage_policy: baggagePolicy cabin_class: cabinClass currency departure_airport_code: departureAirportCode departure_airport_ref_id: departureAirportRefId departure_at: departureAt fare_family: fareFamily flight_no: flightNo host_shop_id: hostShopId id itinerary_code: itineraryCode listed_price: listedPrice refund_change_policy: refundChangePolicy sale_status: saleStatus seats_available: seatsAvailable settlement_price: settlementPrice supplier_code: supplierCode tenant_id: tenantId"
    },
    "params": {
      "accept": [
        "departure_at",
        "arrival_at",
        "sale_status"
      ]
    }
  },
  "domain": "Travel",
  "e2e": {
    "playwright": {
      "auto": true,
      "base_path": "/travel/flight_offer",
      "cases": [
        {
          "covers": [],
          "name": "页面加载 + 结构可见",
          "steps": [
            {
              "action": "expect_visible",
              "selector": "[data-page='flight_offer_list']"
            }
          ]
        },
        {
          "covers": [
            "navigate_create"
          ],
          "name": "新建导航",
          "steps": [
            {
              "action": "click",
              "selector": "#flight_offer_create_btn, [data-action='navigate_create']"
            },
            {
              "action": "expect_url_contains",
              "value": "/travel/flight_offer/new"
            }
          ]
        },
        {
          "covers": [],
          "name": "表格行存在",
          "steps": [
            {
              "action": "expect_visible",
              "selector": "#flight_offer_table, [data-table='flight_offer']"
            }
          ]
        }
      ],
      "dto_smoke": []
    }
  },
  "entity": "FlightOffer",
  "page_id": "flight_offer_list",
  "page_type": "list_report",
  "runtime_monitoring": null,
  "schema_version": "1.0",
  "state_transitions": [
    {
      "description": "筛选条件变更",
      "from": "*",
      "name": "filter_change",
      "to": "*",
      "trigger": "user_input"
    },
    {
      "description": "提交筛选查询",
      "from": "*",
      "name": "filter_submit",
      "to": "loading",
      "trigger": "user_action"
    },
    {
      "description": "点击行跳转详情",
      "from": "*",
      "name": "row_click",
      "navigate_to": "/travel/flight_offer/{id}",
      "to": "*",
      "trigger": "user_action"
    },
    {
      "description": "跳转新建页",
      "from": "*",
      "name": "navigate_create",
      "navigate_to": "/travel/flight_offer/new",
      "to": "*",
      "trigger": "user_action"
    }
  ],
  "status_keys": [
    "rows",
    "rows_empty",
    "filter",
    "loading"
  ],
  "ui": {
    "sections": [],
    "template": {
      "list": "list_report"
    }
  },
  "version": 1
}