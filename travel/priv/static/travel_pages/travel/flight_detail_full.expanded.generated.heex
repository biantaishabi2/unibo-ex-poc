<.page title="航班详情" id="flight_detail">
  <.section background="primary" padding={4} layout="none" id="route_summary">
    <.flex justify="between" align="center" direction="row" id="route_display">
      <.stack gap={0} align="center" direction="column" id="departure_info">
        <.text variant="h1" weight="bold" color="white" id="departure_time">
          <%= @flight_offer.departure_at %>
        </.text>
        <.text variant="caption" color="white" id="departure_code">
          <%= @flight_offer.departure_airport_code %>
        </.text>
      </.stack>
      <.stack gap={0} align="center" direction="column" id="flight_indicator">
        <.icon name="plane" color="white" id="plane_icon" />
      </.stack>
      <.stack gap={0} align="center" direction="column" id="arrival_info">
        <.text variant="h1" weight="bold" color="white" id="arrival_time">
          <%= @flight_offer.arrival_at %>
        </.text>
        <.text variant="caption" color="white" id="arrival_code">
          <%= @flight_offer.arrival_airport_code %>
        </.text>
      </.stack>
    </.flex>
  </.section>
  <.section layout="none" id="flight_info_section">
    <.card variant="default" id="flight_info_card">
      <.card_header id="flight_info_header">
        <.text variant="h4" weight="bold" id="info_title">
          航班信息
        </.text>
      </.card_header>
      <.card_content id="flight_info_content">
        <.grid columns={2} gap={3} id="info_grid">
          <.text id="fields_display">
            <.text label="航班号" id="flight_no">
              <%= @@flight_offer.flight_no %>
            </.text>
            <.text label="舱等" id="cabin_class">
              <%= @@flight_offer.cabin_class %>
            </.text>
            <.text label="运价族" id="fare_family">
              <%= @@flight_offer.fare_family %>
            </.text>
            <.text label="对客展示价快照" id="listed_price">
              <%= @@flight_offer.listed_price %>
            </.text>
            <.text label="结算价快照" id="settlement_price">
              <%= @@flight_offer.settlement_price %>
            </.text>
            <.text label="currency" id="currency">
              <%= @@flight_offer.currency %>
            </.text>
            <.text label="可售座位快照" id="seats_available">
              <%= @@flight_offer.seats_available %>
            </.text>
            <.text label="行李规则快照" id="baggage_policy">
              <%= @@flight_offer.baggage_policy %>
            </.text>
            <.text label="退改规则快照" id="refund_change_policy">
              <%= @@flight_offer.refund_change_policy %>
            </.text>
          </.text>
        </.grid>
      </.card_content>
    </.card>
  </.section>
  <.section layout="none" id="status_section">
    <.text id="status_display">
      <.badge label="机票 offer 生命周期" variant="default" size="sm" id="flight_offer_lifecycle_status">
        <%= @@flight_offer.flight_offer_lifecycle %>
      </.badge>
      <.button phx-click="flight_offer_create" variant="primary" size="md" id="wf_flight_offer_lifecycle_create">
        create
      </.button>
      <.button phx-click="flight_offer_update" variant="primary" size="md" id="wf_flight_offer_lifecycle_update">
        update
      </.button>
      <.button phx-click="flight_offer_activate" variant="primary" size="md" id="wf_flight_offer_lifecycle_activate">
        activate
      </.button>
      <.button phx-click="flight_offer_deactivate" variant="primary" size="md" id="wf_flight_offer_lifecycle_deactivate">
        deactivate
      </.button>
      <.button phx-click="flight_offer_expire" variant="primary" size="md" id="wf_flight_offer_lifecycle_expire">
        expire
      </.button>
      <.button phx-click="flight_offer_destroy" variant="primary" size="md" id="wf_flight_offer_lifecycle_destroy">
        destroy
      </.button>
    </.text>
  </.section>
  <.section layout="none" id="actions_section">
    <.text id="offer_actions">
      <.button phx-click="flight_offer_activate" variant="primary" size="md" id="activate">
        activate
      </.button>
      <.button phx-click="flight_offer_deactivate" variant="primary" size="md" id="deactivate">
        deactivate
      </.button>
      <.button phx-click="flight_offer_expire" variant="primary" size="md" id="expire">
        expire
      </.button>
    </.text>
  </.section>
  <.section layout="none" id="orders_section">
    <.text id="orders_table">
      <.table_header id="orders_header">
        <.text id="th_tenant_id">
          tenant_id
        </.text>
        <.text id="th_host_shop_id">
          宿主商城 ID,用于 sidecar 对接上下文
        </.text>
        <.text id="th_host_member_id">
          宿主会员标识,来自 shop caller context
        </.text>
        <.text id="th_host_enterprise_id">
          宿主企业标识,来自 shop caller context
        </.text>
        <.text id="th_order_no">
          订单号
        </.text>
        <.text id="th_product_type">
          商品类型
        </.text>
        <.text id="th_booking_mode">
          train 订单预订模式
        </.text>
        <.text id="th_contact_name">
          contact_name
        </.text>
        <.text id="th_contact_phone">
          contact_phone
        </.text>
        <.text id="th_traveler_count">
          出行人数量
        </.text>
        <.text id="th_total_amount">
          订单总金额
        </.text>
        <.text id="th_points_to_use">
          计划使用的积分数量
        </.text>
        <.text id="th_points_deduction_amount">
          积分抵现金额
        </.text>
        <.text id="th_recommended_payment_method">
          宿主 quote 返回的推荐支付方式
        </.text>
        <.text id="th_currency">
          currency
        </.text>
        <.text id="th_status">
          status
        </.text>
        <.text id="th_change_status">
          change_status
        </.text>
        <.text id="th_waitlist_status">
          waitlist_status
        </.text>
        <.text id="th_original_order_ref">
          改签链路引用的原订单号或原票号
        </.text>
        <.text id="th_ticket_passenger_infos">
          乘车人信息快照
        </.text>
        <.text id="th_seat_selection_snapshot">
          选座与席别偏好快照
        </.text>
        <.text id="th_supplier_order_ref">
          供应商订单号
        </.text>
        <.text id="th_payment_external_ref">
          宿主支付侧外部支付流水号
        </.text>
      </.table_header>
      <.table_body id="orders_body">
        <%= for travel_order <- @flight_offer.orders do %>
          <.text>
            <%= @@travel_order.tenant_id %>
          </.text>
          <.text>
            <%= @@travel_order.host_shop_id %>
          </.text>
          <.text>
            <%= @@travel_order.host_member_id %>
          </.text>
          <.text>
            <%= @@travel_order.host_enterprise_id %>
          </.text>
          <.text>
            <%= @@travel_order.order_no %>
          </.text>
          <.badge variant="default" size="sm">
            <%= @@travel_order.product_type %>
          </.badge>
          <.badge variant="default" size="sm">
            <%= @@travel_order.booking_mode %>
          </.badge>
          <.text>
            <%= @@travel_order.contact_name %>
          </.text>
          <.text>
            <%= @@travel_order.contact_phone %>
          </.text>
          <.text>
            <%= @@travel_order.traveler_count %>
          </.text>
          <.text>
            <%= @@travel_order.total_amount %>
          </.text>
          <.text>
            <%= @@travel_order.points_to_use %>
          </.text>
          <.text>
            <%= @@travel_order.points_deduction_amount %>
          </.text>
          <.text>
            <%= @@travel_order.recommended_payment_method %>
          </.text>
          <.text>
            <%= @@travel_order.currency %>
          </.text>
          <.badge variant="default" size="sm">
            <%= @@travel_order.status %>
          </.badge>
          <.badge variant="default" size="sm">
            <%= @@travel_order.change_status %>
          </.badge>
          <.badge variant="default" size="sm">
            <%= @@travel_order.waitlist_status %>
          </.badge>
          <.text>
            <%= @@travel_order.original_order_ref %>
          </.text>
          <.text>
            <%= @@travel_order.ticket_passenger_infos %>
          </.text>
          <.text>
            <%= @@travel_order.seat_selection_snapshot %>
          </.text>
          <.text>
            <%= @@travel_order.supplier_order_ref %>
          </.text>
          <.text>
            <%= @@travel_order.payment_external_ref %>
          </.text>
        <% end %>
      </.table_body>
    </.text>
  </.section>
</.page>