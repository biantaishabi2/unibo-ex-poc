<.page title="TravelHotel 列表" id="travel_hotel_list">
  <.section direction="row" justify="between" align="center" layout="grid" columns={2} id="travel_hotel_header">
    <.text variant="title" id="travel_hotel_title">
      <%= @page_title %>
    </.text>
    <.button variant="primary" phx-click="navigate_create" size="md" id="travel_hotel_create_btn">
      新建
    </.button>
  </.section>
  <.card variant="default" id="travel_hotel_filter_card">
    <.card_content id="travel_hotel_filter_content">
      <.flex gap={4} align="center" direction="row" id="travel_hotel_filter_row">
        <.select name="status" label="status" size="md" id="filter_status">

        </.select>
        <.button variant="secondary" phx-click="filter_submit" size="md" id="travel_hotel_filter_submit">
          查询
        </.button>
      </.flex>
    </.card_content>
  </.card>
  <.table id="travel_hotel_table">
    <.table_header id="travel_hotel_table_header">
      <.table_row id="travel_hotel_header_row">
        <.table_head id="th_hotel_code">
          酒店规范编码
        </.table_head>
        <.table_head id="th_hotel_name">
          酒店名称
        </.table_head>
        <.table_head id="th_city_code">
          城市编码冗余（便于兼容检索）
        </.table_head>
        <.table_head id="th_hotel_star">
          酒店星级
        </.table_head>
        <.table_head id="th_status">
          status
        </.table_head>
      </.table_row>
    </.table_header>
    <.table_body id="travel_hotel_table_body">
      <%= for row <- @rows do %>
        <.table_row>
          <.table_cell>
            <%= row.hotel_code %>
          </.table_cell>
          <.table_cell>
            <%= row.hotel_name %>
          </.table_cell>
          <.table_cell>
            <%= row.city_code %>
          </.table_cell>
          <.table_cell>
            <%= row.hotel_star %>
          </.table_cell>
          <.table_cell>
            <.badge variant="default" size="sm">
              <%= row.status %>
            </.badge>
          </.table_cell>
        </.table_row>
      <% end %>
    </.table_body>
  </.table>
  <%= if (@rows_empty && @rows_empty != []) do %>
    <.empty_state description="暂无酒店主数据（Travel 层,来源 OFBiz Product）数据" id="travel_hotel_no_data" />
  <% end %>
</.page>