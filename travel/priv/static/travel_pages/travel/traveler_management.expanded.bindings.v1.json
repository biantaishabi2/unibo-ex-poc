{
  "version": 1,
  "vars": {},
  "events": {
    "open_dialog:traveler_edit_dialog:create": {
      "triggers": [
        {
          "node_type": "Button",
          "node_id": "add_traveler_btn",
          "prop": "click",
          "raw": "open_dialog:traveler_edit_dialog:create"
        }
      ]
    },
    "open_dialog:traveler_edit_dialog:edit:{{item.id|}}": {
      "triggers": [
        {
          "node_type": "Button",
          "node_id": "edit_btn",
          "prop": "click",
          "raw": "open_dialog:traveler_edit_dialog:edit:{{item.id|}}"
        }
      ]
    },
    "delete:Travel.TravelerProfile:{{item.id|}}": {
      "triggers": [
        {
          "node_type": "Button",
          "node_id": "delete_btn",
          "prop": "click",
          "raw": "delete:Travel.TravelerProfile:{{item.id|}}"
        }
      ]
    },
    "close_dialog:traveler_edit_dialog": {
      "triggers": [
        {
          "node_type": "Button",
          "node_id": "cancel_btn",
          "prop": "click",
          "raw": "close_dialog:traveler_edit_dialog"
        }
      ]
    },
    "submit_form:Travel.TravelerProfile": {
      "triggers": [
        {
          "node_type": "Button",
          "node_id": "save_btn",
          "prop": "click",
          "raw": "submit_form:Travel.TravelerProfile"
        }
      ]
    }
  }
}