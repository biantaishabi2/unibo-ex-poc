{
  "version": 1,
  "vars": {
    "search.route_label": {
      "uses": [
        {
          "node_type": "Header",
          "node_id": "flight_header",
          "location": "prop",
          "prop": "subtitle",
          "template": "{{search.route_label|}}"
        }
      ]
    }
  },
  "events": {
    "select_date": {
      "triggers": [
        {
          "node_type": "Badge",
          "node_id": "flight_date_badge",
          "prop": "click",
          "raw": "select_date"
        }
      ]
    },
    "navigate": {
      "triggers": [
        {
          "node_type": "Card",
          "node_id": "flight_card",
          "prop": "click",
          "raw": "navigate"
        }
      ]
    },
    "sort": {
      "triggers": [
        {
          "node_type": "Button",
          "node_id": "sort_by_departure",
          "prop": "click",
          "raw": "sort"
        },
        {
          "node_type": "Button",
          "node_id": "sort_by_price",
          "prop": "click",
          "raw": "sort"
        },
        {
          "node_type": "Button",
          "node_id": "sort_by_recommended",
          "prop": "click",
          "raw": "sort"
        }
      ]
    }
  }
}