<.page title="TravelHotel 详情" id="travel_hotel_detail">
  <.breadcrumb id="travel_hotel_breadcrumb">
    <.breadcrumb_list id="travel_hotel_bc_list">
      <.breadcrumb_item id="travel_hotel_bc_list_item">
        <.breadcrumb_link id="travel_hotel_bc_link">
          TravelHotel 列表
        </.breadcrumb_link>
      </.breadcrumb_item>
      <.breadcrumb_separator id="travel_hotel_bc_sep" />
      <.breadcrumb_item id="travel_hotel_bc_current_item">
        <.breadcrumb_page id="travel_hotel_bc_current">
          <%= get_in(@record, [:hotel_code]) || "详情" %>
        </.breadcrumb_page>
      </.breadcrumb_item>
    </.breadcrumb_list>
  </.breadcrumb>
  <.section direction="row" justify="between" align="center" layout="grid" columns={2} id="travel_hotel_detail_header">
    <.flex gap={3} align="center" direction="row" id="travel_hotel_title_group">
      <.text variant="title" id="travel_hotel_detail_title">
        <%= get_in(@record, [:hotel_code]) || "" %>
      </.text>
      <%= if (val = get_in(@record, [:status])) && to_string(val) != "" do %>
        <.badge variant="default" size="sm" id="travel_hotel_status_badge">
          <%= to_string(val) %>
        </.badge>
      <% end %>
    </.flex>
    <.flex gap={2} direction="row" id="travel_hotel_actions">
      <.button variant="secondary" phx-click="toggle_edit" size="md" id="travel_hotel_edit_btn">
        编辑
      </.button>
    </.flex>
  </.section>
  <.card variant="default" id="travel_hotel_info_card">
    <.card_header id="travel_hotel_info_header">
      <.card_title id="travel_hotel_info_title">
        基本信息
      </.card_title>
    </.card_header>
    <.card_content id="travel_hotel_info_content">
      <%= if !(@editing && @editing != []) do %>
        <.grid columns={2} gap={4} id="travel_hotel_info_grid">
          <.flex direction="row" id="field_hotel_code">
            <.text variant="muted" id="label_hotel_code">
              酒店规范编码
            </.text>
            <.text id="value_hotel_code">
              <%= get_in(@record, [:hotel_code]) || "" %>
            </.text>
          </.flex>
          <.flex direction="row" id="field_hotel_name">
            <.text variant="muted" id="label_hotel_name">
              酒店名称
            </.text>
            <.text id="value_hotel_name">
              <%= get_in(@record, [:hotel_name]) || "" %>
            </.text>
          </.flex>
          <.flex direction="row" id="field_city_code">
            <.text variant="muted" id="label_city_code">
              城市编码冗余（便于兼容检索）
            </.text>
            <.text id="value_city_code">
              <%= get_in(@record, [:city_code]) || "" %>
            </.text>
          </.flex>
          <.flex direction="row" id="field_hotel_star">
            <.text variant="muted" id="label_hotel_star">
              酒店星级
            </.text>
            <.text id="value_hotel_star">
              <%= get_in(@record, [:hotel_star]) || "" %>
            </.text>
          </.flex>
          <.flex direction="row" id="field_status">
            <.text variant="muted" id="label_status">
              status
            </.text>
            <%= if (val = get_in(@record, [:status])) && to_string(val) != "" do %>
              <.badge variant="default" size="sm" id="value_status">
                <%= to_string(val) %>
              </.badge>
            <% end %>
          </.flex>
        </.grid>
      <% else %>
        <.form phx-submit="form_submit" phx-change="form_change" id="travel_hotel_edit_form">
          <.grid columns={2} gap={4} id="travel_hotel_form_grid">
            <.input name="hotel_code" label="酒店规范编码" placeholder="请输入酒店规范编码" required="true" size="md" id="form_hotel_code" value={@record.hotel_code} />
            <.input name="hotel_name" label="酒店名称" placeholder="请输入酒店名称" required="true" size="md" id="form_hotel_name" value={@record.hotel_name} />
            <.input name="city_code" label="城市编码冗余（便于兼容检索）" placeholder="请输入城市编码冗余（便于兼容检索）" size="md" id="form_city_code" value={@record.city_code} />
            <.input name="hotel_star" label="酒店星级" placeholder="请输入酒店星级" size="md" id="form_hotel_star" value={@record.hotel_star} />
            <.select name="status" label="status" size="md" id="form_status" value={@record.status}>

            </.select>
            <.input name="city_id" label="城市引用（跨域引用 Ecommerce.TravelCity）" placeholder="请输入城市引用（跨域引用 Ecommerce.TravelCity）" size="md" id="form_city_id" value={@record.city_id} />
          </.grid>
          <.flex justify="end" gap={2} direction="row" id="travel_hotel_form_actions">
            <.button variant="secondary" phx-click="cancel_edit" size="md" id="travel_hotel_cancel_btn">
              取消
            </.button>
            <.button variant="primary" phx-click="form_submit" size="md" id="travel_hotel_save_btn">
              保存
            </.button>
          </.flex>
        </.form>
      <% end %>
    </.card_content>
  </.card>
</.page>