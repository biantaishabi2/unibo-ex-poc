{
  "version": 1,
  "vars": {
    "page_title": {
      "uses": [
        {
          "node_type": "Text",
          "node_id": "hotel_offer_title",
          "location": "prop",
          "prop": "content",
          "template": "{{page_title|HotelOffer 列表}}"
        }
      ]
    }
  },
  "events": {
    "navigate_create": {
      "triggers": [
        {
          "node_type": "Button",
          "node_id": "hotel_offer_create_btn",
          "prop": "click",
          "raw": "navigate_create"
        }
      ]
    },
    "filter_submit": {
      "triggers": [
        {
          "node_type": "Button",
          "node_id": "hotel_offer_filter_submit",
          "prop": "click",
          "raw": "filter_submit"
        }
      ]
    }
  }
}