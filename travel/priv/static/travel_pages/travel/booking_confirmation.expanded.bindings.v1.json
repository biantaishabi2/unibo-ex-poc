{
  "version": 1,
  "vars": {
    "order.order_no": {
      "uses": [
        {
          "node_type": "Text",
          "node_id": "order_no_value",
          "location": "prop",
          "prop": "content",
          "template": "{{order.order_no|}}"
        }
      ]
    },
    "order.product_type": {
      "uses": [
        {
          "node_type": "Badge",
          "node_id": "product_type_badge",
          "location": "prop",
          "prop": "content",
          "template": "{{order.product_type|}}"
        }
      ]
    },
    "order.flight_offer.flight_no": {
      "uses": [
        {
          "node_type": "Text",
          "node_id": "flight_value",
          "location": "prop",
          "prop": "content",
          "template": "{{order.flight_offer.flight_no|}}"
        }
      ]
    },
    "order.hotel_offer.hotel_name": {
      "uses": [
        {
          "node_type": "Text",
          "node_id": "hotel_value",
          "location": "prop",
          "prop": "content",
          "template": "{{order.hotel_offer.hotel_name|}}"
        }
      ]
    },
    "order.train_offer.train_no": {
      "uses": [
        {
          "node_type": "Text",
          "node_id": "train_value",
          "location": "prop",
          "prop": "content",
          "template": "{{order.train_offer.train_no|}}"
        }
      ]
    },
    "order.traveler_count": {
      "uses": [
        {
          "node_type": "Text",
          "node_id": "traveler_count_value",
          "location": "prop",
          "prop": "content",
          "template": "{{order.traveler_count|}}"
        }
      ]
    },
    "order.total_amount": {
      "uses": [
        {
          "node_type": "Text",
          "node_id": "amount_value",
          "location": "prop",
          "prop": "content",
          "template": "{{order.total_amount|}}"
        }
      ]
    },
    "order.id": {
      "uses": [
        {
          "node_type": "Button",
          "node_id": "view_order_btn",
          "location": "prop",
          "prop": "click",
          "template": "navigate:/travel/orders/{{order.id|}}"
        }
      ]
    }
  },
  "events": {
    "navigate:/travel/orders/{{order.id|}}": {
      "triggers": [
        {
          "node_type": "Button",
          "node_id": "view_order_btn",
          "prop": "click",
          "raw": "navigate:/travel/orders/{{order.id|}}"
        }
      ]
    },
    "navigate:/travel": {
      "triggers": [
        {
          "node_type": "Button",
          "node_id": "go_home_btn",
          "prop": "click",
          "raw": "navigate:/travel"
        }
      ]
    }
  }
}