{
  "backend": {
    "api_map": {
      "list": "Travel.HotelOffer.list"
    },
    "info": {
      "reload_messages": [
        "page_host_reload"
      ]
    },
    "load": {
      "assigns": {},
      "selection": "cancellation_policy: cancellationPolicy checkin_date: checkinDate checkout_date: checkoutDate city_code: cityCode city_ref_id: cityRefId currency guarantee_policy: guaranteePolicy host_shop_id: hostShopId hotel_code: hotelCode hotel_name: hotelName id inventory_count: inventoryCount listed_price: listedPrice rate_plan_code: ratePlanCode room_type_code: roomTypeCode sale_status: saleStatus settlement_price: settlementPrice supplier_code: supplierCode tenant_id: tenantId"
    },
    "params": {
      "accept": [
        "checkin_date",
        "checkout_date",
        "sale_status"
      ]
    }
  },
  "domain": "Travel",
  "e2e": {
    "playwright": {
      "auto": true,
      "base_path": "/travel/hotel_offer",
      "cases": [
        {
          "covers": [],
          "name": "页面加载 + 结构可见",
          "steps": [
            {
              "action": "expect_visible",
              "selector": "[data-page='hotel_offer_list']"
            }
          ]
        },
        {
          "covers": [
            "navigate_create"
          ],
          "name": "新建导航",
          "steps": [
            {
              "action": "click",
              "selector": "#hotel_offer_create_btn, [data-action='navigate_create']"
            },
            {
              "action": "expect_url_contains",
              "value": "/travel/hotel_offer/new"
            }
          ]
        },
        {
          "covers": [],
          "name": "表格行存在",
          "steps": [
            {
              "action": "expect_visible",
              "selector": "#hotel_offer_table, [data-table='hotel_offer']"
            }
          ]
        }
      ],
      "dto_smoke": []
    }
  },
  "entity": "HotelOffer",
  "page_id": "hotel_offer_list",
  "page_type": "list_report",
  "runtime_monitoring": null,
  "schema_version": "1.0",
  "state_transitions": [
    {
      "description": "筛选条件变更",
      "from": "*",
      "name": "filter_change",
      "to": "*",
      "trigger": "user_input"
    },
    {
      "description": "提交筛选查询",
      "from": "*",
      "name": "filter_submit",
      "to": "loading",
      "trigger": "user_action"
    },
    {
      "description": "点击行跳转详情",
      "from": "*",
      "name": "row_click",
      "navigate_to": "/travel/hotel_offer/{id}",
      "to": "*",
      "trigger": "user_action"
    },
    {
      "description": "跳转新建页",
      "from": "*",
      "name": "navigate_create",
      "navigate_to": "/travel/hotel_offer/new",
      "to": "*",
      "trigger": "user_action"
    }
  ],
  "status_keys": [
    "rows",
    "rows_empty",
    "filter",
    "loading"
  ],
  "ui": {
    "sections": [],
    "template": {
      "list": "list_report"
    }
  },
  "version": 1
}