<.page title="详情" id="oa_integration_config">
  <.section layout="none" id="breadcrumb_section">
    <.breadcrumb id="page_breadcrumb">
      <.breadcrumb_list id="bc_list">
        <.breadcrumb_item id="bc_list_item">
          <.breadcrumb_link id="bc_link">
            列表
          </.breadcrumb_link>
        </.breadcrumb_item>
        <.breadcrumb_separator id="bc_sep" />
        <.breadcrumb_item id="bc_current_item">
          <.breadcrumb_page id="bc_current">
            详情
          </.breadcrumb_page>
        </.breadcrumb_item>
      </.breadcrumb_list>
    </.breadcrumb>
  </.section>
  <.section direction="row" justify="between" align="center" layout="grid" columns={2} id="detail_header">
    <.flex gap={3} align="center" direction="row" id="title_group">
      <.stack direction="column" id="title_meta">
        <.text variant="caption" color="muted" id="breadcrumb">
          TravelOrder
        </.text>
        <.text variant="h1" id="page_title">
          统一酒旅订单,承接 hotel、flight、vacation、train 四类商品的下单和状态流转;通过跨域引用关联 Sales::Customer 和 Payment::Payment
        </.text>
      </.stack>
      <%= case get_in(@travel_order, [:status]) do %>
        <% "draft" -> %>
          <.badge color="yellow">draft</.badge>
        <% "quoted" -> %>
          <.badge color="blue">quoted</.badge>
        <% "submitted" -> %>
          <.badge color="blue">submitted</.badge>
        <% "booking_pending" -> %>
          <.badge color="blue">booking_pending</.badge>
        <% "booked" -> %>
          <.badge color="blue">booked</.badge>
        <% "cancel_pending" -> %>
          <.badge color="blue">cancel_pending</.badge>
        <% "cancelled" -> %>
          <.badge color="red">cancelled</.badge>
        <% "completed" -> %>
          <.badge color="green">completed</.badge>
        <% "failed" -> %>
          <.badge color="blue">failed</.badge>
        <% _ -> %>
          <.badge />
      <% end %>
    </.flex>
    <.flex gap={2} direction="row" id="actions_group">
      <.button variant="secondary" phx-click="toggle_edit" size="md" id="edit_btn">
        编辑
      </.button>
      <%= if to_string(get_in(@record, [:status])) == "draft" do %>
        <.button variant="secondary" phx-click="action_confirm_quote" size="md" id="travel_order_action_confirm_quote">
          confirm_quote
        </.button>
      <% end %>
      <%= if to_string(get_in(@record, [:status])) == "quoted" do %>
        <.button variant="secondary" phx-click="action_submit_order" size="md" id="travel_order_action_submit_order">
          submit_order
        </.button>
      <% end %>
      <%= if to_string(get_in(@record, [:status])) == "quoted" do %>
        <.button variant="secondary" phx-click="action_submit_waitlist" size="md" id="travel_order_action_submit_waitlist">
          submit_waitlist
        </.button>
      <% end %>
      <%= if to_string(get_in(@record, [:status])) == "submitted" do %>
        <.button variant="secondary" phx-click="action_mark_payment_succeeded" size="md" id="travel_order_action_mark_payment_succeeded">
          mark_payment_succeeded
        </.button>
      <% end %>
      <%= if to_string(get_in(@record, [:status])) == "booking_pending" do %>
        <.button variant="secondary" phx-click="action_mark_booked" size="md" id="travel_order_action_mark_booked">
          mark_booked
        </.button>
      <% end %>
      <%= if to_string(get_in(@record, [:status])) == "booking_pending" do %>
        <.button variant="secondary" phx-click="action_fulfill_waitlist" size="md" id="travel_order_action_fulfill_waitlist">
          fulfill_waitlist
        </.button>
      <% end %>
      <%= if to_string(get_in(@record, [:status])) == "booked" do %>
        <.button variant="secondary" phx-click="action_mark_completed" size="md" id="travel_order_action_mark_completed">
          mark_completed
        </.button>
      <% end %>
      <%= if to_string(get_in(@record, [:status])) == "booked" do %>
        <.button variant="secondary" phx-click="action_request_cancel" size="md" id="travel_order_action_request_cancel">
          request_cancel
        </.button>
      <% end %>
      <%= if to_string(get_in(@record, [:status])) == "booking_pending" do %>
        <.button variant="secondary" phx-click="action_cancel_waitlist" size="md" id="travel_order_action_cancel_waitlist">
          cancel_waitlist
        </.button>
      <% end %>
      <%= if to_string(get_in(@record, [:status])) == "cancel_pending" do %>
        <.button variant="secondary" phx-click="action_execute_cancel" size="md" id="travel_order_action_execute_cancel">
          execute_cancel
        </.button>
      <% end %>
      <%= if to_string(get_in(@record, [:status])) == "cancel_pending" do %>
        <.button variant="secondary" phx-click="action_cancel_cancel_request" size="md" id="travel_order_action_cancel_cancel_request">
          cancel_cancel_request
        </.button>
      <% end %>
      <.button variant="secondary" phx-click="action_request_change" size="md" id="travel_order_action_request_change">
        request_change
      </.button>
      <.button variant="secondary" phx-click="action_confirm_change" size="md" id="travel_order_action_confirm_change">
        confirm_change
      </.button>
      <%= if to_string(get_in(@record, [:status])) == "submitted" do %>
        <.button variant="secondary" phx-click="action_mark_order_failed" size="md" id="travel_order_action_mark_order_failed">
          mark_order_failed
        </.button>
      <% end %>
      <.button variant="danger" phx-click="action_destroy" size="md" id="delete_btn">
        删除
      </.button>
    </.flex>
  </.section>
  <.section layout="none" id="info_section" />
  <.split ratio="1:3" id="settings_split">
    <.card variant="default" id="nav_card">
      <.card_content id="nav_content">
        <.stack gap={1} direction="column" id="nav_menu">
          <.button variant="ghost" phx-click="navigate_general" size="md" id="nav_general">
            基本设置
          </.button>
          <.button variant="ghost" phx-click="navigate_notification" size="md" id="nav_notification">
            通知设置
          </.button>
          <.button variant="ghost" phx-click="navigate_security" size="md" id="nav_security">
            安全设置
          </.button>
          <.button variant="ghost" phx-click="navigate_display" size="md" id="nav_display">
            显示设置
          </.button>
          <.button variant="ghost" phx-click="navigate_advanced" size="md" id="nav_advanced">
            高级设置
          </.button>
        </.stack>
      </.card_content>
    </.card>
    <.stack gap={4} direction="column" id="settings_content">
      <.card variant="default" id="general_card">
        <.card_header id="general_header">
          <.card_title id="general_title">
            基本设置
          </.card_title>
        </.card_header>
        <.card_content id="general_content">
          <.stack gap={3} direction="column" id="general_fields">
            <.input name="site_name" label="站点名称" placeholder="请输入站点名称" size="md" id="setting_name" value={@record.site_name} />
            <.input name="logo" label="Logo" type="file" size="md" id="setting_logo" value={@record.logo} />
            <.textarea name="site_description" label="站点描述" placeholder="请输入站点描述" id="setting_description" value={@record.site_description} />
          </.stack>
        </.card_content>
      </.card>
      <.card variant="default" id="notification_card">
        <.card_header id="notification_header">
          <.card_title id="notification_title">
            通知设置
          </.card_title>
        </.card_header>
        <.card_content id="notification_content">
          <.stack gap={3} direction="column" id="notification_fields">
            <.select name="notify_method" label="默认通知方式" size="md" id="notify_method" :let={builder} value={@record.notify_method}>
              <.select_trigger builder={builder} />
              <.select_content builder={builder}>
                <.select_group>
                  <.select_item builder={builder} value="sms" label="短信">短信</.select_item>
                </.select_group>
              </.select_content>
            </.select>
            <.select name="notify_frequency" label="通知频率" size="md" id="notify_frequency" :let={builder} value={@record.notify_frequency}>
              <.select_trigger builder={builder} />
              <.select_content builder={builder}>
                <.select_group>
                  <.select_item builder={builder} value="weekly" label="每周汇总">每周汇总</.select_item>
                </.select_group>
              </.select_content>
            </.select>
          </.stack>
        </.card_content>
      </.card>
      <.card variant="default" id="security_card">
        <.card_header id="security_header">
          <.card_title id="security_title">
            安全设置
          </.card_title>
        </.card_header>
        <.card_content id="security_content">
          <.stack gap={3} direction="column" id="security_fields">
            <.select name="session_timeout" label="会话超时时间" size="md" id="session_timeout" :let={builder} value={@record.session_timeout}>
              <.select_trigger builder={builder} />
              <.select_content builder={builder}>
                <.select_group>
                  <.select_item builder={builder} value="240" label="4小时">4小时</.select_item>
                </.select_group>
              </.select_content>
            </.select>
            <.select name="password_policy" label="密码策略" size="md" id="password_policy" :let={builder} value={@record.password_policy}>
              <.select_trigger builder={builder} />
              <.select_content builder={builder}>
                <.select_group>
                  <.select_item builder={builder} value="strict" label="严格">严格</.select_item>
                </.select_group>
              </.select_content>
            </.select>
          </.stack>
        </.card_content>
      </.card>
    </.stack>
  </.split>
</.page>