{
  "backend": {
    "api_map": {
      "list": "Travel.TravelCabinClass.list"
    },
    "info": {
      "reload_messages": [
        "page_host_reload"
      ]
    },
    "load": {
      "assigns": {},
      "selection": "cabin_class_code: cabinClassCode cabin_class_name: cabinClassName cabin_rank: cabinRank id status"
    },
    "params": {
      "accept": [
        "status"
      ]
    }
  },
  "domain": "Travel",
  "e2e": {
    "playwright": {
      "auto": true,
      "base_path": "/travel/travel_cabin_class",
      "cases": [
        {
          "covers": [],
          "name": "页面加载 + 结构可见",
          "steps": [
            {
              "action": "expect_visible",
              "selector": "[data-page='travel_cabin_class_list']"
            }
          ]
        },
        {
          "covers": [
            "navigate_create"
          ],
          "name": "新建导航",
          "steps": [
            {
              "action": "click",
              "selector": "#travel_cabin_class_create_btn, [data-action='navigate_create']"
            },
            {
              "action": "expect_url_contains",
              "value": "/travel/travel_cabin_class/new"
            }
          ]
        },
        {
          "covers": [],
          "name": "表格行存在",
          "steps": [
            {
              "action": "expect_visible",
              "selector": "#travel_cabin_class_table, [data-table='travel_cabin_class']"
            }
          ]
        }
      ],
      "dto_smoke": []
    }
  },
  "entity": "TravelCabinClass",
  "page_id": "travel_cabin_class_list",
  "page_type": "list_report",
  "runtime_monitoring": null,
  "schema_version": "1.0",
  "state_transitions": [
    {
      "description": "筛选条件变更",
      "from": "*",
      "name": "filter_change",
      "to": "*",
      "trigger": "user_input"
    },
    {
      "description": "提交筛选查询",
      "from": "*",
      "name": "filter_submit",
      "to": "loading",
      "trigger": "user_action"
    },
    {
      "description": "点击行跳转详情",
      "from": "*",
      "name": "row_click",
      "navigate_to": "/travel/travel_cabin_class/{id}",
      "to": "*",
      "trigger": "user_action"
    },
    {
      "description": "跳转新建页",
      "from": "*",
      "name": "navigate_create",
      "navigate_to": "/travel/travel_cabin_class/new",
      "to": "*",
      "trigger": "user_action"
    }
  ],
  "status_keys": [
    "rows",
    "rows_empty",
    "filter",
    "loading"
  ],
  "ui": {
    "sections": [],
    "template": {
      "list": "list_report"
    }
  },
  "version": 1
}