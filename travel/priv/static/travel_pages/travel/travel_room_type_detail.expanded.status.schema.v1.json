{
  "version": 1,
  "defaults": {
    "record": {
      "room_type_code": "",
      "status": "",
      "room_type_name": "",
      "hotel_code": "",
      "bed_type": ""
    },
    "editing": true
  },
  "keys": [
    "editing",
    "record",
    "record.bed_type",
    "record.hotel_code",
    "record.room_type_code",
    "record.room_type_name",
    "record.status"
  ],
  "required": [
    "editing",
    "record"
  ],
  "urlParams": {},
  "notes": [],
  "layer2": {
    "backend": {
      "api_map": {
        "get": "Travel.TravelRoomType.get",
        "update": "Travel.TravelRoomType.update"
      }
    },
    "children": [],
    "domain": "Travel",
    "e2e": {
      "playwright": {
        "auto": true,
        "base_path": "/travel/travel_room_type/:id",
        "cases": [
          {
            "covers": [],
            "name": "页面加载 + 结构可见",
            "steps": [
              {
                "action": "expect_visible",
                "selector": "[data-page='travel_room_type_detail']"
              }
            ]
          },
          {
            "covers": [
              "toggle_edit"
            ],
            "name": "编辑模式切换",
            "steps": [
              {
                "action": "click",
                "selector": "[data-action='toggle_edit']"
              },
              {
                "action": "expect_visible",
                "selector": "form, [data-mode='edit']"
              }
            ]
          },
          {
            "covers": [
              "form_submit"
            ],
            "name": "表单提交",
            "steps": [
              {
                "action": "click",
                "selector": "[data-action='form_submit'], button[type='submit']"
              },
              {
                "action": "expect_text_contains",
                "selector": "#flash-group, [data-flash], [role='alert']",
                "value": "成功"
              }
            ]
          }
        ],
        "dto_smoke": []
      }
    },
    "entity": "TravelRoomType",
    "page_id": "travel_room_type_detail",
    "page_type": "object_page",
    "runtime_monitoring": null,
    "schema_version": "1.0",
    "state_transitions": [
      {
        "description": "切换编辑模式",
        "from": "*",
        "name": "toggle_edit",
        "to": "*",
        "trigger": "user_action"
      },
      {
        "description": "取消编辑",
        "from": "*",
        "name": "cancel_edit",
        "to": "*",
        "trigger": "user_action"
      },
      {
        "description": "表单字段变更",
        "from": "*",
        "name": "form_change",
        "to": "*",
        "trigger": "user_input"
      },
      {
        "description": "提交表单",
        "from": "editing",
        "name": "form_submit",
        "to": "loading",
        "trigger": "user_action"
      }
    ],
    "status_keys": [
      "record",
      "editing",
      "form",
      "loading"
    ],
    "ui": {
      "sections": [],
      "template": {
        "detail": "object_page"
      }
    },
    "version": 1
  }
}