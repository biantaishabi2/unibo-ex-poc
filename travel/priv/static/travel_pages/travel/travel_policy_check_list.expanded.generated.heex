<.page title="TravelPolicyCheck 列表" id="travel_policy_check_list">
  <.section direction="row" justify="between" align="center" layout="grid" columns={2} id="travel_policy_check_header">
    <.text variant="title" id="travel_policy_check_title">
      <%= @page_title %>
    </.text>
    <.button variant="primary" phx-click="navigate_create" size="md" id="travel_policy_check_create_btn">
      新建
    </.button>
  </.section>
  <.card variant="default" id="travel_policy_check_filter_card">
    <.card_content id="travel_policy_check_filter_content">
      <.flex gap={4} align="center" direction="row" id="travel_policy_check_filter_row">
        <.select name="check_result" label="校验结果" size="md" id="filter_check_result">

        </.select>
        <.select name="approval_mode" label="命中政策时的审批模式快照" size="md" id="filter_approval_mode">

        </.select>
        <.button variant="secondary" phx-click="filter_submit" size="md" id="travel_policy_check_filter_submit">
          查询
        </.button>
      </.flex>
    </.card_content>
  </.card>
  <.table id="travel_policy_check_table">
    <.table_header id="travel_policy_check_table_header">
      <.table_row id="travel_policy_check_header_row">
        <.table_head id="th_check_result">
          校验结果
        </.table_head>
        <.table_head id="th_policy_amount">
          差标金额（单位分）
        </.table_head>
        <.table_head id="th_actual_amount">
          实际金额（单位分）
        </.table_head>
        <.table_head id="th_exceed_amount">
          超标金额
        </.table_head>
        <.table_head id="th_exceed_ratio">
          超标比例（如'15%'）
        </.table_head>
        <.table_head id="th_exceed_strategy">
          命中的超标策略
        </.table_head>
        <.table_head id="th_exceed_reason">
          超标原因（员工填写）
        </.table_head>
        <.table_head id="th_personal_pay_amount">
          个人支付部分
        </.table_head>
        <.table_head id="th_approval_mode">
          命中政策时的审批模式快照
        </.table_head>
        <.table_head id="travel_policy_check_th_actions">
          操作
        </.table_head>
      </.table_row>
    </.table_header>
    <.table_body id="travel_policy_check_table_body">
      <%= for row <- (@rows || []) do %>
        <.table_row>
          <.table_cell>
            <.badge variant="default" size="sm">
              <%= get_in(row, [:check_result]) || "" %>
            </.badge>
          </.table_cell>
          <.table_cell>
            <%= get_in(row, [:policy_amount]) || "" %>
          </.table_cell>
          <.table_cell>
            <%= get_in(row, [:actual_amount]) || "" %>
          </.table_cell>
          <.table_cell>
            <%= get_in(row, [:exceed_amount]) || "" %>
          </.table_cell>
          <.table_cell>
            <%= get_in(row, [:exceed_ratio]) || "" %>
          </.table_cell>
          <.table_cell>
            <%= get_in(row, [:exceed_strategy]) || "" %>
          </.table_cell>
          <.table_cell>
            <%= get_in(row, [:exceed_reason]) || "" %>
          </.table_cell>
          <.table_cell>
            <%= get_in(row, [:personal_pay_amount]) || "" %>
          </.table_cell>
          <.table_cell>
            <.badge variant="default" size="sm">
              <%= get_in(row, [:approval_mode]) || "" %>
            </.badge>
          </.table_cell>
          <.table_cell>
            <.link patch={"/pages/travel/travel_policy_check/#{get_in(row, [:id])}"} id="travel_policy_check_view_btn" variant="link" size="sm">
              查看
            </.link>
          </.table_cell>
        </.table_row>
      <% end %>
    </.table_body>
  </.table>
  <%= if (@rows_empty && @rows_empty != []) do %>
    <.empty_state description="暂无差标校验记录,记录订单下单时针对差旅政策的校验结果、超标金额与处理策略数据" id="travel_policy_check_no_data" />
  <% end %>
</.page>