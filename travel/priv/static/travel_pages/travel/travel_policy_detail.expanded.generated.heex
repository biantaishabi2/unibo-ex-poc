<.page title="TravelPolicy 详情" id="travel_policy_detail">
  <.breadcrumb id="travel_policy_breadcrumb">
    <.breadcrumb_list id="travel_policy_bc_list">
      <.breadcrumb_item id="travel_policy_bc_list_item">
        <.breadcrumb_link id="travel_policy_bc_link">
          TravelPolicy 列表
        </.breadcrumb_link>
      </.breadcrumb_item>
      <.breadcrumb_separator id="travel_policy_bc_sep" />
      <.breadcrumb_item id="travel_policy_bc_current_item">
        <.breadcrumb_page id="travel_policy_bc_current">
          <%= get_in(@record, [:policy_name]) || "详情" %>
        </.breadcrumb_page>
      </.breadcrumb_item>
    </.breadcrumb_list>
  </.breadcrumb>
  <.section direction="row" justify="between" align="center" layout="grid" columns={2} id="travel_policy_detail_header">
    <.flex gap={3} align="center" direction="row" id="travel_policy_title_group">
      <.text variant="title" id="travel_policy_detail_title">
        <%= get_in(@record, [:policy_name]) || "" %>
      </.text>
    </.flex>
    <.flex gap={2} direction="row" id="travel_policy_actions">
      <.button variant="secondary" phx-click="toggle_edit" size="md" id="travel_policy_edit_btn">
        编辑
      </.button>
      <.button variant="secondary" phx-click="action_activate" size="md" id="travel_policy_action_activate">
        activate
      </.button>
      <.button variant="secondary" phx-click="action_deactivate" size="md" id="travel_policy_action_deactivate">
        deactivate
      </.button>
    </.flex>
  </.section>
  <.card variant="default" id="travel_policy_info_card">
    <.card_header id="travel_policy_info_header">
      <.card_title id="travel_policy_info_title">
        基本信息
      </.card_title>
    </.card_header>
    <.card_content id="travel_policy_info_content">
      <%= if !(@editing && @editing != []) do %>
        <.grid columns={2} gap={4} id="travel_policy_info_grid">
          <.flex direction="row" id="field_policy_name">
            <.text variant="muted" id="label_policy_name">
              政策名称,如'总部差旅标准'
            </.text>
            <.text id="value_policy_name">
              <%= get_in(@record, [:policy_name]) || "" %>
            </.text>
          </.flex>
          <.flex direction="row" id="field_product_type">
            <.text variant="muted" id="label_product_type">
              适用商品类型
            </.text>
            <.badge variant="default" size="sm" id="value_product_type">
              <%= get_in(@record, [:product_type]) || "" %>
            </.badge>
          </.flex>
          <.flex direction="row" id="field_employee_level">
            <.text variant="muted" id="label_employee_level">
              职级标识
            </.text>
            <.text id="value_employee_level">
              <%= get_in(@record, [:employee_level]) || "" %>
            </.text>
          </.flex>
          <.flex direction="row" id="field_city_tier">
            <.text variant="muted" id="label_city_tier">
              城市等级（tier_1/tier_2/tier_3）
            </.text>
            <.text id="value_city_tier">
              <%= get_in(@record, [:city_tier]) || "" %>
            </.text>
          </.flex>
          <.flex direction="row" id="field_season">
            <.text variant="muted" id="label_season">
              淡旺季标识（可选）
            </.text>
            <.text id="value_season">
              <%= get_in(@record, [:season]) || "" %>
            </.text>
          </.flex>
          <.flex direction="row" id="field_max_amount">
            <.text variant="muted" id="label_max_amount">
              金额上限（单位分）
            </.text>
            <.text id="value_max_amount">
              <%= get_in(@record, [:max_amount]) || "" %>
            </.text>
          </.flex>
          <.flex direction="row" id="field_cabin_class_limit">
            <.text variant="muted" id="label_cabin_class_limit">
              舱位限制
            </.text>
            <.text id="value_cabin_class_limit">
              <%= get_in(@record, [:cabin_class_limit]) || "" %>
            </.text>
          </.flex>
          <.flex direction="row" id="field_hotel_star_limit">
            <.text variant="muted" id="label_hotel_star_limit">
              酒店星级限制
            </.text>
            <.text id="value_hotel_star_limit">
              <%= get_in(@record, [:hotel_star_limit]) || "" %>
            </.text>
          </.flex>
          <.flex direction="row" id="field_exceed_strategy">
            <.text variant="muted" id="label_exceed_strategy">
              超标处理策略
            </.text>
            <.badge variant="default" size="sm" id="value_exceed_strategy">
              <%= get_in(@record, [:exceed_strategy]) || "" %>
            </.badge>
          </.flex>
          <.flex direction="row" id="field_approval_mode">
            <.text variant="muted" id="label_approval_mode">
              审批模式;none 表示关闭审批,self/oa 表示进入对应审批流
            </.text>
            <.badge variant="default" size="sm" id="value_approval_mode">
              <%= get_in(@record, [:approval_mode]) || "" %>
            </.badge>
          </.flex>
          <.flex direction="row" id="field_personal_pay_ratio">
            <.text variant="muted" id="label_personal_pay_ratio">
              个人支付比例 0-100
            </.text>
            <.text id="value_personal_pay_ratio">
              <%= get_in(@record, [:personal_pay_ratio]) || "" %>
            </.text>
          </.flex>
          <.flex direction="row" id="field_is_active">
            <.text variant="muted" id="label_is_active">
              是否启用
            </.text>
            <.badge variant="default" size="sm" id="value_is_active">
              <%= get_in(@record, [:is_active]) || "" %>
            </.badge>
          </.flex>
        </.grid>
      <% else %>
        <.form phx-submit="form_submit" phx-change="form_change" id="travel_policy_edit_form">
          <.grid columns={2} gap={4} id="travel_policy_form_grid">
            <.input name="policy_name" label="政策名称,如'总部差旅标准'" placeholder="请输入政策名称,如'总部差旅标准'" required="true" size="md" id="form_policy_name" value={@record.policy_name} />
            <.select name="product_type" label="适用商品类型" required="true" size="md" id="form_product_type" value={@record.product_type}>

            </.select>
            <.input name="employee_level" label="职级标识" placeholder="请输入职级标识" size="md" id="form_employee_level" value={@record.employee_level} />
            <.input name="city_tier" label="城市等级（tier_1/tier_2/tier_3）" placeholder="请输入城市等级（tier_1/tier_2/tier_3）" size="md" id="form_city_tier" value={@record.city_tier} />
            <.input name="season" label="淡旺季标识（可选）" placeholder="请输入淡旺季标识（可选）" size="md" id="form_season" value={@record.season} />
            <.input name="max_amount" label="金额上限（单位分）" placeholder="请输入金额上限（单位分）" size="md" id="form_max_amount" value={@record.max_amount} />
            <.input name="cabin_class_limit" label="舱位限制" placeholder="请输入舱位限制" size="md" id="form_cabin_class_limit" value={@record.cabin_class_limit} />
            <.input name="hotel_star_limit" label="酒店星级限制" placeholder="请输入酒店星级限制" size="md" id="form_hotel_star_limit" value={@record.hotel_star_limit} />
            <.select name="exceed_strategy" label="超标处理策略" required="true" size="md" id="form_exceed_strategy" value={@record.exceed_strategy}>

            </.select>
            <.select name="approval_mode" label="审批模式;none 表示关闭审批,self/oa 表示进入对应审批流" size="md" id="form_approval_mode" value={@record.approval_mode}>

            </.select>
            <.input name="personal_pay_ratio" label="个人支付比例 0-100" placeholder="请输入个人支付比例 0-100" size="md" id="form_personal_pay_ratio" value={@record.personal_pay_ratio} />
            <.switch name="is_active" label="是否启用" size="md" id="form_is_active" value={@record.is_active} />
            <.input name="enterprise_id" label="企业标识（不做跨域外键）" placeholder="请输入企业标识（不做跨域外键）" size="md" id="form_enterprise_id" value={@record.enterprise_id} />
          </.grid>
          <.flex justify="end" gap={2} direction="row" id="travel_policy_form_actions">
            <.button variant="secondary" phx-click="cancel_edit" size="md" id="travel_policy_cancel_btn">
              取消
            </.button>
            <.button variant="primary" phx-click="form_submit" size="md" id="travel_policy_save_btn">
              保存
            </.button>
          </.flex>
        </.form>
      <% end %>
    </.card_content>
  </.card>
</.page>