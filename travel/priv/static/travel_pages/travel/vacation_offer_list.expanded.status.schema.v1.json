    "page_type": "list_report",
    "runtime_monitoring": null,
    "schema_version": "1.0",
    "state_transitions": [
      {
        "description": "筛选条件变更",
        "from": "*",
        "name": "filter_change",
        "to": "*",
        "trigger": "user_input"
      },
      {
        "description": "提交筛选查询",
        "from": "*",
        "name": "filter_submit",
        "to": "loading",
        "trigger": "user_action"
      },
      {
        "description": "点击行跳转详情",
        "from": "*",
        "name": "row_click",
        "navigate_to": "/travel/vacation_offer/{id}",
        "to": "*",
        "trigger": "user_action"
      },
      {
        "description": "跳转新建页",
        "from": "*",
        "name": "navigate_create",
        "navigate_to": "/travel/vacation_offer/new",
        "to": "*",
        "trigger": "user_action"
      }
    ],
