<.page title="定价规则配置" id="pricing_rule">
  <.section layout="none" id="toolbar_section">
    <.flex justify="between" align="center" direction="row" id="toolbar">
      <.text variant="h3" weight="bold" id="page_title">
        定价规则配置
      </.text>
      <.button variant="primary" phx-click="open_dialog:create_dialog" size="md" id="create_btn">
        新建规则
      </.button>
    </.flex>
  </.section>
  <.section layout="none" id="rule_table_section">
    <.card variant="default" id="rule_table_card">
      <.card_content id="rule_table_content">
        <.stack gap={0} direction="column" id="rule_list">
          <.flex justify="between" align="center" direction="row" id="table_header">
            <.text variant="caption" weight="bold" id="col_product_type">
              产品类型
            </.text>
            <.text variant="caption" weight="bold" id="col_supplier">
              供应商编码
            </.text>
            <.text variant="caption" weight="bold" id="col_markup">
              加价率
            </.text>
            <.text variant="caption" weight="bold" id="col_status">
              状态
            </.text>
            <.text variant="caption" weight="bold" id="col_actions">
              操作
            </.text>
          </.flex>
          <.separator id="table_sep" />
          <%= for item <- (@pricing_rules || []) do %>
            <.flex justify="between" align="center" direction="row" id="rule_row">
              <%= if (val = get_in(item, [:product_type])) && to_string(val) != "" do %>
                <.badge variant="secondary" size="sm" id="product_type_badge">
                  <%= to_string(val) %>
                </.badge>
              <% end %>
              <.text id="supplier_code">
                <%= get_in(item, [:supplier_code]) |> then(fn v when is_binary(v) and v != "" -> v; _ -> "" end) %>
              </.text>
              <.text id="markup_rate">
                <%= get_in(item, [:markup_rate]) |> then(fn v when is_binary(v) and v != "" -> v; _ -> "" end) %>
              </.text>
              <%= if (val = get_in(item, [:status])) && to_string(val) != "" do %>
                <.badge variant="outline" size="sm" id="status_badge">
                  <%= to_string(val) %>
                </.badge>
              <% end %>
              <.flex gap={1} direction="row" id="row_actions">
                <.button variant="outline" size="sm" phx-click="update" id="save_btn">
                  保存
                </.button>
                <.button variant="destructive" size="sm" phx-click="destroy" id="delete_btn">
                  删除
                </.button>
              </.flex>
            </.flex>
          <% end %>
        </.stack>
      </.card_content>
    </.card>
  </.section>
  <.section layout="none" id="dialog_section">
    <.dialog title="新建规则" id="create_dialog">
      <.stack gap={3} direction="column" id="create_form">
        <.select size="md" name="travel_order[product_type]" id="product_type_select" :let={builder}>
          <.select_trigger builder={builder} />
          <.select_content builder={builder}>
            <.select_group>
              <.select_item builder={builder} value="hotel" label="hotel">hotel</.select_item>
              <.select_item builder={builder} value="flight" label="flight">flight</.select_item>
              <.select_item builder={builder} value="vacation" label="vacation">vacation</.select_item>
              <.select_item builder={builder} value="" label="酒店:hotel,机票:flight,火车票:train">酒店:hotel,机票:flight,火车票:train</.select_item>
            </.select_group>
          </.select_content>
        </.select>
        <.input label="供应商编码" placeholder="请输入供应商编码" required="true" size="md" name="form[supplier_code]" id="supplier_code_input" />
        <.input label="加价率" placeholder="例如 0.15 表示加价 15%" type="number" required="true" size="md" name="form[markup_rate]" id="markup_rate_input" />
        <.select size="md" name="travel_order[status]" id="status_select" :let={builder}>
          <.select_trigger builder={builder} />
          <.select_content builder={builder}>
            <.select_group>
              <.select_item builder={builder} value="draft" label="draft">draft</.select_item>
              <.select_item builder={builder} value="quoted" label="quoted">quoted</.select_item>
              <.select_item builder={builder} value="submitted" label="submitted">submitted</.select_item>
              <.select_item builder={builder} value="booking_pending" label="booking_pending">booking_pending</.select_item>
              <.select_item builder={builder} value="booked" label="booked">booked</.select_item>
              <.select_item builder={builder} value="cancel_pending" label="cancel_pending">cancel_pending</.select_item>
              <.select_item builder={builder} value="cancelled" label="cancelled">cancelled</.select_item>
              <.select_item builder={builder} value="completed" label="completed">completed</.select_item>
              <.select_item builder={builder} value="" label="启用:active,停用:inactive">启用:active,停用:inactive</.select_item>
            </.select_group>
          </.select_content>
        </.select>
        <.button variant="primary" phx-click="create" size="md" id="submit_create_btn">
          创建
        </.button>
      </.stack>
    </.dialog>
  </.section>
</.page>