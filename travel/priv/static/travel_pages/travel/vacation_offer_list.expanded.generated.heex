<.page title="VacationOffer 列表" id="vacation_offer_list">
  <.section direction="row" justify="between" align="center" layout="grid" columns={2} id="vacation_offer_header">
    <.text variant="title" id="vacation_offer_title">
      <%= @page_title %>
    </.text>
    <.button variant="primary" phx-click="navigate_create" size="md" id="vacation_offer_create_btn">
      新建
    </.button>
  </.section>
  <.card variant="default" id="vacation_offer_filter_card">
    <.card_content id="vacation_offer_filter_content">
      <.flex gap={4} align="center" direction="row" id="vacation_offer_filter_row">
        <.select name="package_type" label="套餐类型" size="md" id="filter_package_type">

        </.select>
        <.input name="start_date_from" label="出行开始日期 起" size="md" id="filter_start_date_from" />
        <.input name="start_date_to" label="出行开始日期 止" size="md" id="filter_start_date_to" />
        <.input name="end_date_from" label="出行结束日期 起" size="md" id="filter_end_date_from" />
        <.input name="end_date_to" label="出行结束日期 止" size="md" id="filter_end_date_to" />
        <.select name="sale_status" label="sale_status" size="md" id="filter_sale_status">

        </.select>
        <.button variant="secondary" phx-click="filter_submit" size="md" id="vacation_offer_filter_submit">
          查询
        </.button>
      </.flex>
    </.card_content>
  </.card>
  <.table id="vacation_offer_table">
    <.table_header id="vacation_offer_table_header">
      <.table_row id="vacation_offer_header_row">
        <.table_head id="th_supplier_code">
          供应商编码
        </.table_head>
        <.table_head id="th_package_code">
          套餐编码
        </.table_head>
        <.table_head id="th_package_name">
          套餐名称
        </.table_head>
        <.table_head id="th_package_type">
          套餐类型
        </.table_head>
        <.table_head id="th_departure_city_code">
          出发城市编码
        </.table_head>
        <.table_head id="th_destination_code">
          目的地编码
        </.table_head>
        <.table_head id="th_start_date">
          出行开始日期
        </.table_head>
        <.table_head id="th_end_date">
          出行结束日期
        </.table_head>
        <.table_head id="th_listed_price">
          对客展示价快照
        </.table_head>
        <.table_head id="th_settlement_price">
          结算价快照
        </.table_head>
        <.table_head id="th_currency">
          currency
        </.table_head>
        <.table_head id="th_inventory_count">
          可售库存快照
        </.table_head>
        <.table_head id="th_booking_rules">
          预订规则快照
        </.table_head>
        <.table_head id="th_cancellation_policy">
          取消规则快照
        </.table_head>
        <.table_head id="th_sale_status">
          sale_status
        </.table_head>
        <.table_head id="vacation_offer_th_actions">
          操作
        </.table_head>
      </.table_row>
    </.table_header>
    <.table_body id="vacation_offer_table_body">
      <%= for row <- (@rows || []) do %>
        <.table_row>
          <.table_cell>
            <%= get_in(row, [:supplier_code]) || "" %>
          </.table_cell>
          <.table_cell>
            <%= get_in(row, [:package_code]) || "" %>
          </.table_cell>
          <.table_cell>
            <%= get_in(row, [:package_name]) || "" %>
          </.table_cell>
          <.table_cell>
            <%= if (val = get_in(row, [:package_type])) && to_string(val) != "" do %>
              <.badge variant="default" size="sm">
                <%= to_string(val) %>
              </.badge>
            <% end %>
          </.table_cell>
          <.table_cell>
            <%= get_in(row, [:departure_city_code]) || "" %>
          </.table_cell>
          <.table_cell>
            <%= get_in(row, [:destination_code]) || "" %>
          </.table_cell>
          <.table_cell>
            <%= get_in(row, [:start_date]) || "" %>
          </.table_cell>
          <.table_cell>
            <%= get_in(row, [:end_date]) || "" %>
          </.table_cell>
          <.table_cell>
            <%= get_in(row, [:listed_price]) || "" %>
          </.table_cell>
          <.table_cell>
            <%= get_in(row, [:settlement_price]) || "" %>
          </.table_cell>
          <.table_cell>
            <%= get_in(row, [:currency]) || "" %>
          </.table_cell>
          <.table_cell>
            <%= get_in(row, [:inventory_count]) || "" %>
          </.table_cell>
          <.table_cell>
            <%= get_in(row, [:booking_rules]) || "" %>
          </.table_cell>
          <.table_cell>
            <%= get_in(row, [:cancellation_policy]) || "" %>
          </.table_cell>
          <.table_cell>
            <%= if (val = get_in(row, [:sale_status])) && to_string(val) != "" do %>
              <.badge variant="default" size="sm">
                <%= to_string(val) %>
              </.badge>
            <% end %>
          </.table_cell>
          <.table_cell>
            <.link patch={"/pages/travel/vacation_offer/#{get_in(row, [:id])}"} id="vacation_offer_view_btn" variant="link" size="sm">
              查看
            </.link>
          </.table_cell>
        </.table_row>
      <% end %>
    </.table_body>
  </.table>
  <%= if (@rows_empty && @rows_empty != []) do %>
    <.empty_state description="暂无度假可售 offer,承载套餐、出发日期和预订规则快照数据" id="vacation_offer_no_data" />
  <% end %>
</.page>