<.page title="搜索结果" id="flight_search_results">
  <.section layout="none" id="header_section">
    <.flex class="items-center gap-2 p-3">
      <.button variant="ghost" size="sm" phx-click="go_back">← 返回</.button>
      <.text variant="h4" class="flex-1">搜索</.text>
    </.flex>
  </.section>
  <.section layout="none" id="date_slider_section">
    <.flex gap={2} paddingx={3} paddingy={2} overflowx="scroll" background="surface" direction="row" id="date_slider">
      <%= for date_item <- @search.date_range do %>
        <.badge variant={date_item.is_selected} phx-click="select_date" size="sm">
          <%= date_item.date_label %>
        </.badge>
      <% end %>
    </.flex>
  </.section>
  <.section layout="none" id="filter_section">
    <.flex gap={2} paddingx={3} paddingy={2} wrap={true} direction="row" id="filter_bar" />
  </.section>
  <.section layout="none" id="alert_section">
    <%= if @policy.exceeded == true do %>
      <.alert variant="warning" title="超标提示" id="policy_alert">
        标记超标的项目超出差旅标准,预订需审批
      </.alert>
    <% end %>
  </.section>
  <.section layout="none" id="results_section">
    <.stack gap={3} padding={3} direction="column" id="results_list">
      <%= for item <- @flights.items do %>
        <.card id={"flight_card_#{item.id}"}>
          <.card_header>
            <.flex gap={2} align="center" direction="row">
              <.text variant="caption" color="muted"><%= item.airline_name %></.text>
              <.text variant="caption" color="muted"><%= item.flight_no %></.text>
              <%= if item.is_policy_exceeded do %>
                <.badge variant="destructive" size="sm">超标</.badge>
              <% end %>
            </.flex>
          </.card_header>
          <.card_content>
            <.flex justify="between" align="center" direction="row">
              <.stack gap={0} align="center" direction="column">
                <.text variant="h3" weight="bold"><%= item.departure_time %></.text>
                <.text variant="caption" color="muted"><%= item.departure_city %></.text>
              </.stack>
              <.stack gap={0} align="center" direction="column">
                <.text variant="caption" color="muted"><%= item.duration %></.text>
                <.separator />
                <.text variant="caption" color="muted"><%= item.stop_label %></.text>
              </.stack>
              <.stack gap={0} align="center" direction="column">
                <.text variant="h3" weight="bold"><%= item.arrival_time %></.text>
                <.text variant="caption" color="muted"><%= item.arrival_city %></.text>
              </.stack>
            </.flex>
          </.card_content>
          <.card_footer>
            <.flex justify="between" align="center" direction="row">
              <.flex gap={1} wrap={true} direction="row">
                <.badge variant="outline" size="sm"><%= item.cabin_class %></.badge>
                <.badge variant="outline" size="sm"><%= item.aircraft_type %></.badge>
              </.flex>
              <.text variant="h3" color="primary">¥ <%= item.listed_price %></.text>
            </.flex>
          </.card_footer>
        </.card>
      <% end %>
    </.stack>
  </.section>
  <.section layout="none" id="empty_section">
    <%= if @results.total_count == 0 do %>
      <.empty_state title="未找到结果" description="请调整搜索条件后重试" id="no_results" />
    <% end %>
  </.section>
  <.section layout="none" id="sort_bar_section">
    <.control_bar position="sticky_bottom" id="bottom_sort_bar">
      <.flex gap={3} justify="spacearound" width="full" direction="row" id="sort_buttons" />
    </.control_bar>
  </.section>
  <.separator id="sep_after_date" />
</.page>