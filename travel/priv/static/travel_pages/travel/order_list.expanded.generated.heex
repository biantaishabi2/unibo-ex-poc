<.page title="我的行程" id="order_list">
  <.section layout="none" id="filter_section">
    <.tabs default="all" id="product_type_tabs">
      <.tabs_list id="type_tab_list">
        <.tabs_trigger value="all" id="trigger_all">
          全部
        </.tabs_trigger>
        <.tabs_trigger value="flight" id="trigger_flight">
          机票
        </.tabs_trigger>
        <.tabs_trigger value="hotel" id="trigger_hotel">
          酒店
        </.tabs_trigger>
        <.tabs_trigger value="train" id="trigger_train">
          火车
        </.tabs_trigger>
      </.tabs_list>
    </.tabs>
  </.section>
  <.section layout="none" id="order_list_section">
    <.stack gap={2} direction="column" id="orders_stack">
      <%= for item <- @orders do %>
        <.card phx-click="navigate:/travel/orders/{{item.id|}}" variant="default">
          <.card_header>
            <.flex justify="between" align="center" direction="row">
              <.flex gap={2} align="center" direction="row">
                <.badge variant="secondary" size="sm">
                  <%= item.product_type %>
                </.badge>
              </.flex>
              <.badge variant="outline" size="sm">
                <%= item.status %>
              </.badge>
            </.flex>
          </.card_header>
          <.card_content>
            <.stack gap={2} direction="column">
              <.text variant="body" weight="bold">
                <%= item.summary %>
              </.text>
              <.text variant="caption" color="muted">
                <%= item.order_no %>
              </.text>
              <.flex gap={1} direction="row">
                <.badge variant="secondary" size="sm">
                  企业支付
                </.badge>
                <%= if (item.has_travel_purpose && item.has_travel_purpose != []) do %>
                  <.badge variant="secondary" size="sm">
                    <%= item.travel_purpose %>
                  </.badge>
                <% end %>
                <%= if (item.has_change && item.has_change != []) do %>
                  <.badge variant="destructive" size="sm">
                    退
                  </.badge>
                <% end %>
              </.flex>
            </.stack>
          </.card_content>
          <.card_footer>
            <.flex justify="between" align="center" direction="row">
              <.text variant="h3">
                <%= item.total_amount %>
              </.text>
            </.flex>
          </.card_footer>
        </.card>
      <% end %>
    </.stack>
  </.section>
  <.section layout="none" id="empty_section">
    <%= if (@orders_empty && @orders_empty != []) do %>
      <.empty_state title="暂无行程订单" description="您还没有预订任何行程" id="no_orders" />
    <% end %>
  </.section>
</.page>