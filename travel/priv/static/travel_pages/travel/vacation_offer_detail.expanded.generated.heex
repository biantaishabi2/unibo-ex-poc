<.page title="详情" id="vacation_offer_detail">
  <.section layout="none" id="breadcrumb_section">
    <.breadcrumb id="page_breadcrumb">
      <.breadcrumb_list id="bc_list">
        <.breadcrumb_item id="bc_list_item">
          <.breadcrumb_link id="bc_link">
            列表
          </.breadcrumb_link>
        </.breadcrumb_item>
        <.breadcrumb_separator id="bc_sep" />
        <.breadcrumb_item id="bc_current_item">
          <.breadcrumb_page id="bc_current">
            详情
          </.breadcrumb_page>
        </.breadcrumb_item>
      </.breadcrumb_list>
    </.breadcrumb>
  </.section>
  <.section direction="row" justify="between" align="center" layout="grid" columns={2} id="detail_header">
    <.flex gap={3} align="center" direction="row" id="title_group">
      <.stack direction="column" id="title_meta">
        <.text variant="caption" color="muted" id="breadcrumb">
          VacationOffer
        </.text>
        <.text variant="h1" id="page_title">
          度假可售 offer,承载套餐、出发日期和预订规则快照
        </.text>
      </.stack>
      <.badge bind="vacation_offer.status" variant="default" size="sm" id="status_badge" />
    </.flex>
    <.flex gap={2} direction="row" id="actions_group">
      <.button variant="secondary" phx-click="toggle_edit" size="md" id="edit_btn">
        编辑
      </.button>
      <%= if get_in(@record, [:sale_status]) == "draft" || get_in(@record, [:sale_status]) == "inactive" do %>
        <.button variant="secondary" phx-click="action_activate" size="md" id="vacation_offer_action_activate">
          activate
        </.button>
      <% end %>
      <%= if get_in(@record, [:sale_status]) == "active" do %>
        <.button variant="secondary" phx-click="action_deactivate" size="md" id="vacation_offer_action_deactivate">
          deactivate
        </.button>
      <% end %>
      <%= if get_in(@record, [:sale_status]) == "active" do %>
        <.button variant="secondary" phx-click="action_expire" size="md" id="vacation_offer_action_expire">
          expire
        </.button>
      <% end %>
      <.button variant="danger" phx-click="action_destroy" size="md" id="delete_btn">
        删除
      </.button>
    </.flex>
  </.section>
  <.section layout="none" id="info_section">
    <.card variant="default" id="info_card">
      <.card_header id="info_header">
        <.card_title id="info_title">
          基本信息
        </.card_title>
      </.card_header>
      <.card_content id="info_content">
        <%= if !(@editing && @editing != []) do %>
          <.grid columns={2} gap={4} id="info_grid">
            <.grid columns={2} gap={3} id="detail_fields">
              <.stack gap={0} direction="column" id="detail_fields_supplier_code">
                <.text variant="caption" color="muted" id="detail_fields_supplier_code_label">
                  供应商编码
                </.text>
                <.text id="detail_fields_supplier_code_value">
                  <%= get_in(@vacation_offer, [:supplier_code]) |> then(fn v when is_binary(v) and v != "" -> v; _ -> "" end) %>
                </.text>
              </.stack>
              <.stack gap={0} direction="column" id="detail_fields_package_code">
                <.text variant="caption" color="muted" id="detail_fields_package_code_label">
                  套餐编码
                </.text>
                <.text id="detail_fields_package_code_value">
                  <%= get_in(@vacation_offer, [:package_code]) |> then(fn v when is_binary(v) and v != "" -> v; _ -> "" end) %>
                </.text>
              </.stack>
              <.stack gap={0} direction="column" id="detail_fields_package_name">
                <.text variant="caption" color="muted" id="detail_fields_package_name_label">
                  套餐名称
                </.text>
                <.text id="detail_fields_package_name_value">
                  <%= get_in(@vacation_offer, [:package_name]) |> then(fn v when is_binary(v) and v != "" -> v; _ -> "" end) %>
                </.text>
              </.stack>
              <.stack gap={0} direction="column" id="detail_fields_package_type">
                <.text variant="caption" color="muted" id="detail_fields_package_type_label">
                  套餐类型
                </.text>
                <.text id="detail_fields_package_type_value">
                  <%= get_in(@vacation_offer, [:package_type]) |> then(fn v when is_binary(v) and v != "" -> v; _ -> "" end) %>
                </.text>
              </.stack>
              <.stack gap={0} direction="column" id="detail_fields_departure_city_code">
                <.text variant="caption" color="muted" id="detail_fields_departure_city_code_label">
                  出发城市编码
                </.text>
                <.text id="detail_fields_departure_city_code_value">
                  <%= get_in(@vacation_offer, [:departure_city_code]) |> then(fn v when is_binary(v) and v != "" -> v; _ -> "" end) %>
                </.text>
              </.stack>
              <.stack gap={0} direction="column" id="detail_fields_destination_code">
                <.text variant="caption" color="muted" id="detail_fields_destination_code_label">
                  目的地编码
                </.text>
                <.text id="detail_fields_destination_code_value">
                  <%= get_in(@vacation_offer, [:destination_code]) |> then(fn v when is_binary(v) and v != "" -> v; _ -> "" end) %>
                </.text>
              </.stack>
              <.stack gap={0} direction="column" id="detail_fields_start_date">
                <.text variant="caption" color="muted" id="detail_fields_start_date_label">
                  出行开始日期
                </.text>
                <.text id="detail_fields_start_date_value">
                  <%= get_in(@vacation_offer, [:start_date]) |> then(fn v when is_binary(v) and v != "" -> v; _ -> "" end) %>
                </.text>
              </.stack>
              <.stack gap={0} direction="column" id="detail_fields_end_date">
                <.text variant="caption" color="muted" id="detail_fields_end_date_label">
                  出行结束日期
                </.text>
                <.text id="detail_fields_end_date_value">
                  <%= get_in(@vacation_offer, [:end_date]) |> then(fn v when is_binary(v) and v != "" -> v; _ -> "" end) %>
                </.text>
              </.stack>
              <.stack gap={0} direction="column" id="detail_fields_listed_price">
                <.text variant="caption" color="muted" id="detail_fields_listed_price_label">
                  对客展示价快照
                </.text>
                <.text id="detail_fields_listed_price_value">
                  <%= get_in(@vacation_offer, [:listed_price]) |> then(fn v when is_binary(v) and v != "" -> v; _ -> "" end) %>
                </.text>
              </.stack>
              <.stack gap={0} direction="column" id="detail_fields_settlement_price">
                <.text variant="caption" color="muted" id="detail_fields_settlement_price_label">
                  结算价快照
                </.text>
                <.text id="detail_fields_settlement_price_value">
                  <%= get_in(@vacation_offer, [:settlement_price]) |> then(fn v when is_binary(v) and v != "" -> v; _ -> "" end) %>
                </.text>
              </.stack>
              <.stack gap={0} direction="column" id="detail_fields_currency">
                <.text variant="caption" color="muted" id="detail_fields_currency_label">
                  currency
                </.text>
                <.text id="detail_fields_currency_value">
                  <%= get_in(@vacation_offer, [:currency]) |> then(fn v when is_binary(v) and v != "" -> v; _ -> "" end) %>
                </.text>
              </.stack>
              <.stack gap={0} direction="column" id="detail_fields_inventory_count">
                <.text variant="caption" color="muted" id="detail_fields_inventory_count_label">
                  可售库存快照
                </.text>
                <.text id="detail_fields_inventory_count_value">
                  <%= get_in(@vacation_offer, [:inventory_count]) |> then(fn v when is_binary(v) and v != "" -> v; _ -> "" end) %>
                </.text>
              </.stack>
              <.stack gap={0} direction="column" id="detail_fields_booking_rules">
                <.text variant="caption" color="muted" id="detail_fields_booking_rules_label">
                  预订规则快照
                </.text>
                <.text id="detail_fields_booking_rules_value">
                  <%= get_in(@vacation_offer, [:booking_rules]) |> then(fn v when is_binary(v) and v != "" -> v; _ -> "" end) %>
                </.text>
              </.stack>
              <.stack gap={0} direction="column" id="detail_fields_cancellation_policy">
                <.text variant="caption" color="muted" id="detail_fields_cancellation_policy_label">
                  取消规则快照
                </.text>
                <.text id="detail_fields_cancellation_policy_value">
                  <%= get_in(@vacation_offer, [:cancellation_policy]) |> then(fn v when is_binary(v) and v != "" -> v; _ -> "" end) %>
                </.text>
              </.stack>
              <.stack gap={0} direction="column" id="detail_fields_sale_status">
                <.text variant="caption" color="muted" id="detail_fields_sale_status_label">
                  sale_status
                </.text>
                <.text id="detail_fields_sale_status_value">
                  <%= get_in(@vacation_offer, [:sale_status]) |> then(fn v when is_binary(v) and v != "" -> v; _ -> "" end) %>
                </.text>
              </.stack>
            </.grid>
          </.grid>
        <% else %>
          <.form for={%{}} phx-submit="form_submit" phx-change="form_change" id="vacation_offer_edit_form">
            <.grid columns={2} gap={4} id="form_grid">
              <.stack direction="column" id="form_fields">
                <.input size="md" name="vacation_offer[tenant_id]" id="vacation_offer_form_tenant_id" value={get_in(@vacation_offer, [:tenant_id]) || ""} />
                <.input size="md" name="vacation_offer[host_shop_id]" id="vacation_offer_form_host_shop_id" value={get_in(@vacation_offer, [:host_shop_id]) || ""} />
                <.input size="md" name="vacation_offer[supplier_code]" id="vacation_offer_form_supplier_code" value={get_in(@vacation_offer, [:supplier_code]) || ""} />
                <.input size="md" name="vacation_offer[package_code]" id="vacation_offer_form_package_code" value={get_in(@vacation_offer, [:package_code]) || ""} />
                <.input size="md" name="vacation_offer[package_name]" id="vacation_offer_form_package_name" value={get_in(@vacation_offer, [:package_name]) || ""} />
                <.select size="md" name="vacation_offer[package_type]" id="vacation_offer_form_package_type" :let={builder} value={get_in(@vacation_offer, [:package_type]) || ""}>
                  <.select_trigger builder={builder} />
                  <.select_content builder={builder}>
                    <.select_group>
                      <.select_item builder={builder} value="group_tour" label="group_tour">group_tour</.select_item>
                      <.select_item builder={builder} value="free_travel" label="free_travel">free_travel</.select_item>
                      <.select_item builder={builder} value="ticket_hotel" label="ticket_hotel">ticket_hotel</.select_item>
                      <.select_item builder={builder} value="custom" label="custom">custom</.select_item>
                    </.select_group>
                  </.select_content>
                </.select>
                <.input size="md" name="vacation_offer[departure_city_code]" id="vacation_offer_form_departure_city_code" value={get_in(@vacation_offer, [:departure_city_code]) || ""} />
                <.input size="md" name="vacation_offer[departure_city_ref_id]" id="vacation_offer_form_departure_city_ref_id" value={get_in(@vacation_offer, [:departure_city_ref_id]) || ""} />
                <.input size="md" name="vacation_offer[destination_code]" id="vacation_offer_form_destination_code" value={get_in(@vacation_offer, [:destination_code]) || ""} />
                <.input size="md" name="vacation_offer[destination_ref_id]" id="vacation_offer_form_destination_ref_id" value={get_in(@vacation_offer, [:destination_ref_id]) || ""} />
                <.input size="md" name="vacation_offer[start_date]" id="vacation_offer_form_start_date" value={get_in(@vacation_offer, [:start_date]) || ""} />
                <.input size="md" name="vacation_offer[end_date]" id="vacation_offer_form_end_date" value={get_in(@vacation_offer, [:end_date]) || ""} />
                <.input size="md" name="vacation_offer[listed_price]" id="vacation_offer_form_listed_price" value={get_in(@vacation_offer, [:listed_price]) || ""} />
                <.input size="md" name="vacation_offer[settlement_price]" id="vacation_offer_form_settlement_price" value={get_in(@vacation_offer, [:settlement_price]) || ""} />
                <.input size="md" name="vacation_offer[currency]" id="vacation_offer_form_currency" value={get_in(@vacation_offer, [:currency]) || ""} />
                <.input size="md" name="vacation_offer[inventory_count]" id="vacation_offer_form_inventory_count" value={get_in(@vacation_offer, [:inventory_count]) || ""} />
                <.textarea name="vacation_offer[booking_rules]" id="vacation_offer_form_booking_rules" value={get_in(@vacation_offer, [:booking_rules]) || ""} />
                <.textarea name="vacation_offer[cancellation_policy]" id="vacation_offer_form_cancellation_policy" value={get_in(@vacation_offer, [:cancellation_policy]) || ""} />
                <.select size="md" name="vacation_offer[sale_status]" id="vacation_offer_form_sale_status" :let={builder} value={get_in(@vacation_offer, [:sale_status]) || ""}>
                  <.select_trigger builder={builder} />
                  <.select_content builder={builder}>
                    <.select_group>
                      <.select_item builder={builder} value="draft" label="draft">draft</.select_item>
                      <.select_item builder={builder} value="active" label="active">active</.select_item>
                      <.select_item builder={builder} value="inactive" label="inactive">inactive</.select_item>
                      <.select_item builder={builder} value="expired" label="expired">expired</.select_item>
                    </.select_group>
                  </.select_content>
                </.select>
              </.stack>
            </.grid>
            <.flex justify="end" gap={2} direction="row" id="form_actions">
              <.button variant="secondary" phx-click="cancel_edit" size="md" id="cancel_btn">
                取消
              </.button>
              <.button variant="primary" size="md" type="submit" id="save_btn">
                保存
              </.button>
            </.flex>
          </.form>
        <% end %>
      </.card_content>
    </.card>
  </.section>
</.page>