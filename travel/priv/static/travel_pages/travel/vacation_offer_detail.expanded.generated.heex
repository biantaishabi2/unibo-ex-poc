<.page title="VacationOffer 详情" id="vacation_offer_detail">
  <.breadcrumb id="vacation_offer_breadcrumb">
    <.breadcrumb_list id="vacation_offer_bc_list">
      <.breadcrumb_item id="vacation_offer_bc_list_item">
        <.breadcrumb_link id="vacation_offer_bc_link">
          VacationOffer 列表
        </.breadcrumb_link>
      </.breadcrumb_item>
      <.breadcrumb_separator id="vacation_offer_bc_sep" />
      <.breadcrumb_item id="vacation_offer_bc_current_item">
        <.breadcrumb_page id="vacation_offer_bc_current">
          <%= @record.supplier_code %>
        </.breadcrumb_page>
      </.breadcrumb_item>
    </.breadcrumb_list>
  </.breadcrumb>
  <.section direction="row" justify="between" align="center" layout="grid" columns={2} id="vacation_offer_detail_header">
    <.flex gap={3} align="center" direction="row" id="vacation_offer_title_group">
      <.text variant="title" id="vacation_offer_detail_title">
        <%= @record.supplier_code %>
      </.text>
      <.badge variant="default" size="sm" id="vacation_offer_status_badge">
        <%= @record.sale_status %>
      </.badge>
    </.flex>
    <.flex gap={2} direction="row" id="vacation_offer_actions">
      <.button variant="secondary" phx-click="toggle_edit" size="md" id="vacation_offer_edit_btn">
        编辑
      </.button>
      <.button variant="secondary" phx-click="action_activate" size="md" id="vacation_offer_action_activate">
        activate
      </.button>
      <.button variant="secondary" phx-click="action_deactivate" size="md" id="vacation_offer_action_deactivate">
        deactivate
      </.button>
      <.button variant="secondary" phx-click="action_expire" size="md" id="vacation_offer_action_expire">
        expire
      </.button>
      <.button variant="danger" phx-click="action_destroy" size="md" id="vacation_offer_delete_btn">
        删除
      </.button>
    </.flex>
  </.section>
  <.card variant="default" id="vacation_offer_info_card">
    <.card_header id="vacation_offer_info_header">
      <.card_title id="vacation_offer_info_title">
        基本信息
      </.card_title>
    </.card_header>
    <.card_content id="vacation_offer_info_content">
      <%= if !(@editing && @editing != []) do %>
        <.grid columns={2} gap={4} id="vacation_offer_info_grid">
          <.flex direction="row" id="field_supplier_code">
            <.text variant="muted" id="label_supplier_code">
              供应商编码
            </.text>
            <.text id="value_supplier_code">
              <%= @record.supplier_code %>
            </.text>
          </.flex>
          <.flex direction="row" id="field_package_code">
            <.text variant="muted" id="label_package_code">
              套餐编码
            </.text>
            <.text id="value_package_code">
              <%= @record.package_code %>
            </.text>
          </.flex>
          <.flex direction="row" id="field_package_name">
            <.text variant="muted" id="label_package_name">
              套餐名称
            </.text>
            <.text id="value_package_name">
              <%= @record.package_name %>
            </.text>
          </.flex>
          <.flex direction="row" id="field_package_type">
            <.text variant="muted" id="label_package_type">
              套餐类型
            </.text>
            <.badge variant="default" size="sm" id="value_package_type">
              <%= @record.package_type %>
            </.badge>
          </.flex>
          <.flex direction="row" id="field_departure_city_code">
            <.text variant="muted" id="label_departure_city_code">
              出发城市编码
            </.text>
            <.text id="value_departure_city_code">
              <%= @record.departure_city_code %>
            </.text>
          </.flex>
          <.flex direction="row" id="field_destination_code">
            <.text variant="muted" id="label_destination_code">
              目的地编码
            </.text>
            <.text id="value_destination_code">
              <%= @record.destination_code %>
            </.text>
          </.flex>
          <.flex direction="row" id="field_start_date">
            <.text variant="muted" id="label_start_date">
              出行开始日期
            </.text>
            <.text id="value_start_date">
              <%= @record.start_date %>
            </.text>
          </.flex>
          <.flex direction="row" id="field_end_date">
            <.text variant="muted" id="label_end_date">
              出行结束日期
            </.text>
            <.text id="value_end_date">
              <%= @record.end_date %>
            </.text>
          </.flex>
          <.flex direction="row" id="field_listed_price">
            <.text variant="muted" id="label_listed_price">
              对客展示价快照
            </.text>
            <.text id="value_listed_price">
              <%= @record.listed_price %>
            </.text>
          </.flex>
          <.flex direction="row" id="field_settlement_price">
            <.text variant="muted" id="label_settlement_price">
              结算价快照
            </.text>
            <.text id="value_settlement_price">
              <%= @record.settlement_price %>
            </.text>
          </.flex>
          <.flex direction="row" id="field_currency">
            <.text variant="muted" id="label_currency">
              currency
            </.text>
            <.text id="value_currency">
              <%= @record.currency %>
            </.text>
          </.flex>
          <.flex direction="row" id="field_inventory_count">
            <.text variant="muted" id="label_inventory_count">
              可售库存快照
            </.text>
            <.text id="value_inventory_count">
              <%= @record.inventory_count %>
            </.text>
          </.flex>
          <.flex direction="row" id="field_booking_rules">
            <.text variant="muted" id="label_booking_rules">
              预订规则快照
            </.text>
            <.text id="value_booking_rules">
              <%= @record.booking_rules %>
            </.text>
          </.flex>
          <.flex direction="row" id="field_cancellation_policy">
            <.text variant="muted" id="label_cancellation_policy">
              取消规则快照
            </.text>
            <.text id="value_cancellation_policy">
              <%= @record.cancellation_policy %>
            </.text>
          </.flex>
          <.flex direction="row" id="field_sale_status">
            <.text variant="muted" id="label_sale_status">
              sale_status
            </.text>
            <.badge variant="default" size="sm" id="value_sale_status">
              <%= @record.sale_status %>
            </.badge>
          </.flex>
        </.grid>
      <% else %>
        <.form phx-submit="form_submit" phx-change="form_change" id="vacation_offer_edit_form">
          <.grid columns={2} gap={4} id="vacation_offer_form_grid">
            <.input name="tenant_id" label="tenant_id" placeholder="请输入tenant_id" required="true" size="md" id="form_tenant_id" />
            <.input name="host_shop_id" label="宿主商城 ID,仅用于宿主侧隔离和桥接上下文" placeholder="请输入宿主商城 ID,仅用于宿主侧隔离和桥接上下文" size="md" id="form_host_shop_id" />
            <.input name="supplier_code" label="供应商编码" placeholder="请输入供应商编码" required="true" size="md" id="form_supplier_code" />
            <.input name="package_code" label="套餐编码" placeholder="请输入套餐编码" required="true" size="md" id="form_package_code" />
            <.input name="package_name" label="套餐名称" placeholder="请输入套餐名称" required="true" size="md" id="form_package_name" />
            <.select name="package_type" label="套餐类型" size="md" id="form_package_type">

            </.select>
            <.input name="departure_city_code" label="出发城市编码" placeholder="请输入出发城市编码" required="true" size="md" id="form_departure_city_code" />
            <.input name="destination_code" label="目的地编码" placeholder="请输入目的地编码" required="true" size="md" id="form_destination_code" />
            <.input name="start_date" label="出行开始日期" placeholder="请输入出行开始日期" required="true" size="md" id="form_start_date" />
            <.input name="end_date" label="出行结束日期" placeholder="请输入出行结束日期" required="true" size="md" id="form_end_date" />
            <.input name="listed_price" label="对客展示价快照" placeholder="请输入对客展示价快照" required="true" size="md" id="form_listed_price" />
            <.input name="settlement_price" label="结算价快照" placeholder="请输入结算价快照" size="md" id="form_settlement_price" />
            <.input name="currency" label="currency" placeholder="请输入currency" size="md" id="form_currency" />
            <.input name="inventory_count" label="可售库存快照" placeholder="请输入可售库存快照" size="md" id="form_inventory_count" />
            <.textarea name="booking_rules" label="预订规则快照" placeholder="请输入预订规则快照" id="form_booking_rules" />
            <.textarea name="cancellation_policy" label="取消规则快照" placeholder="请输入取消规则快照" id="form_cancellation_policy" />
            <.select name="sale_status" label="sale_status" size="md" id="form_sale_status">

            </.select>
          </.grid>
          <.flex justify="end" gap={2} direction="row" id="vacation_offer_form_actions">
            <.button variant="secondary" phx-click="cancel_edit" size="md" id="vacation_offer_cancel_btn">
              取消
            </.button>
            <.button variant="primary" phx-click="form_submit" size="md" id="vacation_offer_save_btn">
              保存
            </.button>
          </.flex>
        </.form>
      <% end %>
    </.card_content>
  </.card>
</.page>