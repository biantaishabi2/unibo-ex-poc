<.page title="TravelAirline 详情" id="travel_airline_detail">
  <.breadcrumb id="travel_airline_breadcrumb">
    <.breadcrumb_list id="travel_airline_bc_list">
      <.breadcrumb_item id="travel_airline_bc_list_item">
        <.breadcrumb_link id="travel_airline_bc_link">
          TravelAirline 列表
        </.breadcrumb_link>
      </.breadcrumb_item>
      <.breadcrumb_separator id="travel_airline_bc_sep" />
      <.breadcrumb_item id="travel_airline_bc_current_item">
        <.breadcrumb_page id="travel_airline_bc_current">
          <%= get_in(@record, [:airline_code]) || "详情" %>
        </.breadcrumb_page>
      </.breadcrumb_item>
    </.breadcrumb_list>
  </.breadcrumb>
  <.section direction="row" justify="between" align="center" layout="grid" columns={2} id="travel_airline_detail_header">
    <.flex gap={3} align="center" direction="row" id="travel_airline_title_group">
      <.text variant="title" id="travel_airline_detail_title">
        <%= get_in(@record, [:airline_code]) || "" %>
      </.text>
      <.badge variant="default" size="sm" id="travel_airline_status_badge">
        <%= get_in(@record, [:status]) || "" %>
      </.badge>
    </.flex>
    <.flex gap={2} direction="row" id="travel_airline_actions">
      <.button variant="secondary" phx-click="toggle_edit" size="md" id="travel_airline_edit_btn">
        编辑
      </.button>
    </.flex>
  </.section>
  <.card variant="default" id="travel_airline_info_card">
    <.card_header id="travel_airline_info_header">
      <.card_title id="travel_airline_info_title">
        基本信息
      </.card_title>
    </.card_header>
    <.card_content id="travel_airline_info_content">
      <%= if !(@editing && @editing != []) do %>
        <.grid columns={2} gap={4} id="travel_airline_info_grid">
          <.flex direction="row" id="field_airline_code">
            <.text variant="muted" id="label_airline_code">
              航司规范编码
            </.text>
            <.text id="value_airline_code">
              <%= get_in(@record, [:airline_code]) || "" %>
            </.text>
          </.flex>
          <.flex direction="row" id="field_airline_name">
            <.text variant="muted" id="label_airline_name">
              航司名称
            </.text>
            <.text id="value_airline_name">
              <%= get_in(@record, [:airline_name]) || "" %>
            </.text>
          </.flex>
          <.flex direction="row" id="field_iata_code">
            <.text variant="muted" id="label_iata_code">
              IATA 二字码
            </.text>
            <.text id="value_iata_code">
              <%= get_in(@record, [:iata_code]) || "" %>
            </.text>
          </.flex>
          <.flex direction="row" id="field_icao_code">
            <.text variant="muted" id="label_icao_code">
              ICAO 三字码
            </.text>
            <.text id="value_icao_code">
              <%= get_in(@record, [:icao_code]) || "" %>
            </.text>
          </.flex>
          <.flex direction="row" id="field_status">
            <.text variant="muted" id="label_status">
              status
            </.text>
            <.badge variant="default" size="sm" id="value_status">
              <%= get_in(@record, [:status]) || "" %>
            </.badge>
          </.flex>
        </.grid>
      <% else %>
        <.form phx-submit="form_submit" phx-change="form_change" id="travel_airline_edit_form">
          <.grid columns={2} gap={4} id="travel_airline_form_grid">
            <.input name="airline_code" label="航司规范编码" placeholder="请输入航司规范编码" required="true" size="md" id="form_airline_code" value={@record.airline_code} />
            <.input name="airline_name" label="航司名称" placeholder="请输入航司名称" required="true" size="md" id="form_airline_name" value={@record.airline_name} />
            <.input name="iata_code" label="IATA 二字码" placeholder="请输入IATA 二字码" size="md" id="form_iata_code" value={@record.iata_code} />
            <.input name="icao_code" label="ICAO 三字码" placeholder="请输入ICAO 三字码" size="md" id="form_icao_code" value={@record.icao_code} />
            <.select name="status" label="status" size="md" id="form_status" value={@record.status}>

            </.select>
          </.grid>
          <.flex justify="end" gap={2} direction="row" id="travel_airline_form_actions">
            <.button variant="secondary" phx-click="cancel_edit" size="md" id="travel_airline_cancel_btn">
              取消
            </.button>
            <.button variant="primary" phx-click="form_submit" size="md" id="travel_airline_save_btn">
              保存
            </.button>
          </.flex>
        </.form>
      <% end %>
    </.card_content>
  </.card>
</.page>