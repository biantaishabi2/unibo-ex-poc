{
  "version": 1,
  "defaults": {
    "page_title": "TravelPolicyCheck 列表",
    "rows_empty": true,
    "rows": [
      {
        "check_result": "",
        "policy_amount": "",
        "actual_amount": "",
        "exceed_amount": "",
        "exceed_ratio": "",
        "exceed_strategy": "",
        "exceed_reason": "",
        "personal_pay_amount": "",
        "approval_mode": "",
        "id": "row_01"
      },
      {
        "check_result": "",
        "policy_amount": "",
        "actual_amount": "",
        "exceed_amount": "",
        "exceed_ratio": "",
        "exceed_strategy": "",
        "exceed_reason": "",
        "personal_pay_amount": "",
        "approval_mode": "",
        "id": "row_02"
      },
      {
        "check_result": "",
        "policy_amount": "",
        "actual_amount": "",
        "exceed_amount": "",
        "exceed_ratio": "",
        "exceed_strategy": "",
        "exceed_reason": "",
        "personal_pay_amount": "",
        "approval_mode": "",
        "id": "row_03"
      }
    ]
  },
  "keys": [
    "page_title",
    "rows",
    "rows[]",
    "rows[].actual_amount",
    "rows[].approval_mode",
    "rows[].check_result",
    "rows[].exceed_amount",
    "rows[].exceed_ratio",
    "rows[].exceed_reason",
    "rows[].exceed_strategy",
    "rows[].id",
    "rows[].personal_pay_amount",
    "rows[].policy_amount",
    "rows_empty"
  ],
  "required": [
    "page_title",
    "rows",
    "rows_empty"
  ],
  "urlParams": {},
  "notes": [],
  "layer2": {
    "backend": {
      "api_map": {
        "list": "TravelExt.TravelPolicyCheck.list"
      },
      "info": {
        "reload_messages": [
          "page_host_reload"
        ]
      },
      "load": {
        "assigns": {},
        "selection": "actual_amount: actualAmount approval_mode: approvalMode approval_request_id: approvalRequestId check_result: checkResult exceed_amount: exceedAmount exceed_ratio: exceedRatio exceed_reason: exceedReason exceed_strategy: exceedStrategy id personal_pay_amount: personalPayAmount policy_amount: policyAmount"
      },
      "params": {
        "accept": [
          "check_result",
          "approval_mode"
        ]
      }
    },
    "domain": "TravelExt",
    "e2e": {
      "playwright": {
        "auto": true,
        "base_path": "/travel_ext/travel_policy_check",
        "cases": [
          {
            "covers": [],
            "name": "页面加载 + 结构可见",
            "steps": [
              {
                "action": "expect_visible",
                "selector": "[data-page='travel_policy_check_list']"
              }
            ]
          },
          {
            "covers": [
              "navigate_create"
            ],
            "name": "新建导航",
            "steps": [
              {
                "action": "click",
                "selector": "#travel_policy_check_create_btn, [data-action='navigate_create']"
              },
              {
                "action": "expect_url_contains",
                "value": "/travel_ext/travel_policy_check/new"
              }
            ]
          },
          {
            "covers": [],
            "name": "表格行存在",
            "steps": [
              {
                "action": "expect_visible",
                "selector": "#travel_policy_check_table, [data-table='travel_policy_check']"
              }
            ]
          }
        ],
        "dto_smoke": []
      }
    },
    "entity": "TravelPolicyCheck",
    "page_id": "travel_policy_check_list",
    "page_type": "list_report",
    "runtime_monitoring": null,
    "schema_version": "1.0",
    "state_transitions": [
      {
        "description": "筛选条件变更",
        "from": "*",
        "name": "filter_change",
        "to": "*",
        "trigger": "user_input"
      },
      {
        "description": "提交筛选查询",
        "from": "*",
        "name": "filter_submit",
        "to": "loading",
        "trigger": "user_action"
      },
      {
        "description": "点击行跳转详情",
        "from": "*",
        "name": "row_click",
        "navigate_to": "/travel_ext/travel_policy_check/{id}",
        "to": "*",
        "trigger": "user_action"
      },
      {
        "description": "跳转新建页",
        "from": "*",
        "name": "navigate_create",
        "navigate_to": "/travel_ext/travel_policy_check/new",
        "to": "*",
        "trigger": "user_action"
      }
    ],
    "status_keys": [
      "rows",
      "rows_empty",
      "filter",
      "loading"
    ],
    "ui": {
      "sections": [],
      "template": {
        "list": "list_report"
      }
    },
    "version": 1
  }
}