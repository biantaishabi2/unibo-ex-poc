{
  "version": 1,
  "defaults": {
    "record": {
      "refund_reason": "",
      "status": "",
      "refund_fee": "",
      "refund_amount": "",
      "approval_mode": ""
    },
    "editing": false
  },
  "keys": [
    "editing",
    "record",
    "record.approval_mode",
    "record.refund_amount",
    "record.refund_fee",
    "record.refund_reason",
    "record.status"
  ],
  "required": [
    "editing",
    "record"
  ],
  "urlParams": {},
  "notes": [],
  "layer2": {
    "backend": {
      "api_map": {
        "approve": "TravelExt.TravelRefundOrder.approve",
        "create": "TravelExt.TravelRefundOrder.create",
        "get": "TravelExt.TravelRefundOrder.get",
        "refund": "TravelExt.TravelRefundOrder.refund",
        "refund_direct": "TravelExt.TravelRefundOrder.refund_direct",
        "reject": "TravelExt.TravelRefundOrder.reject",
        "update": "TravelExt.TravelRefundOrder.update"
      },
      "info": {
        "reload_messages": [
          "page_host_reload"
        ]
      },
      "load": {
        "assigns": {},
        "selection": "approval_mode: approvalMode id refund_amount: refundAmount refund_fee: refundFee refund_reason: refundReason status"
      },
      "params": {
        "accept": [
          "id"
        ]
      }
    },
    "children": [],
    "domain": "TravelExt",
    "e2e": {
      "playwright": {
        "auto": true,
        "base_path": "/travel_ext/travel_refund_order/:id",
        "cases": [
          {
            "covers": [],
            "name": "页面加载 + 结构可见",
            "steps": [
              {
                "action": "expect_visible",
                "selector": "[data-page='travel_refund_order_detail']"
              }
            ]
          },
          {
            "covers": [
              "toggle_edit"
            ],
            "name": "编辑模式切换",
            "steps": [
              {
                "action": "click",
                "selector": "[data-action='toggle_edit']"
              },
              {
                "action": "expect_visible",
                "selector": "form, [data-mode='edit']"
              }
            ]
          },
          {
            "covers": [
              "form_submit"
            ],
            "name": "表单提交",
            "steps": [
              {
                "action": "click",
                "selector": "[data-action='form_submit'], button[type='submit']"
              },
              {
                "action": "expect_text_contains",
                "selector": "#flash-group, [data-flash], [role='alert']",
                "value": "成功"
              }
            ]
          },
          {
            "covers": [
              "action_approve"
            ],
            "name": "动作：approve",
            "steps": [
              {
                "action": "click",
                "selector": "[data-action='action_approve']"
              },
              {
                "action": "expect_visible",
                "selector": "[data-action='action_approve']"
              }
            ]
          },
          {
            "covers": [
              "action_reject"
            ],
            "name": "动作：reject",
            "steps": [
              {
                "action": "click",
                "selector": "[data-action='action_reject']"
              },
              {
                "action": "expect_visible",
                "selector": "[data-action='action_reject']"
              }
            ]
          },
          {
            "covers": [
              "action_refund"
            ],
            "name": "动作：refund",
            "steps": [
              {
                "action": "click",
                "selector": "[data-action='action_refund']"
              },
              {
                "action": "expect_visible",
                "selector": "[data-action='action_refund']"
              }
            ]
          },
          {
            "covers": [
              "action_refund_direct"
            ],
            "name": "动作：refund_direct",
            "steps": [
              {
                "action": "click",
                "selector": "[data-action='action_refund_direct']"
              },
              {
                "action": "expect_visible",
                "selector": "[data-action='action_refund_direct']"
              }
            ]
          }
        ],
        "dto_smoke": []
      }
    },
    "entity": "TravelRefundOrder",
    "page_id": "travel_refund_order_detail",
    "page_type": "object_page",
    "runtime_monitoring": null,
    "schema_version": "1.0",
    "state_transitions": [
      {
        "description": "切换编辑模式",
        "from": "*",
        "name": "toggle_edit",
        "to": "*",
        "trigger": "user_action"
      },
      {
        "description": "取消编辑",
        "from": "*",
        "name": "cancel_edit",
        "to": "*",
        "trigger": "user_action"
      },
      {
        "description": "表单字段变更",
        "from": "*",
        "name": "form_change",
        "to": "*",
        "trigger": "user_input"
      },
      {
        "description": "提交表单",
        "from": "editing",
        "name": "form_submit",
        "to": "loading",
        "trigger": "user_action"
      },
      {
        "description": "approve",
        "from": "*",
        "name": "action_approve",
        "to": "loading",
        "trigger": "user_action"
      },
      {
        "description": "reject",
        "from": "*",
        "name": "action_reject",
        "to": "loading",
        "trigger": "user_action"
      },
      {
        "description": "refund",
        "from": "*",
        "name": "action_refund",
        "to": "loading",
        "trigger": "user_action"
      },
      {
        "description": "refund_direct",
        "from": "*",
        "name": "action_refund_direct",
        "to": "loading",
        "trigger": "user_action"
      }
    ],
    "status_keys": [
      "record",
      "editing",
      "form",
      "loading"
    ],
    "ui": {
      "sections": [],
      "template": {
        "detail": "object_page"
      }
    },
    "version": 1
  }
}