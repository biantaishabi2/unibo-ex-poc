{
  "version": 1,
  "defaults": {
    "record": {
      "change_reason": "",
      "status": "",
      "price_difference": "",
      "change_fee": "",
      "approval_mode": "",
      "new_offer_id": ""
    },
    "editing": false
  },
  "keys": [
    "editing",
    "record",
    "record.approval_mode",
    "record.change_fee",
    "record.change_reason",
    "record.new_offer_id",
    "record.price_difference",
    "record.status"
  ],
  "required": [
    "editing",
    "record"
  ],
  "urlParams": {},
  "notes": [],
  "layer2": {
    "backend": {
      "api_map": {
        "approve": "TravelExt.TravelChangeOrder.approve",
        "complete": "TravelExt.TravelChangeOrder.complete",
        "complete_direct": "TravelExt.TravelChangeOrder.complete_direct",
        "create": "TravelExt.TravelChangeOrder.create",
        "get": "TravelExt.TravelChangeOrder.get",
        "reject": "TravelExt.TravelChangeOrder.reject",
        "update": "TravelExt.TravelChangeOrder.update"
      },
      "info": {
        "reload_messages": [
          "page_host_reload"
        ]
      },
      "load": {
        "assigns": {},
        "selection": "approval_mode: approvalMode change_fee: changeFee change_reason: changeReason id new_offer_id: newOfferId price_difference: priceDifference status"
      },
      "params": {
        "accept": [
          "id"
        ]
      }
    },
    "children": [],
    "domain": "TravelExt",
    "e2e": {
      "playwright": {
        "auto": true,
        "base_path": "/travel_ext/travel_change_order/:id",
        "cases": [
          {
            "covers": [],
            "name": "页面加载 + 结构可见",
            "steps": [
              {
                "action": "expect_visible",
                "selector": "[data-page='travel_change_order_detail']"
              }
            ]
          },
          {
            "covers": [
              "toggle_edit"
            ],
            "name": "编辑模式切换",
            "steps": [
              {
                "action": "click",
                "selector": "[data-action='toggle_edit']"
              },
              {
                "action": "expect_visible",
                "selector": "form, [data-mode='edit']"
              }
            ]
          },
          {
            "covers": [
              "form_submit"
            ],
            "name": "表单提交",
            "steps": [
              {
                "action": "click",
                "selector": "[data-action='form_submit'], button[type='submit']"
              },
              {
                "action": "expect_text_contains",
                "selector": "#flash-group, [data-flash], [role='alert']",
                "value": "成功"
              }
            ]
          },
          {
            "covers": [
              "action_approve"
            ],
            "name": "动作：approve",
            "steps": [
              {
                "action": "click",
                "selector": "[data-action='action_approve']"
              },
              {
                "action": "expect_visible",
                "selector": "[data-action='action_approve']"
              }
            ]
          },
          {
            "covers": [
              "action_reject"
            ],
            "name": "动作：reject",
            "steps": [
              {
                "action": "click",
                "selector": "[data-action='action_reject']"
              },
              {
                "action": "expect_visible",
                "selector": "[data-action='action_reject']"
              }
            ]
          },
          {
            "covers": [
              "action_complete"
            ],
            "name": "动作：complete",
            "steps": [
              {
                "action": "click",
                "selector": "[data-action='action_complete']"
              },
              {
                "action": "expect_visible",
                "selector": "[data-action='action_complete']"
              }
            ]
          },
          {
            "covers": [
              "action_complete_direct"
            ],
            "name": "动作：complete_direct",
            "steps": [
              {
                "action": "click",
                "selector": "[data-action='action_complete_direct']"
              },
              {
                "action": "expect_visible",
                "selector": "[data-action='action_complete_direct']"
              }
            ]
          }
        ],
        "dto_smoke": []
      }
    },
    "entity": "TravelChangeOrder",
    "page_id": "travel_change_order_detail",
    "page_type": "object_page",
    "runtime_monitoring": null,
    "schema_version": "1.0",
    "state_transitions": [
      {
        "description": "切换编辑模式",
        "from": "*",
        "name": "toggle_edit",
        "to": "*",
        "trigger": "user_action"
      },
      {
        "description": "取消编辑",
        "from": "*",
        "name": "cancel_edit",
        "to": "*",
        "trigger": "user_action"
      },
      {
        "description": "表单字段变更",
        "from": "*",
        "name": "form_change",
        "to": "*",
        "trigger": "user_input"
      },
      {
        "description": "提交表单",
        "from": "editing",
        "name": "form_submit",
        "to": "loading",
        "trigger": "user_action"
      },
      {
        "description": "approve",
        "from": "*",
        "name": "action_approve",
        "to": "loading",
        "trigger": "user_action"
      },
      {
        "description": "reject",
        "from": "*",
        "name": "action_reject",
        "to": "loading",
        "trigger": "user_action"
      },
      {
        "description": "complete",
        "from": "*",
        "name": "action_complete",
        "to": "loading",
        "trigger": "user_action"
      },
      {
        "description": "complete_direct",
        "from": "*",
        "name": "action_complete_direct",
        "to": "loading",
        "trigger": "user_action"
      }
    ],
    "status_keys": [
      "record",
      "editing",
      "form",
      "loading"
    ],
    "ui": {
      "sections": [],
      "template": {
        "detail": "object_page"
      }
    },
    "version": 1
  }
}