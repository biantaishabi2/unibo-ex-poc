{
  "version": 1,
  "defaults": {
    "page_title": "TravelRefundOrder 列表",
    "rows_empty": true,
    "rows": [
      {
        "refund_reason": "",
        "refund_fee": "",
        "refund_amount": "",
        "status": "",
        "approval_mode": "",
        "id": "row_01"
      },
      {
        "refund_reason": "",
        "refund_fee": "",
        "refund_amount": "",
        "status": "",
        "approval_mode": "",
        "id": "row_02"
      },
      {
        "refund_reason": "",
        "refund_fee": "",
        "refund_amount": "",
        "status": "",
        "approval_mode": "",
        "id": "row_03"
      }
    ]
  },
  "keys": [
    "page_title",
    "rows",
    "rows[]",
    "rows[].approval_mode",
    "rows[].id",
    "rows[].refund_amount",
    "rows[].refund_fee",
    "rows[].refund_reason",
    "rows[].status",
    "rows_empty"
  ],
  "required": [
    "page_title",
    "rows",
    "rows_empty"
  ],
  "urlParams": {},
  "notes": [],
  "layer2": {
    "backend": {
      "api_map": {
        "list": "TravelExt.TravelRefundOrder.list"
      },
      "info": {
        "reload_messages": [
          "page_host_reload"
        ]
      },
      "load": {
        "assigns": {},
        "selection": "approval_mode: approvalMode id refund_amount: refundAmount refund_fee: refundFee refund_reason: refundReason status"
      },
      "params": {
        "accept": [
          "status",
          "approval_mode"
        ]
      }
    },
    "domain": "TravelExt",
    "e2e": {
      "playwright": {
        "auto": true,
        "base_path": "/travel_ext/travel_refund_order",
        "cases": [
          {
            "covers": [],
            "name": "页面加载 + 结构可见",
            "steps": [
              {
                "action": "expect_visible",
                "selector": "[data-page='travel_refund_order_list']"
              }
            ]
          },
          {
            "covers": [
              "navigate_create"
            ],
            "name": "新建导航",
            "steps": [
              {
                "action": "click",
                "selector": "#travel_refund_order_create_btn, [data-action='navigate_create']"
              },
              {
                "action": "expect_url_contains",
                "value": "/travel_ext/travel_refund_order/new"
              }
            ]
          },
          {
            "covers": [],
            "name": "表格行存在",
            "steps": [
              {
                "action": "expect_visible",
                "selector": "#travel_refund_order_table, [data-table='travel_refund_order']"
              }
            ]
          }
        ],
        "dto_smoke": []
      }
    },
    "entity": "TravelRefundOrder",
    "page_id": "travel_refund_order_list",
    "page_type": "list_report",
    "runtime_monitoring": null,
    "schema_version": "1.0",
    "state_transitions": [
      {
        "description": "筛选条件变更",
        "from": "*",
        "name": "filter_change",
        "to": "*",
        "trigger": "user_input"
      },
      {
        "description": "提交筛选查询",
        "from": "*",
        "name": "filter_submit",
        "to": "loading",
        "trigger": "user_action"
      },
      {
        "description": "点击行跳转详情",
        "from": "*",
        "name": "row_click",
        "navigate_to": "/travel_ext/travel_refund_order/{id}",
        "to": "*",
        "trigger": "user_action"
      },
      {
        "description": "跳转新建页",
        "from": "*",
        "name": "navigate_create",
        "navigate_to": "/travel_ext/travel_refund_order/new",
        "to": "*",
        "trigger": "user_action"
      }
    ],
    "status_keys": [
      "rows",
      "rows_empty",
      "filter",
      "loading"
    ],
    "ui": {
      "sections": [],
      "template": {
        "list": "list_report"
      }
    },
    "version": 1
  }
}