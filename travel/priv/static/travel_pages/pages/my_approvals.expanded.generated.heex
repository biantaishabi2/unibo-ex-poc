<.page title="工作列表" id="my_approvals">
  <.section layout="grid" columns={3} id="queue_filters">
    <.flex justify="between" align="center" direction="row" id="queue_header">
      <.text variant="title" id="page_title">
        <%= @page_title %>
      </.text>
      <.flex gap={2} direction="row" id="bulk_actions">
        <.button variant="primary" phx-click="bulk_approve" size="md" id="bulk_approve">
          批量通过
        </.button>
        <.button variant="secondary" phx-click="bulk_reject" size="md" id="bulk_reject">
          批量驳回
        </.button>
      </.flex>
    </.flex>
    <.tabs default_value="pending" id="queue_tabs">
      <.tabs_list id="queue_tab_list">
        <.tabs_trigger value="pending" active_value="pending" id="trigger_pending">
          待处理
        </.tabs_trigger>
        <.tabs_trigger value="in_progress" active_value="pending" id="trigger_in_progress">
          处理中
        </.tabs_trigger>
        <.tabs_trigger value="completed" active_value="pending" id="trigger_completed">
          已完成
        </.tabs_trigger>
        <.tabs_trigger value="all" active_value="pending" id="trigger_all">
          全部
        </.tabs_trigger>
      </.tabs_list>
      <.tabs_content value="pending" active_value="pending" id="content_pending">
        <.text id="pending_placeholder">
          待处理任务列表
        </.text>
      </.tabs_content>
      <.tabs_content value="in_progress" active_value="pending" id="content_in_progress">
        <.text id="in_progress_placeholder">
          处理中任务列表
        </.text>
      </.tabs_content>
      <.tabs_content value="completed" active_value="pending" id="content_completed">
        <.text id="completed_placeholder">
          已完成任务列表
        </.text>
      </.tabs_content>
      <.tabs_content value="all" active_value="pending" id="content_all">
        <.text id="all_placeholder">
          全部任务列表
        </.text>
      </.tabs_content>
    </.tabs>
    <.flex gap={4} align="center" direction="row" id="filter_row">
      <.stack direction="column" id="filter_fields" />
      <.button variant="secondary" phx-click="filter_submit" size="md" id="filter_submit">
        查询
      </.button>
    </.flex>
  </.section>
  <.section layout="none" id="task_list_section">
    <.split ratio="2:3" id="main_split">
      <.stack direction="column" id="task_list">
        <%= for task <- (@tasks || []) do %>
          <.card variant="default">
            <.card_content>
              <.grid columns={2} gap={3}>
                <.stack gap={0} direction="column">
                  <.text variant="caption" color="muted">
                    校验结果
                  </.text>
                  <.text>
                    <%= get_in(@travel_policy_check, [:check_result]) || "" %>
                  </.text>
                </.stack>
                <.stack gap={0} direction="column">
                  <.text variant="caption" color="muted">
                    差标金额（单位分）
                  </.text>
                  <.text>
                    <%= get_in(@travel_policy_check, [:policy_amount]) || "" %>
                  </.text>
                </.stack>
                <.stack gap={0} direction="column">
                  <.text variant="caption" color="muted">
                    实际金额（单位分）
                  </.text>
                  <.text>
                    <%= get_in(@travel_policy_check, [:actual_amount]) || "" %>
                  </.text>
                </.stack>
                <.stack gap={0} direction="column">
                  <.text variant="caption" color="muted">
                    超标金额
                  </.text>
                  <.text>
                    <%= get_in(@travel_policy_check, [:exceed_amount]) || "" %>
                  </.text>
                </.stack>
                <.stack gap={0} direction="column">
                  <.text variant="caption" color="muted">
                    超标比例（如'15%'）
                  </.text>
                  <.text>
                    <%= get_in(@travel_policy_check, [:exceed_ratio]) || "" %>
                  </.text>
                </.stack>
                <.stack gap={0} direction="column">
                  <.text variant="caption" color="muted">
                    命中的超标策略
                  </.text>
                  <.text>
                    <%= get_in(@travel_policy_check, [:exceed_strategy]) || "" %>
                  </.text>
                </.stack>
                <.stack gap={0} direction="column">
                  <.text variant="caption" color="muted">
                    超标原因（员工填写）
                  </.text>
                  <.text>
                    <%= get_in(@travel_policy_check, [:exceed_reason]) || "" %>
                  </.text>
                </.stack>
                <.stack gap={0} direction="column">
                  <.text variant="caption" color="muted">
                    个人支付部分
                  </.text>
                  <.text>
                    <%= get_in(@travel_policy_check, [:personal_pay_amount]) || "" %>
                  </.text>
                </.stack>
                <.stack gap={0} direction="column">
                  <.text variant="caption" color="muted">
                    命中政策时的审批模式快照
                  </.text>
                  <.text>
                    <%= get_in(@travel_policy_check, [:approval_mode]) || "" %>
                  </.text>
                </.stack>
              </.grid>
            </.card_content>
          </.card>
        <% end %>
        <%= if (@tasks_empty && @tasks_empty != []) do %>
          <.empty_state description="当前没有待处理的任务" id="no_tasks" />
        <% end %>
      </.stack>
      <.stack direction="column" id="detail_panel">
        <.card variant="default" id="task_detail_card">
          <.card_header id="task_detail_header">
            <.card_title id="task_detail_title">
              <%= get_in(@selected_task, [:title]) || "请选择任务" %>
            </.card_title>
          </.card_header>
          <.card_content id="task_detail_content">
            <.stack gap={3} direction="column" id="task_detail_info">
              <.text id="task_detail_fields">
                任务详情区域
              </.text>
            </.stack>
          </.card_content>
          <.card_footer id="task_detail_footer">
            <.flex gap={2} direction="row" id="detail_actions" />
          </.card_footer>
        </.card>
      </.stack>
    </.split>
  </.section>
</.page>