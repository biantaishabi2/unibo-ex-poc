{
  "version": 1,
  "vars": {
    "travel_cabin_class.cabin_class_code": {
      "uses": [
        {
          "node_type": "Text",
          "node_id": "detail_fields_cabin_class_code_value",
          "location": "prop",
          "prop": "content",
          "template": "{{travel_cabin_class.cabin_class_code|}}"
        }
      ]
    },
    "travel_cabin_class.cabin_class_name": {
      "uses": [
        {
          "node_type": "Text",
          "node_id": "detail_fields_cabin_class_name_value",
          "location": "prop",
          "prop": "content",
          "template": "{{travel_cabin_class.cabin_class_name|}}"
        }
      ]
    },
    "travel_cabin_class.cabin_rank": {
      "uses": [
        {
          "node_type": "Text",
          "node_id": "detail_fields_cabin_rank_value",
          "location": "prop",
          "prop": "content",
          "template": "{{travel_cabin_class.cabin_rank|}}"
        }
      ]
    },
    "travel_cabin_class.status": {
      "uses": [
        {
          "node_type": "Text",
          "node_id": "detail_fields_status_value",
          "location": "prop",
          "prop": "content",
          "template": "{{travel_cabin_class.status|}}"
        }
      ]
    }
  },
  "events": {
    "toggle_edit": {
      "triggers": [
        {
          "node_type": "Button",
          "node_id": "edit_btn",
          "prop": "click",
          "raw": "toggle_edit"
        }
      ]
    },
    "action_destroy": {
      "triggers": [
        {
          "node_type": "Button",
          "node_id": "delete_btn",
          "prop": "click",
          "raw": "action_destroy"
        }
      ]
    },
    "form_submit": {
      "triggers": [
        {
          "node_type": "Form",
          "node_id": "edit_form",
          "prop": "submit",
          "raw": "form_submit"
        },
        {
          "node_type": "Button",
          "node_id": "save_btn",
          "prop": "click",
          "raw": "form_submit"
        }
      ]
    },
    "form_change": {
      "triggers": [
        {
          "node_type": "Form",
          "node_id": "edit_form",
          "prop": "change",
          "raw": "form_change"
        }
      ]
    },
    "cancel_edit": {
      "triggers": [
        {
          "node_type": "Button",
          "node_id": "cancel_btn",
          "prop": "click",
          "raw": "cancel_edit"
        }
      ]
    }
  }
}