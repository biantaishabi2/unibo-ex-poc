      {
        "name": "SolverRun",
        "description": "一次求解执行记录与输入/输出快照载体",
        "aggregate_root": false,
        "attributes": [
          {
            "name": "id",
            "type": "uuid",
            "primary_key": true,
            "generated": true
          },
          {
            "name": "status",
            "type": "enum",
            "required": true,
            "default": "pending",
            "constraints": {
              "values": [
                "pending",
                "running",
                "feasible",
                "infeasible",
                "timeout",
                "error",
                "completed"
              ]
            },
            "description": "求解状态"
          },
          {
            "name": "engine_type",
            "type": "string",
            "required": true,
            "default": "greedy_local_search",
            "description": "算法标识"
          },
          {
            "name": "seed",
            "type": "integer",
            "description": "随机种子，用于复现实验"
          },
          {
            "name": "timeout_ms",
            "type": "integer",
            "required": true,
            "default": 30000,
            "description": "超时毫秒数"
          },
          {
            "name": "started_at",
            "type": "datetime",
            "description": "求解开始时间"
          },
          {
            "name": "completed_at",
            "type": "datetime",
            "description": "求解结束时间"
          },
          {
            "name": "score",
            "type": "decimal",
            "description": "总评分"
          },
          {
            "name": "hard_violation_count",
            "type": "integer",
            "required": true,
            "default": 0,
            "description": "硬约束违反数"
          },
          {
            "name": "warning_count",
            "type": "integer",
            "required": true,
            "default": 0,
            "description": "警告数"
          },
          {
            "name": "input_snapshot",
            "type": "jsonb",
            "required": true,
            "default": {},
            "description": "输入快照（跨域数据在 run 开始时一次性冻结）"
          },
          {
            "name": "output_snapshot",
            "type": "jsonb",
            "description": "输出摘要（不重复整份 assignment 明细）"
          },
          {
            "name": "error_message",
            "type": "text",
            "description": "错误信息"
          },
          {
            "name": "inserted_at",
            "type": "datetime",
            "generated": true
          },
          {
            "name": "updated_at",
            "type": "datetime",
            "generated": true
          }
        ],
        "relationships": [
          {
            "name": "period",
            "type": "belongs_to",
            "target": "SchedulingPeriod",
            "foreign_key": "period_id",
            "required": true
          }
        ],
        "actions": [
          {
            "name": "create",
            "type": "create",
            "accept": [
              "engine_type",
              "seed",
              "timeout_ms",
              "input_snapshot"
            ],
            "primary": true
          },
          {
            "name": "update",
            "type": "update",
            "accept": [
              "status",
              "started_at",
              "completed_at",
              "score",
              "hard_violation_count",
              "warning_count",
              "output_snapshot",
              "error_message"
            ],
            "primary": true
          },
          {
            "name": "read",
            "type": "read",
            "primary": true
          },
          {
            "name": "start_run",
            "type": "update",
            "accept": [],
            "description": "标记求解开始"
          },
          {
            "name": "complete_feasible",
            "type": "update",
            "accept": [
              "score",
              "hard_violation_count",
              "warning_count",
              "output_snapshot"
            ],
            "description": "求解完成（可行解）"
          },
          {
            "name": "complete_infeasible",
            "type": "update",
            "accept": [
              "hard_violation_count",
              "warning_count",
              "output_snapshot",
              "error_message"
            ],
            "description": "求解完成（不可行）"
          },
          {
            "name": "mark_timeout",
            "type": "update",
            "accept": [
              "score",
              "hard_violation_count",
              "warning_count",
              "output_snapshot"
            ],
            "description": "求解超时"
          },
          {
            "name": "mark_error",
            "type": "update",
            "accept": [
              "error_message"
            ],
            "description": "求解出错"
          },
          {
            "name": "mark_completed",
            "type": "update",
            "accept": [],
            "description": "最终完成（用户确认采用此结果）"
          }
        ],
        "validations": [
          {
            "rule": "one_of",
            "field": "status",
            "params": {
              "values": [
                "pending"
              ]
            },
            "on": [
              "start_run"
            ],
            "message": "只有待执行状态可以开始"
          },
          {
            "rule": "one_of",
            "field": "status",
            "params": {
              "values": [
                "running"
              ]
            },
            "on": [
              "complete_feasible",
              "complete_infeasible",
              "mark_timeout",
              "mark_error"
            ],
            "message": "只有运行中状态可以完成"
          }
        ],
        "workflows": [
          {
            "name": "solver_run_lifecycle",
            "description": "求解运行生命周期",
            "steps": [
              {
                "action": "create",
                "next": [
                  "start_run"
                ]
              },
              {
                "action": "start_run",
                "next": [
                  "complete_feasible",
                  "complete_infeasible",
                  "mark_timeout",
                  "mark_error"
                ]
              },
              {
                "action": "complete_feasible",
                "next": [
                  "mark_completed"
                ]
              },
              {
                "action": "mark_timeout",
                "next": [
                  "mark_completed"
                ]
              }
            ]
          }
        ]
      },
      {
