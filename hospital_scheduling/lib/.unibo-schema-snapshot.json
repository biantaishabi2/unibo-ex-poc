[
  {
    "version": "1.0",
    "domain": {
      "name": "Scheduling",
      "description": "护士排班核心域 — 科室月排班工作空间、班次类型、覆盖需求、排班分配、约束管理、求解运行与版本管理",
      "subdomain": "scheduling"
    },
    "entities": [
      {
        "name": "Employee",
        "description": "跨域引用 HR.Employee（护士/医护人员）",
        "aggregate_root": false,
        "attributes": [
          {
            "name": "id",
            "type": "uuid",
            "primary_key": true,
            "generated": true
          },
          {
            "name": "employee_code",
            "type": "string"
          },
          {
            "name": "name",
            "type": "string"
          }
        ],
        "actions": [
          {
            "name": "read",
            "type": "read",
            "primary": true
          }
        ]
      },
      {
        "name": "Department",
        "description": "跨域引用 HR.Department（科室）",
        "aggregate_root": false,
        "attributes": [
          {
            "name": "id",
            "type": "uuid",
            "primary_key": true,
            "generated": true
          },
          {
            "name": "name",
            "type": "string"
          }
        ],
        "actions": [
          {
            "name": "read",
            "type": "read",
            "primary": true
          }
        ]
      },
      {
        "name": "ShiftType",
        "description": "班次类型定义（早班/中班/夜班等），是排班的基础维度",
        "aggregate_root": true,
        "attributes": [
          {
            "name": "id",
            "type": "uuid",
            "primary_key": true,
            "generated": true
          },
          {
            "name": "code",
            "type": "string",
            "required": true,
            "description": "班次编码，如 day, evening, night"
          },
          {
            "name": "name",
            "type": "string",
            "required": true,
            "description": "班次名称，如\"白班\"、\"小夜\"、\"大夜\""
          },
          {
            "name": "start_time",
            "type": "time",
            "required": true,
            "description": "班次开始时间，如 08:00"
          },
          {
            "name": "end_time",
            "type": "time",
            "required": true,
            "description": "班次结束时间，如 16:00"
          },
          {
            "name": "duration_hours",
            "type": "decimal",
            "required": true,
            "description": "时长（小时），跨午夜时 end < start"
          },
          {
            "name": "is_night",
            "type": "boolean",
            "required": true,
            "default": false,
            "description": "是否算夜班（影响夜班公平性约束）"
          },
          {
            "name": "color",
            "type": "string",
            "description": "前端显示色，如"
          },
          {
            "name": "sort_order",
            "type": "integer",
            "required": true,
            "default": 0,
            "description": "排序权重"
          },
          {
            "name": "enabled",
            "type": "boolean",
            "required": true,
            "default": true,
            "description": "是否启用"
          },
          {
            "name": "inserted_at",
            "type": "datetime",
            "generated": true
          },
          {
            "name": "updated_at",
            "type": "datetime",
            "generated": true
          }
        ],
        "relationships": [
          {
            "name": "department",
            "type": "belongs_to",
            "target": "Department",
            "foreign_key": "department_id",
            "required": true
          },
          {
            "name": "coverage_requirements",
            "type": "has_many",
            "target": "CoverageRequirement",
            "foreign_key": "shift_type_id"
          }
        ],
        "actions": [
          {
            "name": "create",
            "type": "create",
            "accept": [
              "code",
              "name",
              "start_time",
              "end_time",
              "duration_hours",
              "is_night",
              "color",
              "sort_order",
              "enabled"
            ],
            "primary": true
          },
          {
            "name": "update",
            "type": "update",
            "accept": [
              "name",
              "start_time",
              "end_time",
              "duration_hours",
              "is_night",
              "color",
              "sort_order",
              "enabled"
            ],
            "primary": true
          },
          {
            "name": "read",
            "type": "read",
            "primary": true
          },
          {
            "name": "destroy",
            "type": "destroy",
            "primary": true
          }
        ],
        "validations": [
          {
            "rule": "present",
            "field": "code",
            "on": [
              "create"
            ]
          },
          {
            "rule": "present",
            "field": "name",
            "on": [
              "create"
            ]
          }
        ],
        "identities": [
          {
            "name": "unique_dept_shift_code",
            "keys": [
              "department_id",
              "code"
            ]
          }
        ]
      },
      {
        "name": "SchedulingPeriod",
        "description": "一次科室月排班工作空间，承载需求、版本、求解运行",
        "aggregate_root": true,
        "attributes": [
          {
            "name": "id",
            "type": "uuid",
            "primary_key": true,
            "generated": true
          },
          {
            "name": "start_date",
            "type": "date",
            "required": true,
            "description": "周期开始日期（本地业务日）"
          },
          {
            "name": "end_date",
            "type": "date",
            "required": true,
            "description": "周期结束日期（本地业务日）"
          },
          {
            "name": "state",
            "type": "enum",
            "required": true,
            "default": "draft",
            "constraints": {
              "values": [
                "draft",
                "generating",
                "generated",
                "adjusted",
                "published"
              ]
            },
            "description": "排班周期状态"
          },
          {
            "name": "title",
            "type": "string",
            "description": "例如\"ICU 2026-04 月排班\""
          },
          {
            "name": "generation_mode",
            "type": "enum",
            "required": true,
            "default": "blank",
            "constraints": {
              "values": [
                "blank",
                "cloned_from_previous",
                "solver_seeded"
              ]
            },
            "description": "排班生成方式"
          },
          {
            "name": "notes",
            "type": "text",
            "description": "备注"
          },
          {
            "name": "inserted_at",
            "type": "datetime",
            "generated": true
          },
          {
            "name": "updated_at",
            "type": "datetime",
            "generated": true
          }
        ],
        "relationships": [
          {
            "name": "department",
            "type": "belongs_to",
            "target": "Department",
            "foreign_key": "department_id",
            "required": true
          },
          {
            "name": "source_period",
            "type": "belongs_to",
            "target": "SchedulingPeriod",
            "foreign_key": "source_period_id"
          },
          {
            "name": "source_version",
            "type": "belongs_to",
            "target": "ScheduleVersion",
            "foreign_key": "source_version_id"
          },
          {
            "name": "current_version",
            "type": "belongs_to",
            "target": "ScheduleVersion",
            "foreign_key": "current_version_id"
          },
          {
            "name": "published_version",
            "type": "belongs_to",
            "target": "ScheduleVersion",
            "foreign_key": "published_version_id"
          },
          {
            "name": "last_solver_run",
            "type": "belongs_to",
            "target": "SolverRun",
            "foreign_key": "last_solver_run_id"
          },
          {
            "name": "coverage_requirements",
            "type": "has_many",
            "target": "CoverageRequirement",
            "foreign_key": "period_id"
          },
          {
            "name": "schedule_versions",
            "type": "has_many",
            "target": "ScheduleVersion",
            "foreign_key": "period_id"
          },
          {
            "name": "solver_runs",
            "type": "has_many",
            "target": "SolverRun",
            "foreign_key": "period_id"
          },
          {
            "name": "shift_assignments",
            "type": "has_many",
            "target": "ShiftAssignment",
            "foreign_key": "period_id"
          },
          {
            "name": "constraint_violations",
            "type": "has_many",
            "target": "ConstraintViolation",
            "foreign_key": "period_id"
          }
        ],
        "actions": [
          {
            "name": "create",
            "type": "create",
            "accept": [
              "start_date",
              "end_date",
              "title",
              "notes",
              "generation_mode"
            ],
            "primary": true
          },
          {
            "name": "update",
            "type": "update",
            "accept": [
              "title",
              "notes"
            ],
            "primary": true
          },
          {
            "name": "read",
            "type": "read",
            "primary": true
          },
          {
            "name": "destroy",
            "type": "destroy",
            "primary": true
          },
          {
            "name": "start_generating",
            "type": "update",
            "accept": [],
            "description": "开始自动生成排班"
          },
          {
            "name": "mark_generated",
            "type": "update",
            "accept": [],
            "description": "求解完成，标记为已生成"
          },
          {
            "name": "mark_adjusted",
            "type": "update",
            "accept": [],
            "description": "人工调班后标记"
          },
          {
            "name": "publish",
            "type": "update",
            "accept": [],
            "description": "发布排班（需无 error 级违反）"
          }
        ],
        "validations": [
          {
            "rule": "compare",
            "field": "end_date",
            "params": {
              "greater_than": "start_date"
            },
            "message": "结束日期必须晚于开始日期"
          },
          {
            "rule": "one_of",
            "field": "state",
            "params": {
              "values": [
                "draft"
              ]
            },
            "on": [
              "start_generating"
            ],
            "message": "只有草稿状态可以开始生成"
          },
          {
            "rule": "one_of",
            "field": "state",
            "params": {
              "values": [
                "generated",
                "adjusted"
              ]
            },
            "on": [
              "publish"
            ],
            "message": "只有已生成或已调整状态可以发布"
          }
        ],
        "workflows": [
          {
            "name": "scheduling_period_lifecycle",
            "description": "排班周期生命周期",
            "steps": [
              {
                "action": "create",
                "next": [
                  "start_generating",
                  "update",
                  "destroy"
                ]
              },
              {
                "action": "start_generating",
                "next": [
                  "mark_generated"
                ]
              },
              {
                "action": "mark_generated",
                "next": [
                  "mark_adjusted",
                  "publish",
                  "start_generating"
                ]
              },
              {
                "action": "mark_adjusted",
                "next": [
                  "publish",
                  "start_generating"
                ]
              },
              {
                "action": "publish",
                "next": [
                  "start_generating"
                ]
              }
            ]
          }
        ]
      },
      {
        "name": "CoverageRequirement",
        "description": "定义某天某班次某岗位需要多少人",
        "aggregate_root": false,
        "attributes": [
          {
            "name": "id",
            "type": "uuid",
            "primary_key": true,
            "generated": true
          },
          {
            "name": "requirement_date",
            "type": "date",
            "required": true,
            "description": "需求日期（本地业务日）"
          },
          {
            "name": "role_code",
            "type": "string",
            "required": true,
            "description": "岗位编码，如 duty_nurse"
          },
          {
            "name": "role_name",
            "type": "string",
            "description": "岗位名称"
          },
          {
            "name": "required_skill_tags",
            "type": "jsonb",
            "default": [],
            "description": "所需技能标签，如 [\"ICU\"]"
          },
          {
            "name": "min_headcount",
            "type": "integer",
            "required": true,
            "description": "最低人数"
          },
          {
            "name": "target_headcount",
            "type": "integer",
            "description": "目标人数，不填时等于 min_headcount"
          },
          {
            "name": "required_lead_count",
            "type": "integer",
            "required": true,
            "default": 0,
            "description": "需要带班人数"
          },
          {
            "name": "priority",
            "type": "integer",
            "required": true,
            "default": 100,
            "description": "优先级，越小越高"
          },
          {
            "name": "notes",
            "type": "text",
            "description": "备注"
          },
          {
            "name": "inserted_at",
            "type": "datetime",
            "generated": true
          },
          {
            "name": "updated_at",
            "type": "datetime",
            "generated": true
          }
        ],
        "relationships": [
          {
            "name": "period",
            "type": "belongs_to",
            "target": "SchedulingPeriod",
            "foreign_key": "period_id",
            "required": true
          },
          {
            "name": "shift_type",
            "type": "belongs_to",
            "target": "ShiftType",
            "foreign_key": "shift_type_id",
            "required": true
          },
          {
            "name": "shift_assignments",
            "type": "has_many",
            "target": "ShiftAssignment",
            "foreign_key": "requirement_id"
          },
          {
            "name": "constraint_violations",
            "type": "has_many",
            "target": "ConstraintViolation",
            "foreign_key": "requirement_id"
          }
        ],
        "actions": [
          {
            "name": "create",
            "type": "create",
            "accept": [
              "requirement_date",
              "role_code",
              "role_name",
              "required_skill_tags",
              "min_headcount",
              "target_headcount",
              "required_lead_count",
              "priority",
              "notes"
            ],
            "primary": true
          },
          {
            "name": "update",
            "type": "update",
            "accept": [
              "role_name",
              "required_skill_tags",
              "min_headcount",
              "target_headcount",
              "required_lead_count",
              "priority",
              "notes"
            ],
            "primary": true
          },
          {
            "name": "read",
            "type": "read",
            "primary": true
          },
          {
            "name": "destroy",
            "type": "destroy",
            "primary": true
          }
        ],
        "validations": [
          {
            "rule": "present",
            "field": "requirement_date",
            "on": [
              "create"
            ]
          },
          {
            "rule": "present",
            "field": "role_code",
            "on": [
              "create"
            ]
          }
        ],
        "identities": [
          {
            "name": "unique_period_date_shift_role",
            "keys": [
              "period_id",
              "requirement_date",
              "shift_type_id",
              "role_code"
            ]
          }
        ]
      },
      {
        "name": "ScheduleVersion",
        "description": "一个周期内的工作版本或已发布版本",
        "aggregate_root": false,
        "attributes": [
          {
            "name": "id",
            "type": "uuid",
            "primary_key": true,
            "generated": true
          },
          {
            "name": "version_no",
            "type": "integer",
            "required": true,
            "description": "版本号"
          },
          {
            "name": "status",
            "type": "enum",
            "required": true,
            "default": "working",
            "constraints": {
              "values": [
                "working",
                "published",
                "archived"
              ]
            },
            "description": "版本状态"
          },
          {
            "name": "origin_type",
            "type": "enum",
            "required": true,
            "default": "manual",
            "constraints": {
              "values": [
                "manual",
                "solver",
                "cloned_from_previous"
              ]
            },
            "description": "版本来源类型"
          },
          {
            "name": "created_by",
            "type": "uuid",
            "description": "操作者"
          },
          {
            "name": "change_summary",
            "type": "text",
            "description": "版本说明"
          },
          {
            "name": "inserted_at",
            "type": "datetime",
            "generated": true
          },
          {
            "name": "updated_at",
            "type": "datetime",
            "generated": true
          }
        ],
        "relationships": [
          {
            "name": "period",
            "type": "belongs_to",
            "target": "SchedulingPeriod",
            "foreign_key": "period_id",
            "required": true
          },
          {
            "name": "based_on_run",
            "type": "belongs_to",
            "target": "SolverRun",
            "foreign_key": "based_on_run_id"
          },
          {
            "name": "source_version",
            "type": "belongs_to",
            "target": "ScheduleVersion",
            "foreign_key": "source_version_id"
          },
          {
            "name": "shift_assignments",
            "type": "has_many",
            "target": "ShiftAssignment",
            "foreign_key": "version_id"
          },
          {
            "name": "constraint_violations",
            "type": "has_many",
            "target": "ConstraintViolation",
            "foreign_key": "version_id"
          }
        ],
        "actions": [
          {
            "name": "create",
            "type": "create",
            "accept": [
              "version_no",
              "change_summary"
            ],
            "primary": true
          },
          {
            "name": "update",
            "type": "update",
            "accept": [
              "change_summary"
            ],
            "primary": true
          },
          {
            "name": "read",
            "type": "read",
            "primary": true
          },
          {
            "name": "publish_version",
            "type": "update",
            "accept": [],
            "description": "发布此版本"
          },
          {
            "name": "archive_version",
            "type": "update",
            "accept": [],
            "description": "归档此版本"
          }
        ],
        "validations": [
          {
            "rule": "one_of",
            "field": "status",
            "params": {
              "values": [
                "working"
              ]
            },
            "on": [
              "publish_version"
            ],
            "message": "只有工作中的版本可以发布"
          },
          {
            "rule": "one_of",
            "field": "status",
            "params": {
              "values": [
                "working",
                "published"
              ]
            },
            "on": [
              "archive_version"
            ],
            "message": "只有工作中或已发布的版本可以归档"
          }
        ],
        "identities": [
          {
            "name": "unique_period_version_no",
            "keys": [
              "period_id",
              "version_no"
            ]
          }
        ]
      },
      {
        "name": "ShiftAssignment",
        "description": "把某个覆盖需求分配给具体护士和时段",
        "aggregate_root": false,
        "attributes": [
          {
            "name": "id",
            "type": "uuid",
            "primary_key": true,
            "generated": true
          },
          {
            "name": "starts_at",
            "type": "datetime",
            "required": true,
            "description": "开始时间（UTC）"
          },
          {
            "name": "ends_at",
            "type": "datetime",
            "required": true,
            "description": "结束时间（UTC）"
          },
          {
            "name": "source",
            "type": "enum",
            "required": true,
            "default": "auto",
            "constraints": {
              "values": [
                "auto",
                "manual",
                "swapped",
                "copied"
              ]
            },
            "description": "分配来源（copied = 从上一期复制）"
          },
          {
            "name": "is_locked",
            "type": "boolean",
            "required": true,
            "default": false,
            "description": "锁定后重排不动"
          },
          {
            "name": "notes",
            "type": "text",
            "description": "人工调班说明"
          },
          {
            "name": "inserted_at",
            "type": "datetime",
            "generated": true
          },
          {
            "name": "updated_at",
            "type": "datetime",
            "generated": true
          }
        ],
        "relationships": [
          {
            "name": "period",
            "type": "belongs_to",
            "target": "SchedulingPeriod",
            "foreign_key": "period_id",
            "required": true
          },
          {
            "name": "requirement",
            "type": "belongs_to",
            "target": "CoverageRequirement",
            "foreign_key": "requirement_id",
            "required": true
          },
          {
            "name": "version",
            "type": "belongs_to",
            "target": "ScheduleVersion",
            "foreign_key": "version_id",
            "required": true
          },
          {
            "name": "employee",
            "type": "belongs_to",
            "target": "Employee",
            "foreign_key": "employee_id",
            "required": true
          },
          {
            "name": "baseline_run",
            "type": "belongs_to",
            "target": "SolverRun",
            "foreign_key": "baseline_run_id"
          },
          {
            "name": "constraint_violations",
            "type": "has_many",
            "target": "ConstraintViolation",
            "foreign_key": "assignment_id"
          }
        ],
        "actions": [
          {
            "name": "create",
            "type": "create",
            "accept": [
              "starts_at",
              "ends_at",
              "source",
              "is_locked",
              "notes"
            ],
            "primary": true
          },
          {
            "name": "update",
            "type": "update",
            "accept": [
              "starts_at",
              "ends_at",
              "source",
              "is_locked",
              "notes"
            ],
            "primary": true
          },
          {
            "name": "read",
            "type": "read",
            "primary": true
          },
          {
            "name": "destroy",
            "type": "destroy",
            "primary": true
          },
          {
            "name": "lock",
            "type": "update",
            "accept": [],
            "description": "锁定此排班，重排时不会变动"
          },
          {
            "name": "unlock",
            "type": "update",
            "accept": [],
            "description": "解锁此排班"
          }
        ],
        "validations": [
          {
            "rule": "compare",
            "field": "ends_at",
            "params": {
              "greater_than": "starts_at"
            },
            "message": "结束时间必须晚于开始时间"
          }
        ],
        "identities": [
          {
