{
  "version": 1,
  "page_id": "solver_result",
  "page_type": "composition",
  "entity": "SolverRun",
  "domain": "Scheduling",
  "backend": {
    "params": {
      "accept": ["id"]
    },
    "info": {
      "reload_messages": ["page_host_reload"]
    },
    "load": {
      "selection": "id title current_version: currentVersion { id version_no: versionNo origin_type: originType constraint_violations: constraintViolations { severity rule_code: ruleCode message } } last_solver_run: lastSolverRun { id status engine_type: engineType output_snapshot: outputSnapshot hard_violation_count: hardViolationCount warning_count: warningCount }",
      "assigns": {
        "period": "record",
        "run": {
          "from": "record.last_solver_run",
          "transform": "normalize_solver_run"
        },
        "version": "record.current_version",
        "violations": {
          "from": "record.current_version.constraint_violations",
          "transform": "normalize_list"
        },
        "has_hard_violations": {
          "from": "record.last_solver_run.hard_violation_count",
          "transform": "positive_count"
        },
        "violations_empty": {
          "from": "record.current_version.constraint_violations",
          "transform": "empty_list"
        }
      }
    },
    "api_map": {
      "__load__": "Scheduling.SchedulingPeriod.get",
      "get": "Scheduling.SchedulingPeriod.get"
    }
  },
  "state_transitions": [
    {
      "name": "navigate_back",
      "from": "*",
      "to": "*",
      "trigger": "user_action",
      "description": "返回周期详情"
    },
    {
      "name": "navigate_calendar",
      "from": "*",
      "to": "*",
      "trigger": "user_action",
      "description": "进入日历调班"
    },
    {
      "name": "navigate_publish_preview",
      "from": "*",
      "to": "*",
      "trigger": "user_action",
      "description": "进入发布预览"
    }
  ],
  "status_keys": [
    "period",
    "run",
    "has_hard_violations",
    "violations_empty",
    "violations"
  ],
  "e2e": {
    "playwright": {
      "auto": true,
      "base_path": "/scheduling/solver_result?id=:id",
      "dto_smoke": [],
      "cases": [
        {
          "name": "页面加载 + KPI 和违规表可见",
          "covers": [],
          "steps": [
            { "action": "expect_visible", "selector": "#page_title" },
            { "action": "expect_visible", "selector": "#run_status_badge" },
            { "action": "expect_visible", "selector": "#engine_info" },
            { "action": "expect_visible", "selector": "#violations_table" }
          ]
        },
        {
          "name": "跳转日历调班",
          "covers": ["navigate_calendar"],
          "steps": [
            { "action": "click", "selector": "#calendar_btn" },
            { "action": "expect_url_contains", "value": "/scheduling/calendar_adjustment" }
          ]
        },
        {
          "name": "跳转发布预览",
          "covers": ["navigate_publish_preview"],
          "steps": [
            { "action": "click", "selector": "#publish_btn" },
            { "action": "expect_url_contains", "value": "/scheduling/publish_preview" }
          ]
        }
      ]
    }
  }
}
