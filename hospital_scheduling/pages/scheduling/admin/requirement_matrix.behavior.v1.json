{
  "version": 1,
  "page_id": "requirement_matrix",
  "page_type": "composition",
  "entity": "CoverageRequirement",
  "domain": "Scheduling",
  "backend": {
    "api_map": {
      "list": "Scheduling.CoverageRequirement.list",
      "save_requirements": "Scheduling.CoverageRequirement.update",
      "batch_fill_requirements": "Scheduling.CoverageRequirement.update",
      "action_start_generating": "Scheduling.SchedulingPeriod.start_generating"
    }
  },
  "state_transitions": [
    {
      "name": "batch_fill_requirements",
      "from": "*",
      "to": "*",
      "trigger": "user_action",
      "description": "批量填充需求矩阵"
    },
    {
      "name": "save_requirements",
      "from": "*",
      "to": "loading",
      "trigger": "user_action",
      "description": "保存需求矩阵"
    },
    {
      "name": "action_start_generating",
      "from": "*",
      "to": "loading",
      "trigger": "user_action",
      "description": "开始自动排班"
    }
  ],
  "status_keys": [
    "page_title",
    "period",
    "rows",
    "rows_empty",
    "filter"
  ],
  "e2e": {
    "playwright": {
      "auto": true,
      "base_path": "/scheduling/requirement_matrix",
      "dto_smoke": [],
      "cases": [
        {
          "name": "页面加载 + 矩阵表格可见",
          "covers": [],
          "steps": [
            { "action": "expect_visible", "selector": "#req_matrix_table" },
            { "action": "expect_visible", "selector": "#page_title" },
            { "action": "expect_visible", "selector": "#state_badge" }
          ]
        },
        {
          "name": "批量填充需求",
          "covers": ["batch_fill_requirements"],
          "steps": [
            { "action": "click", "selector": "#batch_fill_btn" },
            { "action": "expect_visible", "selector": "#req_matrix_table" }
          ]
        },
        {
          "name": "保存需求",
          "covers": ["save_requirements"],
          "steps": [
            { "action": "click", "selector": "#save_btn" },
            { "action": "expect_text_contains", "selector": "#flash-group, [data-flash], [role='alert']", "value": "保存" }
          ]
        },
        {
          "name": "开始生成排班",
          "covers": ["action_start_generating"],
          "steps": [
            { "action": "click", "selector": "#start_btn" },
            { "action": "expect_text_contains", "selector": "#flash-group, [data-flash], [role='alert']", "value": "生成" }
          ]
        }
      ]
    }
  }
}
