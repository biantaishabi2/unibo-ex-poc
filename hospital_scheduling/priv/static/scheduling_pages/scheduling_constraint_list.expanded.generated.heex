<.page title="列表" id="scheduling_constraint_list">
  <.section layout="none" id="header">
    <.flex justify="between" align="center" direction="row" id="header_bar">
      <.text variant="title" id="page_title">
        <%= @page_title %>
      </.text>
      <.flex gap={2} direction="row" id="toolbar_actions">
        <.button variant="primary" phx-click="navigate_create" size="md" id="create_btn">
          新建约束
        </.button>
        <.button variant="secondary" phx-click="navigate_back" size="md" id="back_btn">
          返回周期详情
        </.button>
      </.flex>
    </.flex>
  </.section>
  <.section layout="none" id="filter_section">
    <.card variant="default" id="filter_card">
      <.card_content id="filter_content">
        <.flex gap={4} align="center" direction="row" id="filter_row">
          <.select name="constraint_type" label="约束类型" size="md" id="filter_constraint_type" options={[%{label: "全部", value: ""}, %{label: "硬约束", value: "hard"}, %{label: "软约束", value: "soft"}]}>

          </.select>
          <.select name="category" label="规则类别" size="md" id="filter_category" options={[%{label: "全部", value: ""}, %{label: "夜班后休息", value: "rest_after_night"}, %{label: "最大连续天数", value: "max_consecutive_days"}, %{label: "请假尊重", value: "respect_leave"}, %{label: "技能要求", value: "skill_requirement"}, %{label: "月度工时上限", value: "max_monthly_hours"}, %{label: "带班覆盖", value: "lead_coverage"}, %{label: "夜班公平", value: "fair_night_distribution"}, %{label: "周末公平", value: "fair_weekend_distribution"}, %{label: "偏好尊重", value: "respect_preference"}, %{label: "连续夜班限制", value: "limit_consecutive_nights"}, %{label: "班次连续性", value: "shift_continuity"}]}>

          </.select>
          <.select name="enabled" label="状态" size="md" id="filter_enabled" options={[%{label: "全部", value: ""}, %{label: "启用", value: "true"}, %{label: "停用", value: "false"}]}>

          </.select>
          <.button variant="secondary" phx-click="filter_submit" size="md" id="filter_submit">
            查询
          </.button>
        </.flex>
      </.card_content>
    </.card>
  </.section>
  <.section layout="none" id="table_section">
    <.table id="constraint_table">
      <.table_header id="constraint_header">
        <.table_row id="header_row">
          <.table_head id="th_name">
            规则名称
          </.table_head>
          <.table_head id="th_type">
            约束类型
          </.table_head>
          <.table_head id="th_category">
            规则类别
          </.table_head>
          <.table_head id="th_weight">
            权重
          </.table_head>
          <.table_head id="th_enabled">
            启用
          </.table_head>
          <.table_head id="th_notes">
            备注
          </.table_head>
          <.table_head id="th_actions">
            操作
          </.table_head>
        </.table_row>
      </.table_header>
      <.table_body id="constraint_body">
        <%= for row <- @rows do %>
          <.table_row>
            <.table_cell>
              <%= row.name %>
            </.table_cell>
            <.table_cell>
              <.badge variant="default" size="sm">
                <%= row.constraint_type %>
              </.badge>
            </.table_cell>
            <.table_cell>
              <.badge variant="secondary" size="sm">
                <%= row.category %>
              </.badge>
            </.table_cell>
            <.table_cell>
              <%= row.weight %>
            </.table_cell>
            <.table_cell>
              <.badge variant="default" size="sm">
                <%= row.enabled %>
              </.badge>
            </.table_cell>
            <.table_cell>
              <%= row.notes %>
            </.table_cell>
            <.table_cell>
              <.flex gap={1} direction="row">
                <.button variant="outline" size="sm" phx-click="navigate_edit">
                  编辑
                </.button>
                <.button variant="outline" size="sm" phx-click="toggle_enabled">
                  切换
                </.button>
                <.button variant="destructive" size="sm" phx-click="action_destroy">
                  删除
                </.button>
              </.flex>
            </.table_cell>
          </.table_row>
        <% end %>
      </.table_body>
    </.table>
  </.section>
  <.section layout="none" id="empty_section">
    <%= if (@rows_empty && @rows_empty != []) do %>
      <.empty_state description="暂无数据" id="no_data" />
    <% end %>
  </.section>
  <.section layout="none" id="footer">
    <.text id="pagination">
      分页
    </.text>
  </.section>
</.page>