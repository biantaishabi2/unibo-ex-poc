{
  "backend": {
    "api_map": {
      "destroy": "Scheduling.SchedulingPeriod.destroy",
      "get": "Scheduling.SchedulingPeriod.get",
      "mark_adjusted": "Scheduling.SchedulingPeriod.mark_adjusted",
      "mark_generated": "Scheduling.SchedulingPeriod.mark_generated",
      "publish": "Scheduling.SchedulingPeriod.publish",
      "start_generating": "Scheduling.SchedulingPeriod.start_generating",
      "update": "Scheduling.SchedulingPeriod.update"
    },
    "info": {
      "reload_messages": [
        "page_host_reload"
      ]
    },
    "load": {
      "assigns": {},
      "selection": "id title state generation_mode: generationMode department { name } start_date: startDate end_date: endDate current_version: currentVersion { id version_no: versionNo } last_solver_run: lastSolverRun { id status } schedule_versions: scheduleVersions { id version_no: versionNo status origin_type: originType change_summary: changeSummary } solver_runs: solverRuns { id engine_type: engineType status score hard_violation_count: hardViolationCount started_at: startedAt completed_at: completedAt }"
    },
    "params": {
      "accept": [
        "id"
      ]
    }
  },
  "e2e": {
    "playwright": {
      "auto": true,
      "base_path": "/scheduling/scheduling_period_detail?id=:id",
      "cases": [],
      "dto_smoke": []
    }
  },
  "layer": 2,
  "page_id": "scheduling_period_detail",
  "state_transitions": [
    {
      "description": "切换编辑模式",
      "from": "*",
      "name": "toggle_edit",
      "to": "*",
      "trigger": "user_action"
    },
    {
      "description": "取消编辑",
      "from": "*",
      "name": "cancel_edit",
      "to": "*",
      "trigger": "user_action"
    },
    {
      "description": "表单字段变更",
      "from": "*",
      "name": "form_change",
      "to": "*",
      "trigger": "user_input"
    },
    {
      "description": "提交表单",
      "from": "editing",
      "name": "form_submit",
      "to": "loading",
      "trigger": "user_action"
    },
    {
      "description": "开始自动生成排班",
      "from": "*",
      "name": "action_start_generating",
      "to": "loading",
      "trigger": "user_action"
    },
    {
      "description": "求解完成，标记为已生成",
      "from": "*",
      "name": "action_mark_generated",
      "to": "loading",
      "trigger": "user_action"
    },
    {
      "description": "人工调班后标记",
      "from": "*",
      "name": "action_mark_adjusted",
      "to": "loading",
      "trigger": "user_action"
    },
    {
      "description": "发布排班（需无 error 级违反）",
      "from": "*",
      "name": "action_publish",
      "to": "loading",
      "trigger": "user_action"
    },
    {
      "description": "删除记录",
      "from": "*",
      "name": "action_destroy",
      "to": "loading",
      "trigger": "user_action"
    }
  ],
  "version": 1
}