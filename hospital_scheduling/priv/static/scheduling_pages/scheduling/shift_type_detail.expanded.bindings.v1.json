{
  "version": 1,
  "vars": {
    "record.name": {
      "uses": [
        {
          "node_type": "BreadcrumbPage",
          "node_id": "shift_type_bc_current",
          "location": "prop",
          "prop": "content",
          "template": "{{record.name|详情}}"
        },
        {
          "node_type": "Text",
          "node_id": "shift_type_detail_title",
          "location": "prop",
          "prop": "content",
          "template": "{{record.name|}}"
        },
        {
          "node_type": "Text",
          "node_id": "value_name",
          "location": "prop",
          "prop": "content",
          "template": "{{record.name|}}"
        }
      ]
    },
    "record.code": {
      "uses": [
        {
          "node_type": "Text",
          "node_id": "value_code",
          "location": "prop",
          "prop": "content",
          "template": "{{record.code|}}"
        }
      ]
    },
    "record.start_time": {
      "uses": [
        {
          "node_type": "Text",
          "node_id": "value_start_time",
          "location": "prop",
          "prop": "content",
          "template": "{{record.start_time|}}"
        }
      ]
    },
    "record.end_time": {
      "uses": [
        {
          "node_type": "Text",
          "node_id": "value_end_time",
          "location": "prop",
          "prop": "content",
          "template": "{{record.end_time|}}"
        }
      ]
    },
    "record.duration_hours": {
      "uses": [
        {
          "node_type": "Text",
          "node_id": "value_duration_hours",
          "location": "prop",
          "prop": "content",
          "template": "{{record.duration_hours|}}"
        }
      ]
    },
    "record.is_night": {
      "uses": [
        {
          "node_type": "Badge",
          "node_id": "value_is_night",
          "location": "prop",
          "prop": "content",
          "template": "{{record.is_night|}}"
        }
      ]
    },
    "record.color": {
      "uses": [
        {
          "node_type": "Text",
          "node_id": "value_color",
          "location": "prop",
          "prop": "content",
          "template": "{{record.color|}}"
        }
      ]
    },
    "record.sort_order": {
      "uses": [
        {
          "node_type": "Text",
          "node_id": "value_sort_order",
          "location": "prop",
          "prop": "content",
          "template": "{{record.sort_order|}}"
        }
      ]
    },
    "record.enabled": {
      "uses": [
        {
          "node_type": "Badge",
          "node_id": "value_enabled",
          "location": "prop",
          "prop": "content",
          "template": "{{record.enabled|}}"
        }
      ]
    }
  },
  "events": {
    "toggle_edit": {
      "triggers": [
        {
          "node_type": "Button",
          "node_id": "shift_type_edit_btn",
          "prop": "click",
          "raw": "toggle_edit"
        }
      ]
    },
    "action_destroy": {
      "triggers": [
        {
          "node_type": "Button",
          "node_id": "shift_type_delete_btn",
          "prop": "click",
          "raw": "action_destroy"
        }
      ]
    },
    "form_submit": {
      "triggers": [
        {
          "node_type": "Form",
          "node_id": "shift_type_edit_form",
          "prop": "submit",
          "raw": "form_submit"
        },
        {
          "node_type": "Button",
          "node_id": "shift_type_save_btn",
          "prop": "click",
          "raw": "form_submit"
        }
      ]
    },
    "form_change": {
      "triggers": [
        {
          "node_type": "Form",
          "node_id": "shift_type_edit_form",
          "prop": "change",
          "raw": "form_change"
        }
      ]
    },
    "cancel_edit": {
      "triggers": [
        {
          "node_type": "Button",
          "node_id": "shift_type_cancel_btn",
          "prop": "click",
          "raw": "cancel_edit"
        }
      ]
    }
  }
}