{
  "version": 1,
  "defaults": {
    "period": {
      "title": "需求矩阵",
      "state": "",
      "start_date": "",
      "end_date": ""
    },
    "shift_types": [
      {
        "name": "shift_type_1",
        "requirements": [
          {
            "min_headcount": "",
            "target_headcount": ""
          },
          {
            "min_headcount": "",
            "target_headcount": ""
          }
        ]
      },
      {
        "name": "shift_type_2",
        "requirements": [
          {
            "min_headcount": "",
            "target_headcount": ""
          },
          {
            "min_headcount": "",
            "target_headcount": ""
          }
        ]
      },
      {
        "name": "shift_type_3",
        "requirements": [
          {
            "min_headcount": "",
            "target_headcount": ""
          },
          {
            "min_headcount": "",
            "target_headcount": ""
          }
        ]
      }
    ],
    "record": {
      "role_code": ""
    }
  },
  "keys": [
    "period",
    "period.end_date",
    "period.start_date",
    "period.state",
    "period.title",
    "record",
    "record.role_code",
    "shift_types",
    "shift_types[]",
    "shift_types[].name",
    "shift_types[].requirements",
    "shift_types[].requirements[]",
    "shift_types[].requirements[].min_headcount",
    "shift_types[].requirements[].target_headcount"
  ],
  "required": [
    "period",
    "record",
    "shift_types"
  ],
  "urlParams": {},
  "notes": [],
  "layer2": {
    "backend": {
      "api_map": {
        "__load__": "Scheduling.SchedulingPeriod.get",
        "action_start_generating": "Scheduling.SchedulingPeriod.start_generating",
        "batch_fill_requirements": "Scheduling.CoverageRequirement.update",
        "get": "Scheduling.SchedulingPeriod.get",
        "list": "Scheduling.CoverageRequirement.list",
        "save_requirements": "Scheduling.CoverageRequirement.update"
      },
      "info": {
        "reload_messages": [
          "page_host_reload"
        ]
      },
      "load": {
        "assigns": {
          "period": "record",
          "shift_types": {
            "from": "record.coverage_requirements",
            "transform": "group_requirements_by_shift_type"
          }
        },
        "selection": "id title state start_date: startDate end_date: endDate coverage_requirements: coverageRequirements { id requirement_date: requirementDate role_code: roleCode role_name: roleName min_headcount: minHeadcount target_headcount: targetHeadcount shift_type: shiftType { id name } }"
      },
      "params": {
        "accept": [
          "id",
          "role_code",
          "week_offset",
          "shift_type_id"
        ]
      }
    },
    "domain": "Scheduling",
    "e2e": {
      "playwright": {
        "auto": true,
        "base_path": "/scheduling/requirement_matrix",
        "cases": [
          {
            "covers": [],
            "name": "页面加载 + 矩阵表格可见",
            "steps": [
              {
                "action": "expect_visible",
                "selector": "#req_matrix_table"
              },
              {
                "action": "expect_visible",
                "selector": "#page_title"
              },
              {
                "action": "expect_visible",
                "selector": "#state_badge"
              }
            ]
          },
          {
            "covers": [
              "batch_fill_requirements"
            ],
            "name": "批量填充需求",
            "steps": [
              {
                "action": "click",
                "selector": "#batch_fill_btn"
              },
              {
                "action": "expect_visible",
                "selector": "#req_matrix_table"
              }
            ]
          },
          {
            "covers": [
              "save_requirements"
            ],
            "name": "保存需求",
            "steps": [
              {
                "action": "click",
                "selector": "#save_btn"
              },
              {
                "action": "expect_text_contains",
                "selector": "#flash-group, [data-flash], [role='alert']",
                "value": "保存"
              }
            ]
          },
          {
            "covers": [
              "action_start_generating"
            ],
            "name": "开始生成排班",
            "steps": [
              {
                "action": "click",
                "selector": "#start_btn"
              },
              {
                "action": "expect_text_contains",
                "selector": "#flash-group, [data-flash], [role='alert']",
                "value": "生成"
              }
            ]
          }
        ],
        "dto_smoke": []
      }
    },
    "entity": "CoverageRequirement",
    "page_id": "requirement_matrix",
    "page_type": "composition",
    "state_transitions": [
      {
        "description": "批量填充需求矩阵",
        "from": "*",
        "name": "batch_fill_requirements",
        "to": "*",
        "trigger": "user_action"
      },
      {
        "description": "保存需求矩阵",
        "from": "*",
        "name": "save_requirements",
        "to": "loading",
        "trigger": "user_action"
      },
      {
        "description": "开始自动排班",
        "from": "*",
        "name": "action_start_generating",
        "to": "loading",
        "trigger": "user_action"
      }
    ],
    "status_keys": [
      "page_title",
      "period",
      "rows",
      "rows_empty",
      "filter"
    ],
    "version": 1
  }
}