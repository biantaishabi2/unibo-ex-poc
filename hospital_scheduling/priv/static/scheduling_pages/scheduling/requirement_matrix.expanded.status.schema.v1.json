  "urlParams": {},
  "notes": [],
  "layer2": {
    "version": 1,
    "page_id": "requirement_matrix",
    "entity": "CoverageRequirement",
    "domain": "Scheduling",
    "e2e": {
      "playwright": {
        "auto": true,
        "base_path": "/scheduling/requirement_matrix",
        "dto_smoke": [],
        "cases": [
          {
            "name": "页面加载 + 矩阵表格可见",
            "covers": [],
            "steps": [
              {
                "action": "expect_visible",
                "selector": "#req_matrix_table"
              },
              {
                "action": "expect_visible",
                "selector": "#page_title"
              },
              {
                "action": "expect_visible",
                "selector": "#state_badge"
              }
            ]
          },
          {
            "name": "批量填充需求",
            "covers": [
              "batch_fill_requirements"
            ],
            "steps": [
              {
                "action": "click",
                "selector": "#batch_fill_btn"
              },
              {
                "action": "expect_visible",
                "selector": "#req_matrix_table"
              }
            ]
          },
          {
            "name": "保存需求",
            "covers": [
              "save_requirements"
            ],
            "steps": [
              {
                "action": "click",
                "selector": "#save_btn"
              },
              {
                "action": "expect_text_contains",
                "selector": "#flash-group, [data-flash], [role='alert']",
                "value": "保存"
              }
            ]
          },
          {
            "name": "开始生成排班",
            "covers": [
              "action_start_generating"
            ],
            "steps": [
              {
                "action": "click",
                "selector": "#start_btn"
              },
              {
                "action": "expect_text_contains",
                "selector": "#flash-group, [data-flash], [role='alert']",
                "value": "生成"
              }
            ]
          }
        ]
      }
    }
  }
}