{
  "version": 1,
  "vars": {
    "record.title": {
      "uses": [
        {
          "node_type": "BreadcrumbPage",
          "node_id": "scheduling_period_bc_current",
          "location": "prop",
          "prop": "content",
          "template": "{{record.title|详情}}"
        },
        {
          "node_type": "Text",
          "node_id": "scheduling_period_detail_title",
          "location": "prop",
          "prop": "content",
          "template": "{{record.title|}}"
        },
        {
          "node_type": "Text",
          "node_id": "value_title",
          "location": "prop",
          "prop": "content",
          "template": "{{record.title|}}"
        }
      ]
    },
    "record.state": {
      "uses": [
        {
          "node_type": "Badge",
          "node_id": "scheduling_period_status_badge",
          "location": "prop",
          "prop": "content",
          "template": "{{record.state|}}"
        },
        {
          "node_type": "Badge",
          "node_id": "value_state",
          "location": "prop",
          "prop": "content",
          "template": "{{record.state|}}"
        }
      ]
    },
    "record.start_date": {
      "uses": [
        {
          "node_type": "Text",
          "node_id": "value_start_date",
          "location": "prop",
          "prop": "content",
          "template": "{{record.start_date|}}"
        }
      ]
    },
    "record.end_date": {
      "uses": [
        {
          "node_type": "Text",
          "node_id": "value_end_date",
          "location": "prop",
          "prop": "content",
          "template": "{{record.end_date|}}"
        }
      ]
    },
    "record.generation_mode": {
      "uses": [
        {
          "node_type": "Badge",
          "node_id": "value_generation_mode",
          "location": "prop",
          "prop": "content",
          "template": "{{record.generation_mode|}}"
        }
      ]
    },
    "record.notes": {
      "uses": [
        {
          "node_type": "Text",
          "node_id": "value_notes",
          "location": "prop",
          "prop": "content",
          "template": "{{record.notes|}}"
        }
      ]
    }
  },
  "events": {
    "toggle_edit": {
      "triggers": [
        {
          "node_type": "Button",
          "node_id": "scheduling_period_edit_btn",
          "prop": "click",
          "raw": "toggle_edit"
        }
      ]
    },
    "action_start_generating": {
      "triggers": [
        {
          "node_type": "Button",
          "node_id": "scheduling_period_action_start_generating",
          "prop": "click",
          "raw": "action_start_generating"
        }
      ]
    },
    "action_mark_generated": {
      "triggers": [
        {
          "node_type": "Button",
          "node_id": "scheduling_period_action_mark_generated",
          "prop": "click",
          "raw": "action_mark_generated"
        }
      ]
    },
    "action_publish": {
      "triggers": [
        {
          "node_type": "Button",
          "node_id": "scheduling_period_action_publish",
          "prop": "click",
          "raw": "action_publish"
        }
      ]
    },
    "action_destroy": {
      "triggers": [
        {
          "node_type": "Button",
          "node_id": "scheduling_period_delete_btn",
          "prop": "click",
          "raw": "action_destroy"
        }
      ]
    },
    "form_submit": {
      "triggers": [
        {
          "node_type": "Form",
          "node_id": "scheduling_period_edit_form",
          "prop": "submit",
          "raw": "form_submit"
        },
        {
          "node_type": "Button",
          "node_id": "scheduling_period_save_btn",
          "prop": "click",
          "raw": "form_submit"
        }
      ]
    },
    "form_change": {
      "triggers": [
        {
          "node_type": "Form",
          "node_id": "scheduling_period_edit_form",
          "prop": "change",
          "raw": "form_change"
        }
      ]
    },
    "cancel_edit": {
      "triggers": [
        {
          "node_type": "Button",
          "node_id": "scheduling_period_cancel_btn",
          "prop": "click",
          "raw": "cancel_edit"
        }
      ]
    }
  }
}