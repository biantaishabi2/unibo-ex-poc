<.page title="SchedulingPeriod 列表" id="scheduling_period_list">
  <.section direction="row" justify="between" align="center" layout="grid" columns={2} id="scheduling_period_header">
    <.text variant="title" id="scheduling_period_title">
      <%= @page_title %>
    </.text>
    <.button variant="primary" phx-click="navigate_create" size="md" id="scheduling_period_create_btn">
      新建
    </.button>
  </.section>
  <.card variant="default" id="scheduling_period_filter_card">
    <.card_content id="scheduling_period_filter_content">
      <.flex gap={4} align="center" direction="row" id="scheduling_period_filter_row">
        <.input name="start_date_from" label="周期开始日期（本地业务日） 起" size="md" id="filter_start_date_from" />
        <.input name="start_date_to" label="周期开始日期（本地业务日） 止" size="md" id="filter_start_date_to" />
        <.input name="end_date_from" label="周期结束日期（本地业务日） 起" size="md" id="filter_end_date_from" />
        <.input name="end_date_to" label="周期结束日期（本地业务日） 止" size="md" id="filter_end_date_to" />
        <.select name="state" label="排班周期状态" size="md" id="filter_state">

        </.select>
        <.select name="generation_mode" label="排班生成方式" size="md" id="filter_generation_mode">

        </.select>
        <.button variant="secondary" phx-click="filter_submit" size="md" id="scheduling_period_filter_submit">
          查询
        </.button>
      </.flex>
    </.card_content>
  </.card>
  <.table id="scheduling_period_table">
    <.table_header id="scheduling_period_table_header">
      <.table_row id="scheduling_period_header_row">
        <.table_head id="th_start_date">
          周期开始日期（本地业务日）
        </.table_head>
        <.table_head id="th_end_date">
          周期结束日期（本地业务日）
        </.table_head>
        <.table_head id="th_state">
          排班周期状态
        </.table_head>
        <.table_head id="th_title">
          例如'ICU 2026-04 月排班'
        </.table_head>
        <.table_head id="th_generation_mode">
          排班生成方式
        </.table_head>
        <.table_head id="th_notes">
          备注
        </.table_head>
        <.table_head id="scheduling_period_th_actions">
          操作
        </.table_head>
      </.table_row>
    </.table_header>
    <.table_body id="scheduling_period_table_body">
      <%= for row <- (@rows || []) do %>
        <.table_row>
          <.table_cell>
            <%= get_in(row, [:start_date]) || "" %>
          </.table_cell>
          <.table_cell>
            <%= get_in(row, [:end_date]) || "" %>
          </.table_cell>
          <.table_cell>
            <.badge variant="default" size="sm">
              <%= get_in(row, [:state]) || "" %>
            </.badge>
          </.table_cell>
          <.table_cell>
            <%= get_in(row, [:title]) || "" %>
          </.table_cell>
          <.table_cell>
            <.badge variant="default" size="sm">
              <%= get_in(row, [:generation_mode]) || "" %>
            </.badge>
          </.table_cell>
          <.table_cell>
            <%= get_in(row, [:notes]) || "" %>
          </.table_cell>
          <.table_cell>
            <.link patch={"/pages/scheduling/scheduling_period/#{get_in(row, [:id])}"} id="scheduling_period_view_btn" variant="link" size="sm">
              查看
            </.link>
          </.table_cell>
        </.table_row>
      <% end %>
    </.table_body>
  </.table>
  <%= if (@rows_empty && @rows_empty != []) do %>
    <.empty_state description="暂无一次科室月排班工作空间,承载需求、版本、求解运行数据" id="scheduling_period_no_data" />
  <% end %>
</.page>