<.page title="ShiftType 详情" id="shift_type_detail">
  <.breadcrumb id="shift_type_breadcrumb">
    <.breadcrumb_list id="shift_type_bc_list">
      <.breadcrumb_item id="shift_type_bc_list_item">
        <.breadcrumb_link id="shift_type_bc_link">
          ShiftType 列表
        </.breadcrumb_link>
      </.breadcrumb_item>
      <.breadcrumb_separator id="shift_type_bc_sep" />
      <.breadcrumb_item id="shift_type_bc_current_item">
        <.breadcrumb_page id="shift_type_bc_current">
          <%= @record.name %>
        </.breadcrumb_page>
      </.breadcrumb_item>
    </.breadcrumb_list>
  </.breadcrumb>
  <.section direction="row" justify="between" align="center" layout="grid" columns={2} id="shift_type_detail_header">
    <.flex gap={3} align="center" direction="row" id="shift_type_title_group">
      <.text variant="title" id="shift_type_detail_title">
        <%= @record.name %>
      </.text>
    </.flex>
    <.flex gap={2} direction="row" id="shift_type_actions">
      <.button variant="secondary" phx-click="toggle_edit" size="md" id="shift_type_edit_btn">
        编辑
      </.button>
      <.button variant="danger" phx-click="action_destroy" size="md" id="shift_type_delete_btn">
        删除
      </.button>
    </.flex>
  </.section>
  <.card variant="default" id="shift_type_info_card">
    <.card_header id="shift_type_info_header">
      <.card_title id="shift_type_info_title">
        基本信息
      </.card_title>
    </.card_header>
    <.card_content id="shift_type_info_content">
      <%= if !(@editing && @editing != []) do %>
        <.grid columns={2} gap={4} id="shift_type_info_grid">
          <.flex direction="row" id="field_code">
            <.text variant="muted" id="label_code">
              班次编码,如 day, evening, night
            </.text>
            <.text id="value_code">
              <%= @record.code %>
            </.text>
          </.flex>
          <.flex direction="row" id="field_name">
            <.text variant="muted" id="label_name">
              班次名称,如'白班'、'小夜'、'大夜'
            </.text>
            <.text id="value_name">
              <%= @record.name %>
            </.text>
          </.flex>
          <.flex direction="row" id="field_start_time">
            <.text variant="muted" id="label_start_time">
              班次开始时间,如 08:00
            </.text>
            <.text id="value_start_time">
              <%= @record.start_time %>
            </.text>
          </.flex>
          <.flex direction="row" id="field_end_time">
            <.text variant="muted" id="label_end_time">
              班次结束时间,如 16:00
            </.text>
            <.text id="value_end_time">
              <%= @record.end_time %>
            </.text>
          </.flex>
          <.flex direction="row" id="field_duration_hours">
            <.text variant="muted" id="label_duration_hours">
              时长（小时）,跨午夜时 end &lt; start
            </.text>
            <.text id="value_duration_hours">
              <%= @record.duration_hours %>
            </.text>
          </.flex>
          <.flex direction="row" id="field_is_night">
            <.text variant="muted" id="label_is_night">
              是否算夜班（影响夜班公平性约束）
            </.text>
            <.badge variant="default" size="sm" id="value_is_night">
              <%= @record.is_night %>
            </.badge>
          </.flex>
          <.flex direction="row" id="field_color">
            <.text variant="muted" id="label_color">
              前端显示色,如
            </.text>
            <.text id="value_color">
              <%= @record.color %>
            </.text>
          </.flex>
          <.flex direction="row" id="field_sort_order">
            <.text variant="muted" id="label_sort_order">
              排序权重
            </.text>
            <.text id="value_sort_order">
              <%= @record.sort_order %>
            </.text>
          </.flex>
          <.flex direction="row" id="field_enabled">
            <.text variant="muted" id="label_enabled">
              是否启用
            </.text>
            <.badge variant="default" size="sm" id="value_enabled">
              <%= @record.enabled %>
            </.badge>
          </.flex>
        </.grid>
      <% else %>
        <.form phx-submit="form_submit" phx-change="form_change" id="shift_type_edit_form">
          <.grid columns={2} gap={4} id="shift_type_form_grid">
            <.input name="code" label="班次编码,如 day, evening, night" placeholder="请输入班次编码,如 day, evening, night" required="true" size="md" id="form_code" />
            <.input name="name" label="班次名称,如'白班'、'小夜'、'大夜'" placeholder="请输入班次名称,如'白班'、'小夜'、'大夜'" required="true" size="md" id="form_name" />
            <.input name="start_time" label="班次开始时间,如 08:00" placeholder="请输入班次开始时间,如 08:00" required="true" size="md" id="form_start_time" />
            <.input name="end_time" label="班次结束时间,如 16:00" placeholder="请输入班次结束时间,如 16:00" required="true" size="md" id="form_end_time" />
            <.input name="duration_hours" label="时长（小时）,跨午夜时 end &lt; start" placeholder="请输入时长（小时）,跨午夜时 end &lt; start" required="true" size="md" id="form_duration_hours" />
            <.switch name="is_night" label="是否算夜班（影响夜班公平性约束）" size="md" id="form_is_night" />
            <.input name="color" label="前端显示色,如" placeholder="请输入前端显示色,如" size="md" id="form_color" />
            <.input name="sort_order" label="排序权重" placeholder="请输入排序权重" required="true" size="md" id="form_sort_order" />
            <.switch name="enabled" label="是否启用" size="md" id="form_enabled" />
          </.grid>
          <.flex justify="end" gap={2} direction="row" id="shift_type_form_actions">
            <.button variant="secondary" phx-click="cancel_edit" size="md" id="shift_type_cancel_btn">
              取消
            </.button>
            <.button variant="primary" phx-click="form_submit" size="md" id="shift_type_save_btn">
              保存
            </.button>
          </.flex>
        </.form>
      <% end %>
    </.card_content>
  </.card>
  <.card variant="default" id="shift_type_coverage_requirement_card">
    <.card_header id="coverage_requirement_card_header">
      <.card_title id="coverage_requirement_card_title">
        定义某天某班次某岗位需要多少人
      </.card_title>
    </.card_header>
    <.card_content id="coverage_requirement_card_content">
      <.table id="shift_type_coverage_requirement_table">
        <.table_header id="coverage_requirement_table_header">
          <.table_row id="coverage_requirement_header_row">
            <.table_head id="coverage_requirement_th_requirement_date">
              需求日期（本地业务日）
            </.table_head>
            <.table_head id="coverage_requirement_th_role_code">
              岗位编码,如 duty_nurse
            </.table_head>
            <.table_head id="coverage_requirement_th_role_name">
              岗位名称
            </.table_head>
            <.table_head id="coverage_requirement_th_required_skill_tags">
              所需技能标签,如 ['ICU']
            </.table_head>
            <.table_head id="coverage_requirement_th_min_headcount">
              最低人数
            </.table_head>
            <.table_head id="coverage_requirement_th_target_headcount">
              目标人数,不填时等于 min_headcount
            </.table_head>
            <.table_head id="coverage_requirement_th_required_lead_count">
              需要带班人数
            </.table_head>
            <.table_head id="coverage_requirement_th_priority">
              优先级,越小越高
            </.table_head>
            <.table_head id="coverage_requirement_th_notes">
              备注
            </.table_head>
          </.table_row>
        </.table_header>
        <.table_body id="coverage_requirement_table_body">
          <%= for item <- @record.coverage_requirements do %>
            <.table_row>
              <.table_cell>
                <%= item.requirement_date %>
              </.table_cell>
              <.table_cell>
                <%= item.role_code %>
              </.table_cell>
              <.table_cell>
                <%= item.role_name %>
              </.table_cell>
              <.table_cell>
                <%= item.required_skill_tags %>
              </.table_cell>
              <.table_cell>
                <%= item.min_headcount %>
              </.table_cell>
              <.table_cell>
                <%= item.target_headcount %>
              </.table_cell>
              <.table_cell>
                <%= item.required_lead_count %>
              </.table_cell>
              <.table_cell>
                <%= item.priority %>
              </.table_cell>
              <.table_cell>
                <%= item.notes %>
              </.table_cell>
            </.table_row>
          <% end %>
        </.table_body>
      </.table>
    </.card_content>
  </.card>
</.page>