{
  "version": 1,
  "vars": {
    "period.title": {
      "uses": [
        {
          "node_type": "Text",
          "node_id": "page_title",
          "location": "prop",
          "prop": "content",
          "template": "排班结果 — {{period.title|}}"
        }
      ]
    },
    "run.status": {
      "uses": [
        {
          "node_type": "Badge",
          "node_id": "run_status_badge",
          "location": "prop",
          "prop": "content",
          "template": "{{run.status|}}"
        }
      ]
    },
    "run.engine_type": {
      "uses": [
        {
          "node_type": "Text",
          "node_id": "engine_info",
          "location": "prop",
          "prop": "content",
          "template": "算法: {{run.engine_type|}}"
        }
      ]
    },
    "run.output_snapshot.summary.assignment_count": {
      "uses": [
        {
          "node_type": "Text",
          "node_id": "kpi_assignments_value",
          "location": "prop",
          "prop": "content",
          "template": "{{run.output_snapshot.summary.assignment_count|}}"
        }
      ]
    },
    "run.output_snapshot.summary.covered_requirement_count": {
      "uses": [
        {
          "node_type": "Text",
          "node_id": "kpi_covered_value",
          "location": "prop",
          "prop": "content",
          "template": "{{run.output_snapshot.summary.covered_requirement_count|}}"
        }
      ]
    },
    "run.hard_violation_count": {
      "uses": [
        {
          "node_type": "Alert",
          "node_id": "error_alert",
          "location": "prop",
          "prop": "description",
          "template": "有 {{run.hard_violation_count|}} 个硬约束违反需要处理,建议进入日历调班页手动调整."
        },
        {
          "node_type": "Text",
          "node_id": "kpi_errors_value",
          "location": "prop",
          "prop": "content",
          "template": "{{run.hard_violation_count|}}"
        }
      ]
    },
    "run.warning_count": {
      "uses": [
        {
          "node_type": "Text",
          "node_id": "kpi_warnings_value",
          "location": "prop",
          "prop": "content",
          "template": "{{run.warning_count|}}"
        }
      ]
    }
  },
  "events": {
    "navigate_back": {
      "triggers": [
        {
          "node_type": "Button",
          "node_id": "back_btn",
          "prop": "click",
          "raw": "navigate_back"
        }
      ]
    },
    "navigate_calendar": {
      "triggers": [
        {
          "node_type": "Button",
          "node_id": "calendar_btn",
          "prop": "click",
          "raw": "navigate_calendar"
        }
      ]
    },
    "navigate_publish_preview": {
      "triggers": [
        {
          "node_type": "Button",
          "node_id": "publish_btn",
          "prop": "click",
          "raw": "navigate_publish_preview"
        }
      ]
    }
  }
}