<.page title="发布预览" id="publish_preview">
  <.section layout="none" id="header">
    <.flex justify="between" align="center" direction="row" id="header_bar">
      <.stack gap={1} direction="column" id="title_group">
        <.text variant="title" id="page_title">
          发布预览 — <%= @period.title %>
        </.text>
        <.flex gap={2} direction="row" id="subtitle_row">
          <.badge variant="default" size="sm" id="version_badge">
            v<%= @version.version_no %>
          </.badge>
          <.select bind="schedule_version.origin_type" size="md" id="origin_badge">
            <option value="manual">manual</option>
            <option value="solver">solver</option>
            <option><%= @version.origin_type %></option>
          </.select>
        </.flex>
      </.stack>
      <.button variant="secondary" phx-click="navigate_back" size="md" id="back_btn">
        返回日历调班
      </.button>
    </.flex>
  </.section>
  <.section layout="grid" columns={2} id="error_guard_section">
    <%= if (@has_hard_violations && @has_hard_violations != []) do %>
      <.alert variant="destructive" title="无法发布" description={"当前版本存在 #{@hard_violation_count} 个硬约束违反,必须全部解决后才能发布.请返回日历调班页手动调整."} id="block_alert" />
    <% end %>
    <%= if (@has_warnings && @has_warnings != []) do %>
      <.alert variant="warning" title="存在警告" description={"有 #{@warning_count} 个软约束警告,可选择忽略并继续发布."} id="warn_alert" />
    <% end %>
  </.section>
  <.section layout="none" id="diff_section">
    <.card variant="default" id="diff_card">
      <.card_header id="diff_header">
        <.flex justify="between" align="center" direction="row" id="diff_toolbar">
          <.card_title id="diff_title">
            变更对比
          </.card_title>
          <.flex gap={2} direction="row" id="diff_controls">
            <.select name="base_version" label="对比基准" size="md" id="diff_base" value={@record.base_version}>

            </.select>
            <.button variant="outline" size="sm" phx-click="toggle_diff_mode" id="toggle_diff_btn">
              切换视图
            </.button>
          </.flex>
        </.flex>
      </.card_header>
      <.card_content id="diff_content">
        <.table id="diff_table">
          <.table_header id="diff_table_header">
            <.table_row id="diff_header_row">
              <.table_head id="th_employee">
                员工
              </.table_head>
              <.table_head id="th_date">
                日期
              </.table_head>
              <.table_head id="th_old_shift">
                原班次
              </.table_head>
              <.table_head id="th_new_shift">
                新班次
              </.table_head>
              <.table_head id="th_reason">
                变更原因
              </.table_head>
            </.table_row>
          </.table_header>
          <.table_body id="diff_table_body">
            <%= for change <- @changes do %>
              <.table_row>
                <.table_cell>
                  <%= (change[:employee] || %{})[:name] %>
                </.table_cell>
                <.table_cell>
                  <%= change.date %>
                </.table_cell>
                <.table_cell>
                  <.badge variant="secondary" size="sm">
                    <%= change.old_shift_type %>
                  </.badge>
                </.table_cell>
                <.table_cell>
                  <.badge variant="default" size="sm">
                    <%= change.new_shift_type %>
                  </.badge>
                </.table_cell>
                <.table_cell>
                  <%= change.reason %>
                </.table_cell>
              </.table_row>
            <% end %>
          </.table_body>
        </.table>
        <%= if (@no_changes && @no_changes != []) do %>
          <.empty_state description="与基准版本无差异" id="no_changes_state" />
        <% end %>
      </.card_content>
    </.card>
  </.section>
  <.section layout="none" id="summary_section">
    <.grid columns={3} gap={3} id="summary_grid">
      <.card variant="default" id="change_count_card">
        <.card_content id="change_count_content">
          <.stack gap={0} direction="column" id="change_stat">
            <.text variant="caption" color="muted" id="change_label">
              变更数量
            </.text>
            <.text variant="h3" weight="bold" id="change_value">
              <%= @change_count %>
            </.text>
          </.stack>
        </.card_content>
      </.card>
      <.card variant="default" id="affected_emp_card">
        <.card_content id="affected_emp_content">
          <.stack gap={0} direction="column" id="affected_stat">
            <.text variant="caption" color="muted" id="affected_label">
              涉及员工
            </.text>
            <.text variant="h3" weight="bold" id="affected_value">
              <%= @affected_employee_count %>
            </.text>
          </.stack>
        </.card_content>
      </.card>
      <.card variant="default" id="coverage_card">
        <.card_content id="coverage_content">
          <.stack gap={0} direction="column" id="coverage_stat">
            <.text variant="caption" color="muted" id="coverage_label">
              需求覆盖率
            </.text>
            <.text variant="h3" weight="bold" id="coverage_value">
              <%= @coverage_rate %>%
            </.text>
          </.stack>
        </.card_content>
      </.card>
    </.grid>
  </.section>
  <.section layout="none" id="publish_actions">
    <.flex justify="end" gap={2} direction="row" id="action_bar">
      <.button variant="secondary" phx-click="navigate_back" size="md" id="cancel_btn">
        返回修改
      </.button>
      <.button variant="primary" phx-click="action_publish" disabled={@has_hard_violations} size="md" id="publish_btn">
        确认发布
      </.button>
    </.flex>
  </.section>
</.page>