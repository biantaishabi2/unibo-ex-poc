{
  "backend": {
    "api_map": {
      "create": "Scheduling.ShiftType.create",
      "destroy": "Scheduling.ShiftType.destroy",
      "get": "Scheduling.ShiftType.get",
      "update": "Scheduling.ShiftType.update"
    },
    "info": {
      "reload_messages": [
        "page_host_reload"
      ]
    },
    "load": {
      "assigns": {},
      "selection": "code color coverage_requirements { id min_headcount: minHeadcount notes priority required_lead_count: requiredLeadCount required_skill_tags: requiredSkillTags requirement_date: requirementDate role_code: roleCode role_name: roleName target_headcount: targetHeadcount } duration_hours: durationHours enabled end_time: endTime id is_night: isNight name sort_order: sortOrder start_time: startTime"
    },
    "params": {
      "accept": [
        "id"
      ]
    }
  },
  "children": [
    "coverage_requirement"
  ],
  "domain": "Scheduling",
  "e2e": {
    "playwright": {
      "auto": true,
      "base_path": "/scheduling/shift_type/:id",
      "cases": [
        {
          "covers": [],
          "name": "页面加载 + 结构可见",
          "steps": [
            {
              "action": "expect_visible",
              "selector": "[data-page='shift_type_detail']"
            }
          ]
        },
        {
          "covers": [
            "toggle_edit"
          ],
          "name": "编辑模式切换",
          "steps": [
            {
              "action": "click",
              "selector": "[data-action='toggle_edit']"
            },
            {
              "action": "expect_visible",
              "selector": "form, [data-mode='edit']"
            }
          ]
        },
        {
          "covers": [
            "form_submit"
          ],
          "name": "表单提交",
          "steps": [
            {
              "action": "click",
              "selector": "[data-action='form_submit'], button[type='submit']"
            },
            {
              "action": "expect_text_contains",
              "selector": "#flash-group, [data-flash], [role='alert']",
              "value": "成功"
            }
          ]
        }
      ],
      "dto_smoke": []
    }
  },
  "entity": "ShiftType",
  "page_id": "shift_type_detail",
  "page_type": "object_page",
  "runtime_monitoring": null,
  "schema_version": "1.0",
  "state_transitions": [
    {
      "description": "切换编辑模式",
      "from": "*",
      "name": "toggle_edit",
      "to": "*",
      "trigger": "user_action"
    },
    {
      "description": "取消编辑",
      "from": "*",
      "name": "cancel_edit",
      "to": "*",
      "trigger": "user_action"
    },
    {
      "description": "表单字段变更",
      "from": "*",
      "name": "form_change",
      "to": "*",
      "trigger": "user_input"
    },
    {
      "description": "提交表单",
      "from": "editing",
      "name": "form_submit",
      "to": "loading",
      "trigger": "user_action"
    },
    {
      "description": "删除记录",
      "from": "*",
      "name": "action_destroy",
      "navigate_to": "/scheduling/shift_type",
      "to": "loading",
      "trigger": "user_action"
    }
  ],
  "status_keys": [
    "record",
    "editing",
    "form",
    "loading"
  ],
  "ui": {
    "sections": [],
    "template": {
      "detail": "object_page"
    }
  },
  "version": 1
}