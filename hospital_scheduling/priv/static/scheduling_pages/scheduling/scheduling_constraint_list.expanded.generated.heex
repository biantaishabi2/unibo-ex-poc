<.page title="SchedulingConstraint 列表" id="scheduling_constraint_list">
  <.section direction="row" justify="between" align="center" layout="grid" columns={2} id="scheduling_constraint_header">
    <.text variant="title" id="scheduling_constraint_title">
      <%= @page_title %>
    </.text>
    <.button variant="primary" phx-click="navigate_create" size="md" id="scheduling_constraint_create_btn">
      新建
    </.button>
  </.section>
  <.card variant="default" id="scheduling_constraint_filter_card">
    <.card_content id="scheduling_constraint_filter_content">
      <.flex gap={4} align="center" direction="row" id="scheduling_constraint_filter_row">
        <.select name="constraint_type" label="硬约束或软约束" size="md" id="filter_constraint_type">

        </.select>
        <.select name="category" label="规则类别" size="md" id="filter_category">

        </.select>
        <.button variant="secondary" phx-click="filter_submit" size="md" id="scheduling_constraint_filter_submit">
          查询
        </.button>
      </.flex>
    </.card_content>
  </.card>
  <.table id="scheduling_constraint_table">
    <.table_header id="scheduling_constraint_table_header">
      <.table_row id="scheduling_constraint_header_row">
        <.table_head id="th_name">
          规则名称
        </.table_head>
        <.table_head id="th_constraint_type">
          硬约束或软约束
        </.table_head>
        <.table_head id="th_category">
          规则类别
        </.table_head>
        <.table_head id="th_params">
          规则参数（shape 按 category 不同）
        </.table_head>
        <.table_head id="th_weight">
          软约束权重（硬约束忽略）
        </.table_head>
        <.table_head id="th_enabled">
          是否启用
        </.table_head>
        <.table_head id="th_notes">
          备注
        </.table_head>
        <.table_head id="scheduling_constraint_th_actions">
          操作
        </.table_head>
      </.table_row>
    </.table_header>
    <.table_body id="scheduling_constraint_table_body">
      <%= for row <- (@rows || []) do %>
        <.table_row>
          <.table_cell>
            <%= get_in(row, [:name]) || "" %>
          </.table_cell>
          <.table_cell>
            <.badge variant="default" size="sm">
              <%= get_in(row, [:constraint_type]) || "" %>
            </.badge>
          </.table_cell>
          <.table_cell>
            <.badge variant="default" size="sm">
              <%= get_in(row, [:category]) || "" %>
            </.badge>
          </.table_cell>
          <.table_cell>
            <%= get_in(row, [:params]) || "" %>
          </.table_cell>
          <.table_cell>
            <%= get_in(row, [:weight]) || "" %>
          </.table_cell>
          <.table_cell>
            <.badge variant="default" size="sm">
              <%= get_in(row, [:enabled]) || "" %>
            </.badge>
          </.table_cell>
          <.table_cell>
            <%= get_in(row, [:notes]) || "" %>
          </.table_cell>
          <.table_cell>
            <.link patch={"/pages/scheduling/scheduling_constraint/#{get_in(row, [:id])}"} id="scheduling_constraint_view_btn" variant="link" size="sm">
              查看
            </.link>
          </.table_cell>
        </.table_row>
      <% end %>
    </.table_body>
  </.table>
  <%= if (@rows_empty && @rows_empty != []) do %>
    <.empty_state description="暂无合法性约束和评分规则定义,不承载需求人数数据" id="scheduling_constraint_no_data" />
  <% end %>
</.page>