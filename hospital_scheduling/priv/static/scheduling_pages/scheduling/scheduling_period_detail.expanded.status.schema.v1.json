    "backend": {
      "api_map": {
        "destroy": "Scheduling.SchedulingPeriod.destroy",
        "get": "Scheduling.SchedulingPeriod.get",
        "mark_adjusted": "Scheduling.SchedulingPeriod.mark_adjusted",
        "mark_generated": "Scheduling.SchedulingPeriod.mark_generated",
        "publish": "Scheduling.SchedulingPeriod.publish",
        "start_generating": "Scheduling.SchedulingPeriod.start_generating",
        "update": "Scheduling.SchedulingPeriod.update"
      }
    },
    "children": [
      "coverage_requirement",
      "schedule_version",
      "solver_run",
      "shift_assignment",
      "constraint_violation"
    ],
    "domain": "Scheduling",
    "e2e": {
      "playwright": {
        "auto": true,
        "base_path": "/scheduling/scheduling_period/:id",
        "cases": [
          {
            "covers": [],
            "name": "页面加载 + 结构可见",
            "steps": [
              {
                "action": "expect_visible",
                "selector": "[data-page='scheduling_period_detail']"
              }
            ]
          },
          {
            "covers": [
              "toggle_edit"
            ],
            "name": "编辑模式切换",
            "steps": [
              {
                "action": "click",
                "selector": "[data-action='toggle_edit']"
              },
              {
                "action": "expect_visible",
                "selector": "form, [data-mode='edit']"
              }
            ]
          },
          {
            "covers": [
              "form_submit"
            ],
            "name": "表单提交",
            "steps": [
              {
                "action": "click",
                "selector": "[data-action='form_submit'], button[type='submit']"
              },
              {
                "action": "expect_text_contains",
                "selector": "#flash-group, [data-flash], [role='alert']",
                "value": "成功"
              }
            ]
          }
        ],
        "dto_smoke": []
      }
    },
    "entity": "SchedulingPeriod",
    "page_id": "scheduling_period_detail",
    "page_type": "object_page",
    "runtime_monitoring": null,
    "schema_version": "1.0",
    "state_transitions": [
      {
        "description": "切换编辑模式",
        "from": "*",
        "name": "toggle_edit",
        "to": "*",
        "trigger": "user_action"
      },
      {
        "description": "取消编辑",
        "from": "*",
        "name": "cancel_edit",
        "to": "*",
        "trigger": "user_action"
      },
      {
        "description": "表单字段变更",
        "from": "*",
        "name": "form_change",
        "to": "*",
        "trigger": "user_input"
      },
      {
        "description": "提交表单",
        "from": "editing",
        "name": "form_submit",
        "to": "loading",
        "trigger": "user_action"
      },
      {
        "description": "开始自动生成排班",
        "from": "*",
        "name": "action_start_generating",
        "to": "loading",
        "trigger": "user_action"
      },
      {
        "description": "求解完成，标记为已生成",
        "from": "*",
        "name": "action_mark_generated",
        "to": "loading",
        "trigger": "user_action"
      },
      {
        "description": "人工调班后标记",
        "from": "*",
        "name": "action_mark_adjusted",
        "to": "loading",
        "trigger": "user_action"
      },
      {
        "description": "发布排班（需无 error 级违反）",
        "from": "*",
        "name": "action_publish",
        "to": "loading",
        "trigger": "user_action"
      },
      {
        "description": "删除记录",
        "from": "*",
        "name": "action_destroy",
        "navigate_to": "/scheduling/scheduling_period",
        "to": "loading",
        "trigger": "user_action"
      }
    ],
    "status_keys": [
      "record",
      "editing",
      "form",
      "loading"
    ],
    "ui": {
      "sections": [],
      "template": {
        "detail": "object_page"
      }
    },
    "version": 1
  }
}