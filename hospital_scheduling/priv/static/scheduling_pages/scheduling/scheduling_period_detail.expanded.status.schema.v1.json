      },
      {
        "description": "取消编辑",
        "from": "*",
        "name": "cancel_edit",
        "to": "*",
        "trigger": "user_action"
      },
      {
        "description": "表单字段变更",
        "from": "*",
        "name": "form_change",
        "to": "*",
        "trigger": "user_input"
      },
      {
        "description": "提交表单",
        "from": "editing",
        "name": "form_submit",
        "to": "loading",
        "trigger": "user_action"
      },
      {
        "description": "开始自动生成排班",
        "from": "*",
        "name": "action_start_generating",
        "to": "loading",
        "trigger": "user_action"
      },
      {
        "description": "求解完成，标记为已生成",
        "from": "*",
        "name": "action_mark_generated",
        "to": "loading",
        "trigger": "user_action"
      },
      {
        "description": "人工调班后标记",
        "from": "*",
        "name": "action_mark_adjusted",
        "to": "loading",
        "trigger": "user_action"
      },
      {
        "description": "发布排班（需无 error 级违反）",
        "from": "*",
        "name": "action_publish",
        "to": "loading",
        "trigger": "user_action"
      },
      {
        "description": "删除记录",
        "from": "*",
        "name": "action_destroy",
        "to": "loading",
        "trigger": "user_action"
      }
    ],
    "version": 1
