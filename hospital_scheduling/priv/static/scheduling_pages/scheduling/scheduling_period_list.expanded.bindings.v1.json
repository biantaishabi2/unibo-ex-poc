{
  "version": 1,
  "vars": {
    "page_title": {
      "uses": [
        {
          "node_type": "Text",
          "node_id": "page_title",
          "location": "prop",
          "prop": "content",
          "template": "{{page_title|排班周期管理}}"
        }
      ]
    },
    "scheduling_period.page": {
      "uses": [
        {
          "node_type": "Text",
          "node_id": "page_info",
          "location": "prop",
          "prop": "content",
          "template": "{{scheduling_period.page|}} / {{scheduling_period.total_pages|}}"
        }
      ]
    },
    "scheduling_period.total_pages": {
      "uses": [
        {
          "node_type": "Text",
          "node_id": "page_info",
          "location": "prop",
          "prop": "content",
          "template": "{{scheduling_period.page|}} / {{scheduling_period.total_pages|}}"
        }
      ]
    }
  },
  "events": {
    "navigate_create": {
      "triggers": [
        {
          "node_type": "Button",
          "node_id": "create_btn",
          "prop": "click",
          "raw": "navigate_create"
        }
      ]
    },
    "filter_submit": {
      "triggers": [
        {
          "node_type": "Button",
          "node_id": "filter_submit",
          "prop": "click",
          "raw": "filter_submit"
        }
      ]
    },
    "navigate_detail": {
      "triggers": [
        {
          "node_type": "Button",
          "node_id": "detail_btn",
          "prop": "click",
          "raw": "navigate_detail"
        }
      ]
    },
    "action_destroy": {
      "triggers": [
        {
          "node_type": "Button",
          "node_id": "delete_btn",
          "prop": "click",
          "raw": "action_destroy"
        }
      ]
    },
    "scheduling_period_page_prev": {
      "triggers": [
        {
          "node_type": "Button",
          "node_id": "page_prev",
          "prop": "click",
          "raw": "scheduling_period_page_prev"
        }
      ]
    },
    "scheduling_period_page_next": {
      "triggers": [
        {
          "node_type": "Button",
          "node_id": "page_next",
          "prop": "click",
          "raw": "scheduling_period_page_next"
        }
      ]
    }
  }
}