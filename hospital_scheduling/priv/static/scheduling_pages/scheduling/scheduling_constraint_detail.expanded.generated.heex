<.page title="SchedulingConstraint 详情" id="scheduling_constraint_detail">
  <.breadcrumb id="scheduling_constraint_breadcrumb">
    <.breadcrumb_list id="scheduling_constraint_bc_list">
      <.breadcrumb_item id="scheduling_constraint_bc_list_item">
        <.breadcrumb_link id="scheduling_constraint_bc_link">
          SchedulingConstraint 列表
        </.breadcrumb_link>
      </.breadcrumb_item>
      <.breadcrumb_separator id="scheduling_constraint_bc_sep" />
      <.breadcrumb_item id="scheduling_constraint_bc_current_item">
        <.breadcrumb_page id="scheduling_constraint_bc_current">
          <%= get_in(@record, [:name]) || "详情" %>
        </.breadcrumb_page>
      </.breadcrumb_item>
    </.breadcrumb_list>
  </.breadcrumb>
  <.section direction="row" justify="between" align="center" layout="grid" columns={2} id="scheduling_constraint_detail_header">
    <.flex gap={3} align="center" direction="row" id="scheduling_constraint_title_group">
      <.text variant="title" id="scheduling_constraint_detail_title">
        <%= get_in(@record, [:name]) || "" %>
      </.text>
    </.flex>
    <.flex gap={2} direction="row" id="scheduling_constraint_actions">
      <.button variant="secondary" phx-click="toggle_edit" size="md" id="scheduling_constraint_edit_btn">
        编辑
      </.button>
      <.button variant="danger" phx-click="action_destroy" size="md" id="scheduling_constraint_delete_btn">
        删除
      </.button>
    </.flex>
  </.section>
  <.card variant="default" id="scheduling_constraint_info_card">
    <.card_header id="scheduling_constraint_info_header">
      <.card_title id="scheduling_constraint_info_title">
        基本信息
      </.card_title>
    </.card_header>
    <.card_content id="scheduling_constraint_info_content">
      <%= if !(@editing && @editing != []) do %>
        <.grid columns={2} gap={4} id="scheduling_constraint_info_grid">
          <.flex direction="row" id="field_name">
            <.text variant="muted" id="label_name">
              规则名称
            </.text>
            <.text id="value_name">
              <%= get_in(@record, [:name]) || "" %>
            </.text>
          </.flex>
          <.flex direction="row" id="field_constraint_type">
            <.text variant="muted" id="label_constraint_type">
              硬约束或软约束
            </.text>
            <.badge variant="default" size="sm" id="value_constraint_type">
              <%= get_in(@record, [:constraint_type]) || "" %>
            </.badge>
          </.flex>
          <.flex direction="row" id="field_category">
            <.text variant="muted" id="label_category">
              规则类别
            </.text>
            <.badge variant="default" size="sm" id="value_category">
              <%= get_in(@record, [:category]) || "" %>
            </.badge>
          </.flex>
          <.flex direction="row" id="field_params">
            <.text variant="muted" id="label_params">
              规则参数（shape 按 category 不同）
            </.text>
            <.text id="value_params">
              <%= get_in(@record, [:params]) || "" %>
            </.text>
          </.flex>
          <.flex direction="row" id="field_weight">
            <.text variant="muted" id="label_weight">
              软约束权重（硬约束忽略）
            </.text>
            <.text id="value_weight">
              <%= get_in(@record, [:weight]) || "" %>
            </.text>
          </.flex>
          <.flex direction="row" id="field_enabled">
            <.text variant="muted" id="label_enabled">
              是否启用
            </.text>
            <.badge variant="default" size="sm" id="value_enabled">
              <%= get_in(@record, [:enabled]) || "" %>
            </.badge>
          </.flex>
          <.flex direction="row" id="field_notes">
            <.text variant="muted" id="label_notes">
              备注
            </.text>
            <.text id="value_notes">
              <%= get_in(@record, [:notes]) || "" %>
            </.text>
          </.flex>
        </.grid>
      <% else %>
        <.form phx-submit="form_submit" phx-change="form_change" id="scheduling_constraint_edit_form">
          <.grid columns={2} gap={4} id="scheduling_constraint_form_grid">
            <.input name="name" label="规则名称" placeholder="请输入规则名称" required="true" size="md" id="form_name" value={@record.name} />
            <.select name="constraint_type" label="硬约束或软约束" required="true" size="md" id="form_constraint_type" value={@record.constraint_type}>

            </.select>
            <.select name="category" label="规则类别" required="true" size="md" id="form_category" value={@record.category}>

            </.select>
            <.input name="params" label="规则参数（shape 按 category 不同）" placeholder="请输入规则参数（shape 按 category 不同）" required="true" size="md" id="form_params" value={@record.params} />
            <.input name="weight" label="软约束权重（硬约束忽略）" placeholder="请输入软约束权重（硬约束忽略）" size="md" id="form_weight" value={@record.weight} />
            <.switch name="enabled" label="是否启用" size="md" id="form_enabled" value={@record.enabled} />
            <.textarea name="notes" label="备注" placeholder="请输入备注" id="form_notes" value={@record.notes} />
          </.grid>
          <.flex justify="end" gap={2} direction="row" id="scheduling_constraint_form_actions">
            <.button variant="secondary" phx-click="cancel_edit" size="md" id="scheduling_constraint_cancel_btn">
              取消
            </.button>
            <.button variant="primary" phx-click="form_submit" size="md" id="scheduling_constraint_save_btn">
              保存
            </.button>
          </.flex>
        </.form>
      <% end %>
    </.card_content>
  </.card>
</.page>