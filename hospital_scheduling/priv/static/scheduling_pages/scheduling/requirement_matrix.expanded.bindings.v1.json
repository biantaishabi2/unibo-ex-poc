{
  "version": 1,
  "vars": {
    "period.title": {
      "uses": [
        {
          "node_type": "Text",
          "node_id": "page_title",
          "location": "prop",
          "prop": "content",
          "template": "{{period.title|需求矩阵}}"
        }
      ]
    },
    "period.state": {
      "uses": [
        {
          "node_type": "Option",
          "node_id": "opt_published",
          "location": "prop",
          "prop": "content",
          "template": "{{period.state|}}"
        }
      ]
    },
    "period.start_date": {
      "uses": [
        {
          "node_type": "Text",
          "node_id": "date_range",
          "location": "prop",
          "prop": "content",
          "template": "{{period.start_date|}} ~ {{period.end_date|}}"
        }
      ]
    },
    "period.end_date": {
      "uses": [
        {
          "node_type": "Text",
          "node_id": "date_range",
          "location": "prop",
          "prop": "content",
          "template": "{{period.start_date|}} ~ {{period.end_date|}}"
        }
      ]
    }
  },
  "events": {
    "navigate_back": {
      "triggers": [
        {
          "node_type": "Button",
          "node_id": "back_btn",
          "prop": "click",
          "raw": "navigate_back"
        }
      ]
    },
    "batch_fill_requirements": {
      "triggers": [
        {
          "node_type": "Button",
          "node_id": "batch_fill_btn",
          "prop": "click",
          "raw": "batch_fill_requirements"
        }
      ]
    },
    "save_requirements": {
      "triggers": [
        {
          "node_type": "Button",
          "node_id": "save_btn",
          "prop": "click",
          "raw": "save_requirements"
        }
      ]
    },
    "action_start_generating": {
      "triggers": [
        {
          "node_type": "Button",
          "node_id": "start_btn",
          "prop": "click",
          "raw": "action_start_generating"
        }
      ]
    }
  }
}