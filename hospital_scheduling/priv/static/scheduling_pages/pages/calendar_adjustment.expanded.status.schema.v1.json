{
  "version": 1,
  "defaults": {
    "current_week_label": "",
    "period": {
      "title": ""
    },
    "manual_change_count": "",
    "coverage_rate": "",
    "no_violations": true,
    "employees": [
      {
        "name": "employee_1",
        "role_code": "",
        "daily_assignments": [
          {
            "shift_type": {
              "name": "shift_type_1"
            }
          },
          {
            "shift_type": {
              "name": "shift_type_2"
            }
          }
        ]
      },
      {
        "name": "employee_2",
        "role_code": "",
        "daily_assignments": [
          {
            "shift_type": {
              "name": "shift_type_1"
            }
          },
          {
            "shift_type": {
              "name": "shift_type_2"
            }
          }
        ]
      },
      {
        "name": "employee_3",
        "role_code": "",
        "daily_assignments": [
          {
            "shift_type": {
              "name": "shift_type_1"
            }
          },
          {
            "shift_type": {
              "name": "shift_type_2"
            }
          }
        ]
      }
    ],
    "live_violations": [
      {
        "severity": "",
        "message": ""
      },
      {
        "severity": "",
        "message": ""
      },
      {
        "severity": "",
        "message": ""
      }
    ],
    "record": {
      "role_code": "",
      "shift_type_id": ""
    }
  },
  "keys": [
    "coverage_rate",
    "current_week_label",
    "employees",
    "employees[]",
    "employees[].daily_assignments",
    "employees[].daily_assignments[]",
    "employees[].daily_assignments[].shift_type",
    "employees[].daily_assignments[].shift_type.name",
    "employees[].name",
    "employees[].role_code",
    "live_violations",
    "live_violations[]",
    "live_violations[].message",
    "live_violations[].severity",
    "manual_change_count",
    "no_violations",
    "period",
    "period.title",
    "record",
    "record.role_code",
    "record.shift_type_id"
  ],
  "required": [
    "coverage_rate",
    "current_week_label",
    "employees",
    "live_violations",
    "manual_change_count",
    "no_violations",
    "period",
    "record"
  ],
  "urlParams": {},
  "notes": [],
  "layer2": {
    "backend": {
      "api_map": {
        "__load__": "Scheduling.SchedulingPeriod.get",
        "filter_submit": "Scheduling.ShiftAssignment.list",
        "get": "Scheduling.SchedulingPeriod.get",
        "list": "Scheduling.ShiftAssignment.list",
        "save_draft": "Scheduling.ShiftAssignment.update",
        "update": "Scheduling.ShiftAssignment.update"
      },
      "info": {
        "reload_messages": [
          "page_host_reload"
        ]
      },
      "load": {
        "assigns": {
          "coverage_rate": {
            "value": 0
          },
          "current_week_label": {
            "from": "record",
            "transform": "date_range_label"
          },
          "employees": {
            "value": []
          },
          "live_violations": {
            "from": "record.current_version.constraint_violations",
            "transform": "normalize_list"
          },
          "manual_change_count": {
            "value": 0
          },
          "no_violations": {
            "from": "record.current_version.constraint_violations",
            "transform": "empty_list"
          },
          "period": "record"
        },
        "selection": "id title start_date: startDate end_date: endDate current_version: currentVersion { id constraint_violations: constraintViolations { severity rule_code: ruleCode message } }"
      },
      "params": {
        "accept": [
          "id",
          "role_code",
          "shift_type_id"
        ]
      }
    },
    "domain": "Scheduling",
    "e2e": {
      "playwright": {
        "auto": true,
        "base_path": "/scheduling/calendar_adjustment?id=:id",
        "cases": [
          {
            "covers": [],
            "name": "页面加载 + 日历表格可见",
            "steps": [
              {
                "action": "expect_visible",
                "selector": "#calendar_table"
              },
              {
                "action": "expect_visible",
                "selector": "#period_badge"
              },
              {
                "action": "expect_visible",
                "selector": "#coverage_value"
              }
            ]
          },
          {
            "covers": [
              "navigate_prev_week"
            ],
            "name": "周导航 - 上一周",
            "steps": [
              {
                "action": "click",
                "selector": "#prev_week_btn"
              },
              {
                "action": "expect_visible",
                "selector": "#current_week_label"
              }
            ]
          },
          {
            "covers": [
              "navigate_next_week"
            ],
            "name": "周导航 - 下一周",
            "steps": [
              {
                "action": "click",
                "selector": "#next_week_btn"
              },
              {
                "action": "expect_visible",
                "selector": "#current_week_label"
              }
            ]
          },
          {
            "covers": [
              "save_draft"
            ],
            "name": "保存草稿",
            "steps": [
              {
                "action": "click",
                "selector": "#save_draft_btn"
              },
              {
                "action": "expect_text_contains",
                "selector": "#flash-group, [data-flash], [role='alert']",
                "value": "保存"
              }
            ]
          },
          {
            "covers": [
              "navigate_publish_preview"
            ],
            "name": "跳转发布预览",
            "steps": [
              {
                "action": "click",
                "selector": "#publish_preview_btn"
              },
              {
                "action": "expect_url_contains",
                "value": "/scheduling/publish_preview"
              }
            ]
          }
        ],
        "dto_smoke": []
      }
    },
    "entity": "ShiftAssignment",
    "page_id": "calendar_adjustment",
    "page_type": "composition",
    "state_transitions": [
      {
        "description": "切换到上一周",
        "from": "*",
        "name": "navigate_prev_week",
        "to": "*",
        "trigger": "user_action"
      },
      {
        "description": "切换到下一周",
        "from": "*",
        "name": "navigate_next_week",
        "to": "*",
        "trigger": "user_action"
      },
      {
        "description": "按筛选条件刷新排班矩阵",
        "from": "*",
        "name": "filter_submit",
        "to": "loading",
        "trigger": "user_action"
      },
      {
        "description": "保存当前调班草稿",
        "from": "*",
        "name": "save_draft",
        "to": "loading",
        "trigger": "user_action"
      },
      {
        "description": "进入发布预览",
        "from": "*",
        "name": "navigate_publish_preview",
        "to": "*",
        "trigger": "user_action"
      },
      {
        "description": "返回周期详情",
        "from": "*",
        "name": "navigate_back",
        "to": "*",
        "trigger": "user_action"
      }
    ],
    "status_keys": [
      "period",
      "employees",
      "manual_change_count",
      "coverage_rate",
      "live_violations",
      "no_violations",
      "current_week_label"
    ],
    "version": 1
  }
}