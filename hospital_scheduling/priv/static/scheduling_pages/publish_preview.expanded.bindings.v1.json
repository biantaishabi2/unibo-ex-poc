{
  "version": 1,
  "vars": {
    "period.title": {
      "uses": [
        {
          "node_type": "Text",
          "node_id": "page_title",
          "location": "prop",
          "prop": "content",
          "template": "发布预览 — {{period.title|}}"
        }
      ]
    },
    "version.version_no": {
      "uses": [
        {
          "node_type": "Badge",
          "node_id": "version_badge",
          "location": "prop",
          "prop": "content",
          "template": "v{{version.version_no|}}"
        }
      ]
    },
    "version.origin_type": {
      "uses": [
        {
          "node_type": "Badge",
          "node_id": "origin_badge",
          "location": "prop",
          "prop": "content",
          "template": "{{version.origin_type|}}"
        }
      ]
    },
    "hard_violation_count": {
      "uses": [
        {
          "node_type": "Alert",
          "node_id": "block_alert",
          "location": "prop",
          "prop": "description",
          "template": "当前版本存在 {{hard_violation_count|}} 个硬约束违反,必须全部解决后才能发布.请返回日历调班页手动调整."
        }
      ]
    },
    "warning_count": {
      "uses": [
        {
          "node_type": "Alert",
          "node_id": "warn_alert",
          "location": "prop",
          "prop": "description",
          "template": "有 {{warning_count|}} 个软约束警告,可选择忽略并继续发布."
        }
      ]
    },
    "change_count": {
      "uses": [
        {
          "node_type": "Text",
          "node_id": "change_value",
          "location": "prop",
          "prop": "content",
          "template": "{{change_count|}}"
        }
      ]
    },
    "affected_employee_count": {
      "uses": [
        {
          "node_type": "Text",
          "node_id": "affected_value",
          "location": "prop",
          "prop": "content",
          "template": "{{affected_employee_count|}}"
        }
      ]
    },
    "coverage_rate": {
      "uses": [
        {
          "node_type": "Text",
          "node_id": "coverage_value",
          "location": "prop",
          "prop": "content",
          "template": "{{coverage_rate|}}%"
        }
      ]
    },
    "has_hard_violations": {
      "uses": [
        {
          "node_type": "Button",
          "node_id": "publish_btn",
          "location": "prop",
          "prop": "disabled",
          "template": "{{has_hard_violations|}}"
        }
      ]
    }
  },
  "events": {
    "navigate_back": {
      "triggers": [
        {
          "node_type": "Button",
          "node_id": "back_btn",
          "prop": "click",
          "raw": "navigate_back"
        },
        {
          "node_type": "Button",
          "node_id": "cancel_btn",
          "prop": "click",
          "raw": "navigate_back"
        }
      ]
    },
    "toggle_diff_mode": {
      "triggers": [
        {
          "node_type": "Button",
          "node_id": "toggle_diff_btn",
          "prop": "click",
          "raw": "toggle_diff_mode"
        }
      ]
    },
    "action_publish": {
      "triggers": [
        {
          "node_type": "Button",
          "node_id": "publish_btn",
          "prop": "click",
          "raw": "action_publish"
        }
      ]
    }
  }
}