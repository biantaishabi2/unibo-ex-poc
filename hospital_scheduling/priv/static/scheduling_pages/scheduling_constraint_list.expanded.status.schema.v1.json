{
  "version": 1,
  "defaults": {
    "page_title": "排班约束配置",
    "rows_empty": true,
    "rows": [
      {
        "name": "row_1",
        "constraint_type": "",
        "category": "",
        "weight": "",
        "enabled": "",
        "notes": ""
      },
      {
        "name": "row_2",
        "constraint_type": "",
        "category": "",
        "weight": "",
        "enabled": "",
        "notes": ""
      },
      {
        "name": "row_3",
        "constraint_type": "",
        "category": "",
        "weight": "",
        "enabled": "",
        "notes": ""
      }
    ]
  },
  "keys": [
    "page_title",
    "rows",
    "rows[]",
    "rows[].category",
    "rows[].constraint_type",
    "rows[].enabled",
    "rows[].name",
    "rows[].notes",
    "rows[].weight",
    "rows_empty"
  ],
  "required": [
    "page_title",
    "rows",
    "rows_empty"
  ],
  "urlParams": {},
  "notes": [],
  "layer2": {
    "backend": {
      "api_map": {
        "list": "Scheduling.SchedulingConstraint.list"
      }
    },
    "domain": "Scheduling",
    "e2e": {
      "playwright": {
        "auto": true,
        "base_path": "/scheduling/scheduling_constraint",
        "cases": [
          {
            "covers": [],
            "name": "页面加载 + 结构可见",
            "steps": [
              {
                "action": "expect_visible",
                "selector": "[data-page='scheduling_constraint_list']"
              }
            ]
          },
          {
            "covers": [
              "navigate_create"
            ],
            "name": "新建导航",
            "steps": [
              {
                "action": "click",
                "selector": "#scheduling_constraint_create_btn, [data-action='navigate_create']"
              },
              {
                "action": "expect_url_contains",
                "value": "/scheduling/scheduling_constraint/new"
              }
            ]
          },
          {
            "covers": [],
            "name": "表格行存在",
            "steps": [
              {
                "action": "expect_visible",
                "selector": "#scheduling_constraint_table, [data-table='scheduling_constraint']"
              }
            ]
          }
        ],
        "dto_smoke": []
      }
    },
    "entity": "SchedulingConstraint",
    "page_id": "scheduling_constraint_list",
    "page_type": "list_report",
    "runtime_monitoring": null,
    "schema_version": "1.0",
    "state_transitions": [
      {
        "description": "筛选条件变更",
        "from": "*",
        "name": "filter_change",
        "to": "*",
        "trigger": "user_input"
      },
      {
        "description": "提交筛选查询",
        "from": "*",
        "name": "filter_submit",
        "to": "loading",
        "trigger": "user_action"
      },
      {
        "description": "点击行跳转详情",
        "from": "*",
        "name": "row_click",
        "navigate_to": "/scheduling/scheduling_constraint/{id}",
        "to": "*",
        "trigger": "user_action"
      },
      {
        "description": "跳转新建页",
        "from": "*",
        "name": "navigate_create",
        "navigate_to": "/scheduling/scheduling_constraint/new",
        "to": "*",
        "trigger": "user_action"
      }
    ],
    "status_keys": [
      "rows",
      "rows_empty",
      "filter",
      "loading"
    ],
    "ui": {
      "sections": [],
      "template": {
        "list": "list_report"
      }
    },
    "version": 1
  }
}