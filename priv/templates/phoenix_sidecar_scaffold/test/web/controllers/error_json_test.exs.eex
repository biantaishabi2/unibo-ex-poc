defmodule <%= web_module %>.ErrorJSONTest do
  use <%= web_module %>.ConnCase, async: true

  test "renders 404" do
    assert <%= web_module %>.ErrorJSON.render("404.json", %{}) == %{
             errors: %{detail: "Not Found"}
           }
  end

  test "renders 500" do
    assert <%= web_module %>.ErrorJSON.render("500.json", %{}) ==
             %{errors: %{detail: "Internal Server Error"}}
  end
end
