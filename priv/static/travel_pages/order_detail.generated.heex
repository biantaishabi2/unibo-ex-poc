<.page title="订单详情" id="order_detail">
  <.section padding={3} layout="none" id="main_content">
    <.stack gap={3} direction="column" id="content_stack">
      <.card variant="default" id="status_card">
        <.card_content id="status_content">
          <.flex gap={2} direction="column" align="center" padding={3} id="status_flex">
            <%= if (@order_status_booked_or_completed && @order_status_booked_or_completed != []) do %>
              <.icon name="check-circle" size="lg" color="success" id="success_icon" />
            <% end %>
            <%= if (@order_pending && @order_pending != []) do %>
              <.icon name="clock" size="lg" color="warning" id="pending_icon" />
            <% end %>
            <%= if (@order_cancelled_or_failed && @order_cancelled_or_failed != []) do %>
              <.icon name="x-circle" size="lg" color="destructive" id="fail_icon" />
            <% end %>
            <.text variant="h2" weight="bold" id="status_text">
              <%= @order.status %>
            </.text>
            <%= if (@order_status_completed && @order_status_completed != []) do %>
              <.text variant="caption" color="muted" id="completed_hint">
                订单已完成,感谢您的使用
              </.text>
            <% end %>
          </.flex>
        </.card_content>
      </.card>
      <.card variant="default" id="order_info_card">
        <.card_header id="order_info_header">
          <.text variant="h4" weight="bold" id="order_info_title">
            订单信息
          </.text>
        </.card_header>
        <.card_content id="order_info_content">
          <.stack gap={2} direction="column" id="order_info_stack">
            <.flex justify="between" direction="row" id="order_no_row">
              <.text variant="caption" color="muted" id="order_no_label">
                订单号
              </.text>
              <.text id="order_no_value">
                <%= @order.order_no %>
              </.text>
            </.flex>
            <.separator id="info_sep_1" />
            <.flex justify="between" direction="row" id="total_amount_row">
              <.text variant="caption" color="muted" id="total_amount_label">
                总金额
              </.text>
              <.text variant="h3" id="total_amount_value">
                <%= @order.total_amount %>
              </.text>
            </.flex>
            <%= if (@has_points_deduction && @has_points_deduction != []) do %>
              <.flex justify="between" direction="row" id="points_row">
                <.text variant="caption" color="muted" id="points_label">
                  积分抵扣
                </.text>
                <.text id="points_value">
                  <%= @order.points_deduction_amount %>
                </.text>
              </.flex>
            <% end %>
            <.flex justify="between" direction="row" id="payable_row">
              <.text variant="caption" color="muted" id="payable_label">
                应付金额
              </.text>
              <.text variant="h3" color="primary" id="payable_value">
                <%= @order.payable_amount %>
              </.text>
            </.flex>
          </.stack>
        </.card_content>
      </.card>
      <%= if (@is_flight_order && @is_flight_order != []) do %>
        <.card variant="default" id="flight_info_card">
          <.card_header id="flight_info_header">
            <.text variant="h4" weight="bold" id="flight_info_title">
              航班信息
            </.text>
          </.card_header>
          <.card_content id="flight_info_content">
            <.stack gap={3} direction="column" id="flight_info_stack">
              <.flex justify="between" align="center" direction="row" id="flight_route_row">
                <.stack gap={0} align="center" direction="column" id="flight_dep">
                  <.text variant="h2" weight="bold" id="flight_dep_time">
                    <%= @order.flight_offer.departure_time %>
                  </.text>
                  <.text variant="caption" color="muted" id="flight_dep_airport">
                    <%= @order.flight_offer.departure_airport %>
                  </.text>
                  <.text variant="caption" color="muted" id="flight_dep_terminal">
                    <%= @order.flight_offer.departure_terminal %>
                  </.text>
                </.stack>
                <.stack gap={0} align="center" direction="column" id="flight_mid">
                  <.text variant="caption" color="muted" id="flight_duration">
                    <%= @order.flight_offer.duration %>
                  </.text>
                  <.icon name="arrow-right" size="sm" id="flight_arrow" />
                  <.text variant="caption" color="muted" id="flight_no_mid">
                    <%= @order.flight_offer.flight_no %>
                  </.text>
                </.stack>
                <.stack gap={0} align="center" direction="column" id="flight_arr">
                  <.text variant="h2" weight="bold" id="flight_arr_time">
                    <%= @order.flight_offer.arrival_time %>
                  </.text>
                  <.text variant="caption" color="muted" id="flight_arr_airport">
                    <%= @order.flight_offer.arrival_airport %>
                  </.text>
                  <.text variant="caption" color="muted" id="flight_arr_terminal">
                    <%= @order.flight_offer.arrival_terminal %>
                  </.text>
                </.stack>
              </.flex>
              <.separator id="flight_sep_1" />
              <.flex gap={2} wrap="true" direction="row" id="airline_info_row">
                <.text variant="caption" id="airline_name">
                  <%= @order.flight_offer.airline_name %>
                </.text>
                <.text variant="caption" color="muted" id="aircraft_type">
                  <%= @order.flight_offer.aircraft_type %>
                </.text>
                <.badge variant="secondary" size="sm" id="meal_badge">
                  <%= @order.flight_offer.meal_info %>
                </.badge>
              </.flex>
              <.separator id="flight_sep_2" />
              <.text variant="caption" id="refund_policy">
                <%= @order.flight_offer.refund_change_policy %>
              </.text>
              <.text variant="caption" id="baggage_policy">
                <%= @order.flight_offer.baggage_allowance %>
              </.text>
              <.text variant="caption" id="product_desc">
                <%= @order.flight_offer.product_description %>
              </.text>
            </.stack>
          </.card_content>
        </.card>
      <% end %>
      <%= if (@is_train_order && @is_train_order != []) do %>
        <.card variant="default" id="train_info_card">
          <.card_header id="train_info_header">
            <.text variant="h4" weight="bold" id="train_info_title">
              车次信息
            </.text>
          </.card_header>
          <.card_content id="train_info_content">
            <.stack gap={3} direction="column" id="train_info_stack">
              <.flex gap={3} direction="row" id="pickup_gate_row">
                <.flex gap={1} direction="row" id="pickup_row">
                  <.text variant="caption" color="muted" id="pickup_label">
                    取票号
                  </.text>
                  <.text variant="body" weight="bold" id="pickup_value">
                    <%= @order.seat_selection_snapshot.pickup_code %>
                  </.text>
                </.flex>
                <.flex gap={1} direction="row" id="gate_row">
                  <.text variant="caption" color="muted" id="gate_label">
                    检票口
                  </.text>
                  <.text variant="body" weight="bold" id="gate_value">
                    <%= @order.seat_selection_snapshot.gate %>
                  </.text>
                </.flex>
              </.flex>
              <.separator id="train_sep_1" />
              <.flex justify="between" align="center" direction="row" id="train_route_row">
                <.stack gap={0} align="center" direction="column" id="train_dep">
                  <.text variant="h2" weight="bold" id="train_dep_time">
                    <%= @order.train_offer.departure_time %>
                  </.text>
                  <.text variant="caption" color="muted" id="train_dep_station">
                    <%= @order.train_offer.departure_station %>
                  </.text>
                </.stack>
                <.stack gap={0} align="center" direction="column" id="train_mid">
                  <.text variant="caption" weight="bold" id="train_no_display">
                    <%= @order.train_offer.train_no %>
                  </.text>
                  <.icon name="arrow-right" size="sm" id="train_arrow" />
                  <.text variant="caption" color="muted" id="train_duration">
                    <%= @order.train_offer.duration %>
                  </.text>
                </.stack>
                <.stack gap={0} align="center" direction="column" id="train_arr">
                  <.text variant="h2" weight="bold" id="train_arr_time">
                    <%= @order.train_offer.arrival_time %>
                  </.text>
                  <.text variant="caption" color="muted" id="train_arr_station">
                    <%= @order.train_offer.arrival_station %>
                  </.text>
                </.stack>
              </.flex>
              <.separator id="train_sep_2" />
              <.text variant="caption" id="stop_stations">
                <%= @order.train_offer.stop_stations %>
              </.text>
            </.stack>
          </.card_content>
        </.card>
      <% end %>
      <%= if (@is_hotel_order && @is_hotel_order != []) do %>
        <.card variant="default" id="hotel_info_card">
          <.card_header id="hotel_info_header">
            <.text variant="h4" weight="bold" id="hotel_info_title">
              酒店信息
            </.text>
          </.card_header>
          <.card_content id="hotel_info_content">
            <.stack gap={3} direction="column" id="hotel_info_stack">
              <.text variant="h3" weight="bold" id="hotel_name">
                <%= @order.hotel_offer.hotel_name %>
              </.text>
              <.text variant="caption" color="muted" id="hotel_address">
                <%= @order.hotel_offer.address %>
              </.text>
              <.separator id="hotel_sep_1" />
              <.grid columns={2} gap={2} id="hotel_detail_grid">
                <.flex gap={1} direction="row" id="room_type_row">
                  <.text variant="caption" color="muted" id="room_type_label">
                    房型
                  </.text>
                  <.text variant="caption" id="room_type_value">
                    <%= @order.hotel_offer.room_type_name %>
                  </.text>
                </.flex>
                <.flex gap={1} direction="row" id="room_count_row">
                  <.text variant="caption" color="muted" id="room_count_label">
                    间数
                  </.text>
                  <.text variant="caption" id="room_count_value">
                    <%= @order.hotel_offer.room_count %>
                  </.text>
                </.flex>
                <.flex gap={1} direction="row" id="night_count_row">
                  <.text variant="caption" color="muted" id="night_count_label">
                    晚数
                  </.text>
                  <.text variant="caption" id="night_count_value">
                    <%= @order.hotel_offer.night_count %>
                  </.text>
                </.flex>
                <.flex gap={1} direction="row" id="bed_type_row">
                  <.text variant="caption" color="muted" id="bed_type_label">
                    床型
                  </.text>
                  <.text variant="caption" id="bed_type_value">
                    <%= @order.hotel_offer.bed_type %>
                  </.text>
                </.flex>
                <.flex gap={1} direction="row" id="room_area_row">
                  <.text variant="caption" color="muted" id="room_area_label">
                    面积
                  </.text>
                  <.text variant="caption" id="room_area_value">
                    <%= @order.hotel_offer.room_area %>
                  </.text>
                </.flex>
                <.flex gap={1} direction="row" id="breakfast_row">
                  <.text variant="caption" color="muted" id="breakfast_label">
                    早餐
                  </.text>
                  <.text variant="caption" id="breakfast_value">
                    <%= @order.hotel_offer.breakfast_info %>
                  </.text>
                </.flex>
                <.flex gap={1} direction="row" id="window_row">
                  <.text variant="caption" color="muted" id="window_label">
                    窗型
                  </.text>
                  <.text variant="caption" id="window_value">
                    <%= @order.hotel_offer.window_type %>
                  </.text>
                </.flex>
                <.flex gap={1} direction="row" id="floor_row">
                  <.text variant="caption" color="muted" id="floor_label">
                    楼层
                  </.text>
                  <.text variant="caption" id="floor_value">
                    <%= @order.hotel_offer.floor_info %>
                  </.text>
                </.flex>
              </.grid>
              <.separator id="hotel_sep_2" />
              <.flex justify="between" direction="row" id="checkin_checkout_row">
                <.stack gap={0} direction="column" id="checkin_stack">
                  <.text variant="caption" color="muted" id="checkin_label">
                    入住日期
                  </.text>
                  <.text id="checkin_value">
                    <%= @order.hotel_offer.check_in_date %>
                  </.text>
                </.stack>
                <.stack gap={0} direction="column" id="checkout_stack">
                  <.text variant="caption" color="muted" id="checkout_label">
                    退房日期
                  </.text>
                  <.text id="checkout_value">
                    <%= @order.hotel_offer.check_out_date %>
                  </.text>
                </.stack>
              </.flex>
              <.separator id="hotel_sep_3" />
              <.flex justify="between" direction="row" id="cancel_fee_row">
                <.text variant="caption" color="muted" id="cancel_fee_label">
                  取消扣费
                </.text>
                <.text variant="caption" id="cancel_fee_value">
                  <%= @order.hotel_offer.cancellation_fee %>
                </.text>
              </.flex>
            </.stack>
          </.card_content>
        </.card>
      <% end %>
      <%= if (@is_flight_order && @is_flight_order != []) do %>
        <.card variant="default" id="flight_passenger_card">
          <.card_header id="flight_passenger_header">
            <.text variant="h4" weight="bold" id="flight_passenger_title">
              出行信息
            </.text>
          </.card_header>
          <.card_content id="flight_passenger_content">
            <.stack gap={2} direction="column" id="flight_passenger_stack">
              <%= for item <- @order.ticket_passenger_infos do %>
                <.flex justify="between" align="center" direction="row">
                  <.flex gap={2} align="center" direction="row">
                    <.text>
                      <%= item.name %>
                    </.text>
                    <.badge variant="outline" size="sm">
                      <%= item.ticket_status %>
                    </.badge>
                  </.flex>
                  <.text variant="caption" color="muted">
                    <%= item.id_number %>
                  </.text>
                </.flex>
              <% end %>
            </.stack>
          </.card_content>
        </.card>
      <% end %>
      <%= if (@is_train_order && @is_train_order != []) do %>
        <.card variant="default" id="train_passenger_card">
          <.card_header id="train_passenger_header">
            <.text variant="h4" weight="bold" id="train_passenger_title">
              乘客信息
            </.text>
          </.card_header>
          <.card_content id="train_passenger_content">
            <.stack gap={2} direction="column" id="train_passenger_stack">
              <%= for item <- @order.ticket_passenger_infos do %>
                <.flex justify="between" align="center" direction="row">
                  <.flex gap={2} align="center" direction="row">
                    <.text>
                      <%= item.name %>
                    </.text>
                    <.badge variant="secondary" size="sm">
                      <%= item.seat_no %>
                    </.badge>
                    <.badge variant="outline" size="sm">
                      <%= item.seat_class %>
                    </.badge>
                  </.flex>
                  <.badge variant="outline" size="sm">
                    <%= item.ticket_status %>
                  </.badge>
                </.flex>
              <% end %>
            </.stack>
          </.card_content>
        </.card>
      <% end %>
      <%= if (@is_hotel_order && @is_hotel_order != []) do %>
        <.card variant="default" id="hotel_guest_card">
          <.card_header id="hotel_guest_header">
            <.text variant="h4" weight="bold" id="hotel_guest_title">
              入住人信息
            </.text>
          </.card_header>
          <.card_content id="hotel_guest_content">
            <.stack gap={2} direction="column" id="hotel_guest_stack">
              <%= for item <- @order.hotel_offer.guests do %>
                <.flex justify="between" align="center" direction="row">
                  <.flex gap={2} align="center" direction="row">
                    <.text variant="caption" color="muted">
                      <%= item.room_no %>
                    </.text>
                    <.text>
                      <%= item.name %>
                    </.text>
                  </.flex>
                  <.text variant="caption" color="muted">
                    <%= item.phone %>
                  </.text>
                </.flex>
              <% end %>
            </.stack>
          </.card_content>
        </.card>
      <% end %>
      <%= if (@is_hotel_order && @is_hotel_order != []) do %>
        <.card variant="default" id="receipt_card">
          <.card_header id="receipt_header">
            <.text variant="h4" weight="bold" id="receipt_title">
              报销凭证
            </.text>
          </.card_header>
          <.card_content id="receipt_content">
            <.stack gap={2} direction="column" id="receipt_stack">
              <.text variant="caption" color="muted" id="receipt_hint">
                如需报销凭证,请在退房后申请
              </.text>
              <%= if (@order_status_completed && @order_status_completed != []) do %>
                <.button variant="outline" size="md" id="receipt_btn">
                  申请报销凭证
                </.button>
              <% end %>
            </.stack>
          </.card_content>
        </.card>
      <% end %>
    </.stack>
  </.section>
  <.section layout="none" id="action_bar">
    <.flex gap={2} direction="row" id="action_row">
      <%= if (@is_flight_order && @is_flight_order != []) do %>
        <.button variant="outline" size="md" id="refund_flight_btn">
          申请退票
        </.button>
        <.button variant="outline" size="md" id="change_flight_btn">
          申请改签
        </.button>
      <% end %>
      <%= if (@is_train_order && @is_train_order != []) do %>
        <.button variant="outline" size="md" id="change_train_btn">
          改签
        </.button>
        <.button variant="outline" size="md" id="refund_train_btn">
          退票
        </.button>
      <% end %>
      <%= if (@order_pending && @order_pending != []) do %>
        <.button variant="destructive" size="md" id="cancel_order_btn">
          取消订单
        </.button>
      <% end %>
      <.button variant="secondary" size="md" id="contact_service_btn">
        联系客服
      </.button>
    </.flex>
  </.section>
</.page>