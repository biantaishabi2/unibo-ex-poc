<.page title="机票搜索" id="flight_search_results">
  <.section layout="none" id="header_section">
    <.flex class="items-center gap-2 p-3">
      <.button variant="ghost" size="sm" phx-click="go_back">← 返回</.button>
      <.text variant="h4" class="flex-1">机票搜索</.text>
    </.flex>
  </.section>
  <.section layout="none" id="date_slider_section">
    <.flex gap={2} paddingx={3} paddingy={2} overflowx="scroll" background="surface" direction="row" id="flight_date_slider">
      <%= for date_item <- @search.date_range do %>
        <.badge variant={date_item.is_selected} phx-click="select_date" size="sm">
          <%= date_item.date_label %>
          <.text variant="caption">
            <%= date_item.price_label %>
          </.text>
        </.badge>
      <% end %>
    </.flex>
  </.section>
  <.separator id="sep_after_date" />
  <.section layout="none" id="filter_section">
    <.flex gap={2} paddingx={3} paddingy={2} wrap={true} direction="row" id="flight_filter_bar">
      <.select label="出发机场" name="filter.departure_airport" size="md" id="filter_departure_airport">

      </.select>
      <.select label="到达机场" name="filter.arrival_airport" size="md" id="filter_arrival_airport">

      </.select>
      <.select label="航空公司" name="filter.airline" size="md" id="filter_airline">

      </.select>
      <.select label="差标" name="filter.policy_compliant" size="md" id="filter_policy">

      </.select>
      <.select label="舱位" name="filter.cabin_class" size="md" id="filter_cabin">

      </.select>
    </.flex>
  </.section>
  <.section layout="none" id="alert_section">
    <%= if @policy.exceeded == true do %>
      <.alert variant="warning" title="超标提示" id="flight_policy_alert">
        标记超标的航班超出差旅标准,预订需审批
      </.alert>
    <% end %>
  </.section>
  <.section layout="none" id="results_section">
    <.stack gap={3} padding={3} direction="column" id="flight_results_list">
      <%= for item <- @flights.items do %>
        <.card phx-click="navigate" params={"/travel/flight/#{item.id}"} variant="default">
          <.card_header>
            <.flex gap={2} align="center" direction="row">
              <.avatar src={(item[:airline_ref] || %{})[:logo]} fallback={(item[:airline_ref] || %{})[:code]} size="sm">

              </.avatar>
              <.text variant="caption" color="muted">
                <%= (item[:airline_ref] || %{})[:name] %>
              </.text>
              <.text variant="caption" color="muted">
                <%= item.flight_no %>
              </.text>
              <%= if item.is_policy_compliant == false do %>
                <.badge variant="destructive" size="sm">
                  超标
                </.badge>
              <% end %>
            </.flex>
          </.card_header>
          <.card_content>
            <.flex justify="between" align="center" direction="row">
              <.stack gap={0} align="center" direction="column">
                <.text variant="h2" weight="bold">
                  <%= item.departure_time %>
                </.text>
                <.text variant="caption" color="muted">
                  <%= (item[:departure_airport_ref] || %{})[:city_name] %>
                </.text>
                <.text variant="caption" color="muted">
                  <%= item.departure_airport_code %>
                </.text>
              </.stack>
              <.stack gap={0} align="center" direction="column">
                <.text variant="caption" color="muted">
                  <%= item.duration_label %>
                </.text>
                <.separator />
                <.text variant="caption" color="muted">
                  <%= item.stop_label %>
                </.text>
              </.stack>
              <.stack gap={0} align="center" direction="column">
                <.text variant="h2" weight="bold">
                  <%= item.arrival_time %>
                </.text>
                <.text variant="caption" color="muted">
                  <%= (item[:arrival_airport_ref] || %{})[:city_name] %>
                </.text>
                <.text variant="caption" color="muted">
                  <%= item.arrival_airport_code %>
                </.text>
              </.stack>
            </.flex>
          </.card_content>
          <.card_footer>
            <.flex justify="between" align="center" direction="row">
              <.flex gap={1} wrap={true} direction="row">
                <.badge variant="outline" size="sm">
                  <%= (item[:cabin_class_ref] || %{})[:name] %>
                </.badge>
                <.badge variant="outline" size="sm">
                  <%= item.aircraft_type %>
                </.badge>
                <%= if item.discount_label != nil do %>
                  <.badge variant="success" size="sm">
                    <%= item.discount_label %>
                  </.badge>
                <% end %>
              </.flex>
              <.flex gap={1} align="baseline" direction="row">
                <.text variant="caption">
                  <%= item.currency %>
                </.text>
                <.text variant="h3" color="primary">
                  <%= item.listed_price %>
                </.text>
              </.flex>
            </.flex>
          </.card_footer>
        </.card>
      <% end %>
    </.stack>
  </.section>
  <.section layout="none" id="empty_section">
    <%= if @flights.total_count == 0 do %>
      <.empty_state title="未找到航班" description="请调整搜索条件后重试" id="no_flights" />
    <% end %>
  </.section>
  <.section layout="none" id="sort_bar_section">
    <.control_bar position="sticky_bottom" id="flight_sort_bar">
      <.flex gap={3} justify="spacearound" width="full" direction="row" id="flight_sort_buttons">
        <.button variant="ghost" icon="arrow-up-down" phx-click="sort" size="md" id="sort_by_price">
          价格
        </.button>
        <.button variant="ghost" icon="arrow-up-down" phx-click="sort" size="md" id="sort_by_departure">
          出发时间
        </.button>
        <.button variant="ghost" icon="star" phx-click="sort" size="md" id="sort_by_recommended">
          推荐
        </.button>
      </.flex>
    </.control_bar>
  </.section>
</.page>