<.page title="酒店搜索" id="hotel_search_results">
  <.section layout="none" id="header_section">
    <.header back={true} title="酒店搜索" id="hotel_header" />
  </.section>
  <.section layout="none" id="search_summary_section">
    <.flex gap={2} padding={3} align="center" background="surface" direction="row" id="search_summary">
      <.badge variant="outline" size="sm" id="checkin_date_badge">
        <%= @search.checkin_date %>
      </.badge>
      <.text id="date_separator">
        -
      </.text>
      <.badge variant="outline" size="sm" id="checkout_date_badge">
        <%= @search.checkout_date %>
      </.badge>
      <.input placeholder="酒店名/商圈/地标" bind="search.keyword" size="sm" id="keyword_input" />
    </.flex>
  </.section>
  <.section layout="none" id="filter_section">
    <.flex gap={2} paddingx={3} paddingy={2} wrap={true} direction="row" id="hotel_filter_bar">
      <.select label="排序" name="filter.sort_by" size="md" id="filter_sort_by">

      </.select>
      <.select label="区域" name="filter.area" size="md" id="filter_area">

      </.select>
      <.select label="价格星级" name="filter.price_star" size="md" id="filter_price_star">

      </.select>
      <.select label="差标" name="filter.policy_compliant" size="md" id="filter_hotel_policy">

      </.select>
      <.select label="协议酒店" name="filter.agreement_hotel" size="md" id="filter_agreement">

      </.select>
    </.flex>
  </.section>
  <.section layout="none" id="alert_section">
    <%= if @policy.exceeded == true do %>
      <.alert variant="warning" title="超标提示" id="hotel_policy_alert">
        以下标记超标的酒店超出差旅标准,预订需审批
      </.alert>
    <% end %>
  </.section>
  <.section layout="none" id="results_section">
    <.stack gap={3} padding={3} direction="column" id="hotel_results_list">
      <%= for item <- @hotels.items do %>
        <.card phx-click="navigate" params={"/travel/hotel/#{item.hotel_code}"} variant="default">
          <.card_header>
            <.image src={item.hotel_ref.cover_image} alt={item.hotel_name} aspect_ratio="16:9" borderradius="top" />
          </.card_header>
          <.card_content>
            <.stack gap={2} direction="column">
              <.flex gap={2} align="center" direction="row">
                <.text variant="h4" weight="bold">
                  <%= item.hotel_name %>
                </.text>
                <.badge variant="secondary" size="sm">
                  <%= item.hotel_ref.hotel_star %>
                </.badge>
              </.flex>
              <.flex gap={2} align="center" direction="row">
                <.badge variant="primary" size="sm">
                  <%= item.hotel_ref.score %>
                </.badge>
                <.text variant="caption" color="muted">
                  <%= item.hotel_ref.address %>
                </.text>
              </.flex>
              <.flex gap={1} wrap={true} direction="row">
                <%= for facility <- item.hotel_ref.facilities do %>
                  <.badge variant="outline" size="sm">
                    <%= facility.name %>
                  </.badge>
                <% end %>
              </.flex>
            </.stack>
          </.card_content>
          <.card_footer>
            <.flex justify="between" align="center" direction="row">
              <%= if item.is_agreement == true do %>
                <.badge variant="success" size="sm">
                  协议酒店
                </.badge>
              <% end %>
              <.flex gap={1} align="baseline" direction="row">
                <.text variant="caption">
                  <%= item.currency %>
                </.text>
                <.text variant="h3" color="primary">
                  <%= item.listed_price %>
                </.text>
                <.text variant="caption">
                  起
                </.text>
              </.flex>
            </.flex>
          </.card_footer>
        </.card>
      <% end %>
    </.stack>
  </.section>
  <.section layout="none" id="empty_section">
    <%= if @hotels.total_count == 0 do %>
      <.empty_state title="未找到酒店" description="请调整搜索条件后重试" id="no_hotels" />
    <% end %>
  </.section>
</.page>